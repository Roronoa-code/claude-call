<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault">
<FrameLayout android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layout_gravity="center" android:padding="6dp" android:background="@drawable/widget_bg" android:clipToOutline="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <FrameLayout android:id="@+id/hero" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/widget_lit_both"
        android:clipToOutline="true" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingEnd="14dp"
        android:paddingBottom="12dp">
        <ImageView android:id="@+id/hero_icon" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_gravity="top|start" android:src="@drawable/glyph_both" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="vertical">
            <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="23dp" android:includeFontPadding="false"
                android:text="Calls and texts" android:textSize="19sp" android:fontFamily="sans-serif"
                android:textFontWeight="650" android:textColor="#FFFFFFFF" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="0.5sp" android:gravity="center_vertical|start" />
            <TextView android:id="@+id/hero_line" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Claude can call or message you" android:textSize="13sp"
                android:lineSpacingMultiplier="1.12" android:textColor="#D1FFFFFF" android:maxLines="2" android:ellipsize="end"
                android:breakStrategy="balanced" />
            <TextView android:id="@+id/hero_since" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Changed 9:12" android:textSize="12sp"
                android:textColor="#99FFFFFF" android:maxLines="1" android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </FrameLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginBottom="6dp">
        <FrameLayout android:id="@+id/tile_call" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="4dp" android:background="@drawable/widget_tile"
            android:foreground="?android:attr/selectableItemBackground" android:clipToOutline="true"
            android:contentDescription="Calls">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/icon_call" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/glyph_call" android:importantForAccessibility="no" />
                <TextView android:id="@+id/label_call" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Calls" android:textSize="14sp" android:fontFamily="sans-serif"
                    android:textFontWeight="650" android:textColor="#8CFFFFFF" android:maxLines="1" android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/tile_text" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="4dp" android:background="@drawable/widget_tile"
            android:foreground="?android:attr/selectableItemBackground" android:clipToOutline="true"
            android:contentDescription="Texts">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/icon_text" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/glyph_text" android:importantForAccessibility="no" />
                <TextView android:id="@+id/label_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Texts" android:textSize="14sp" android:fontFamily="sans-serif"
                    android:textFontWeight="650" android:textColor="#8CFFFFFF" android:maxLines="1" android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/tile_both" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:padding="4dp" android:background="@drawable/widget_outline_both"
            android:foreground="?android:attr/selectableItemBackground" android:clipToOutline="true"
            android:contentDescription="Both, selected">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/icon_both" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/glyph_both" android:importantForAccessibility="no" />
                <TextView android:id="@+id/label_both" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Both" android:textSize="14sp" android:fontFamily="sans-serif"
                    android:textFontWeight="650" android:textColor="#FFFFFFFF" android:maxLines="1" android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/tile_none" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="4dp" android:background="@drawable/widget_tile"
            android:foreground="?android:attr/selectableItemBackground" android:clipToOutline="true"
            android:contentDescription="Quiet">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/icon_none" android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/glyph_none" android:importantForAccessibility="no" />
                <TextView android:id="@+id/label_none" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Quiet" android:textSize="14sp" android:fontFamily="sans-serif"
                    android:textFontWeight="650" android:textColor="#8CFFFFFF" android:maxLines="1" android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
</FrameLayout>
