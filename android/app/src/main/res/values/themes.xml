<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android shows this from the tap until the app's first frame; with no icon it puts a blank white disc here. -->
    <style name="Start" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/stage</item>
        <item name="android:windowSplashScreenBackground">@color/stage</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <color name="stage">#010101</color>
</resources>
