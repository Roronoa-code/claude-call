// The vinyl Clawd and Null on the home screen, alive in 3D: alive.rs moves them and live_gl.rs draws each into a
// texture shown here. Each live image is larger than its place, so a hop, raised arms and Null's antenna fit; its
// floor line sits on the place's feet line. If the GPU can't draw them, each stands as a still, breathing sprite.

export global Toys {
    callback tapped(string); // "claude" or "codex"
    in property <image> clawd-live;
    in property <image> null-live;
    in property <bool> live: true; // false: the GPU couldn't build them, so the sprites show
    // The finger, from Clawd's eyes; down false when it lifts. Both watch it.
    callback point(length, length, bool);
    in property <float> k: 1;
    in property <length> clawd-below;
    in property <length> null-below;
    // A vertical drag on Null rolls his face through the modes: how far from where it began, and its phase (0 moving,
    // 1 the finger lifts, 2 cancelled).
    callback roll(length, int);
    // How far right Null's middle stands from Clawd's (home.slint: Clawd's 230 px, a 4 px gap, half Null's 96 px).
    out property <length> null-dx: (230px / 2 + 4px + 96px / 2) * k;
}

// The fallback: a still sprite that breathes on its soft contact shadow, pivoting on its feet.
component Sprite inherits Rectangle {
    in property <image> source;
    in property <float> feet; // the feet, as a fraction of the height
    in property <duration> breath: 3200ms;
    in property <float> breath-amount: 0.016;
    property <float> wave: Math.sin(animation-tick() / root.breath * 360deg);
    Rectangle {
        width: root.width * 0.62;
        height: 18px;
        x: (root.width - self.width) / 2;
        y: root.height * root.feet - 9px;
        border-radius: 9px;
        background: @radial-gradient(circle, #000000b0 0%, #00000000 70%);
    }
    Image {
        source: root.source;
        width: root.width;
        height: root.height;
        image-fit: contain;
        transform-origin: { x: self.width / 2, y: self.height * root.feet };
        transform-scale-x: 1 - root.breath-amount * 0.5 * root.wave;
        transform-scale-y: 1 + root.breath-amount * root.wave;
    }
}

// Clawd: a tap hops him, and he watches a finger dragged over him.
export component Clawd inherits Rectangle {
    callback tapped;
    if !Toys.live: Sprite {
        width: root.width;
        height: root.height;
        source: @image-url("toys/clawd-idle.png");
        feet: 0.967;
    }
    if Toys.live: Image {
        source: Toys.clawd-live;
        width: 300px * Toys.k; // alive.rs CLAWD_SIZE, and the stage's floor under it
        height: (250px + Toys.clawd-below) * Toys.k;
        x: (root.width - self.width) / 2;
        y: root.height * 0.967 - 250px * Toys.k * 0.885; // his feet at 0.885 of the picture
        image-fit: fill;
    }
    TouchArea {
        pointer-event(e) => {
            Toys.point(self.mouse-x - self.width / 2, self.mouse-y - self.height * 0.4, e.kind == PointerEventKind.down || e.kind == PointerEventKind.move);
        }
        moved => { Toys.point(self.mouse-x - self.width / 2, self.mouse-y - self.height * 0.4, true); }
        clicked => { root.tapped(); }
    }
}

// Null: the same, standing on the same floor line to Clawd's right. A tap picks him; a vertical drag on him rolls his
// face through the modes (a press that moves more than a fingertip is never a tap).
export component Null inherits Rectangle {
    callback tapped;
    property <bool> moved-off; // this press went further than a tap
    property <bool> rolling; // ...upwards or downwards: it is rolling his face
    property <length> from-y; // where the roll began (past the fingertip's slack, so the face doesn't jump)
    if !Toys.live: Sprite {
        width: root.width;
        height: root.height;
        source: @image-url("toys/null-idle.png");
        feet: 0.975;
        breath: 3600ms;
        breath-amount: 0.012;
    }
    if Toys.live: Image {
        source: Toys.null-live;
        width: 150px * Toys.k; // alive.rs NULL_SIZE, and the stage's floor under it
        height: (230px + Toys.null-below) * Toys.k;
        x: (root.width - self.width) / 2;
        y: root.height * 0.975 - 230px * Toys.k * 0.846; // his feet at 0.846 of the picture
        image-fit: fill;
    }
    TouchArea {
        function point(down: bool) {
            Toys.point(self.mouse-x - self.width / 2 + Toys.null-dx, self.mouse-y - self.height * 0.4, down);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved-off = false;
                root.rolling = false;
            }
            self.point(e.kind == PointerEventKind.down || e.kind == PointerEventKind.move);
            if (root.rolling && e.kind == PointerEventKind.up) {
                Toys.roll(self.mouse-y - root.from-y, 1);
            }
            if (root.rolling && e.kind == PointerEventKind.cancel) {
                root.rolling = false;
                Toys.roll(0, 2);
            }
        }
        moved => {
            self.point(true);
            let dx = self.mouse-x - self.pressed-x;
            let dy = self.mouse-y - self.pressed-y;
            if (!root.moved-off && (abs(dx) > 10px || abs(dy) > 10px)) {
                root.moved-off = true;
                root.rolling = abs(dy) > abs(dx);
                root.from-y = self.mouse-y;
            }
            if (root.rolling) {
                Toys.roll(self.mouse-y - root.from-y, 0);
            }
        }
        clicked => {
            if (!root.moved-off) {
                root.tapped();
            }
        }
    }
}
