export global Toys {
    callback tapped(string);
    in property <image> clawd-live;
    in property <image> null-live;
    in property <bool> live: true;
    callback point(length, length, bool);
    in property <float> k: 1;
    in property <length> clawd-below;
    in property <length> null-below;
    callback roll(length, int);
    callback step(int);
    out property <length> null-dx: (230px / 2 + 4px + 96px / 2) * k;
}

component Sprite inherits Rectangle {
    in property <image> source;
    in property <float> feet;
    in property <duration> breath: 3200ms;
    in property <float> breath-amount: 0.016;
    property <float> wave: Math.sin(animation-tick() / root.breath * 360deg);
    Rectangle {
        width: root.width * 0.62;
        height: 18px;
        x: (root.width - self.width) / 2;
        y: root.height * root.feet - 9px;
        border-radius: 9px;
        background: @radial-gradient(circle, #000000b0 0%, #00000000 70%);
    }
    Image {
        source: root.source;
        width: root.width;
        height: root.height;
        image-fit: contain;
        transform-origin: { x: self.width / 2, y: self.height * root.feet };
        transform-scale-x: 1 - root.breath-amount * 0.5 * root.wave;
        transform-scale-y: 1 + root.breath-amount * root.wave;
    }
}

export component Clawd inherits Rectangle {
    callback tapped;
    if !Toys.live: Sprite {
        width: root.width;
        height: root.height;
        source: @image-url("toys/clawd-idle.png");
        feet: 0.967;
    }
    if Toys.live: Image {
        source: Toys.clawd-live;
        width: 300px * Toys.k;
        height: (250px + Toys.clawd-below) * Toys.k;
        x: (root.width - self.width) / 2;
        y: root.height * 0.967 - 250px * Toys.k * 0.885;
        image-fit: fill;
    }
    TouchArea {
        pointer-event(e) => {
            Toys.point(self.mouse-x - self.width / 2, self.mouse-y - self.height * 0.4, e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed));
        }
        moved => { Toys.point(self.mouse-x - self.width / 2, self.mouse-y - self.height * 0.4, true); }
        clicked => { root.tapped(); }
    }
}

export component Null inherits Rectangle {
    callback tapped;
    property <bool> moved-off;
    property <bool> rolling;
    property <length> from-y;
    if !Toys.live: Sprite {
        width: root.width;
        height: root.height;
        source: @image-url("toys/null-idle.png");
        feet: 0.975;
        breath: 3600ms;
        breath-amount: 0.012;
    }
    if Toys.live: Image {
        source: Toys.null-live;
        width: 150px * Toys.k;
        height: (230px + Toys.null-below) * Toys.k;
        x: (root.width - self.width) / 2;
        y: root.height * 0.975 - 230px * Toys.k * 0.846;
        image-fit: fill;
    }
    TouchArea {
        function point(down: bool) {
            Toys.point(self.mouse-x - self.width / 2 + Toys.null-dx, self.mouse-y - self.height * 0.4, down);
        }
        scroll-event(e) => {
            if (e.delta-y == 0) { return reject; }
            Toys.step(e.delta-y < 0 ? 1 : -1);
            accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved-off = false;
                root.rolling = false;
            }
            self.point(e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed));
            if (root.rolling && e.kind == PointerEventKind.up) {
                Toys.roll(self.mouse-y - root.from-y, 1);
            }
            if (root.rolling && e.kind == PointerEventKind.cancel) {
                root.rolling = false;
                Toys.roll(0, 2);
            }
        }
        moved => {
            self.point(true);
            let dx = self.mouse-x - self.pressed-x;
            let dy = self.mouse-y - self.pressed-y;
            if (!root.moved-off && (abs(dx) > 10px || abs(dy) > 10px)) {
                root.moved-off = true;
                root.rolling = abs(dy) > abs(dx);
                root.from-y = self.mouse-y;
            }
            if (root.rolling) {
                Toys.roll(self.mouse-y - root.from-y, 0);
            }
        }
        clicked => {
            if (!root.moved-off) {
                root.tapped();
            }
        }
    }
}
