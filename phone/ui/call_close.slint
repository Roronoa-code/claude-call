// PREVIEW (branch preview/call-screen) direction 2, Close-up: the camera moves in. The caller fills the screen like
// someone on a video call, on its record (drawn close, stage/record-close.png), and the light on it tells the call's
// state (caller.rs Mood: warm while it talks, brighter with its voice; cool while it's your turn; dimmer while it
// works; lilac on hold). The words are subtitles over the bottom of the picture; the controls are a rail of glass
// buttons at the right edge and two wide pills: Hang up (Decline) and Done talking (Answer).
import { T, Icon, Icons, SwapText } from "parts.slint";
import { Call } from "call_data.slint";
import { CapView, Sheets, RecordBack, Caller, MiniRecord } from "call_kit.slint";

// A glass button on the rail: on = filled white.
component Glass inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    width: 64px;
    height: 66px;
    Rectangle {
        x: 9px;
        y: 0;
        width: 46px;
        height: 46px;
        border-radius: 23px;
        background: root.on ? #f2f2f3 : #0d0e10b8;
        border-width: 1px;
        border-color: root.on ? #ffffff : #ffffff24;
        opacity: root.enabled ? 1 : 0.4;
        transform-origin: { x: 23px, y: 23px };
        transform-scale: touch.pressed && root.enabled ? 0.92 : 1;
        animate background, border-color { duration: 220ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        Icon { d: root.icon; x: 13px; y: 13px; width: 20px; height: 20px; stroke: root.on ? #111214 : T.fg; animate stroke { duration: 220ms; } }
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
    Rectangle {
        x: (root.width - self.width) / 2;
        y: 49px;
        width: lab.preferred-width + 10px;
        height: 15px;
        border-radius: 7.5px;
        background: #000000a0;
        lab := Text { text: root.label; font-size: 10px; font-weight: 600; color: T.fg2; horizontal-alignment: center; vertical-alignment: center; }
    }
}

export component CloseLook inherits Rectangle {
    background: #0a090c;
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> thread: phase == "hearing" || phase == "thinking";
    property <bool> working: phase == "thinking" || phase == "hold";
    property <float> t: Call.t;
    property <length> fx: root.width / 2 - 22px;
    property <length> fy: Call.sat + 486px;
    property <length> pills-y: root.height - Call.sab - 16px - 60px;
    property <length> rail-y: Call.sat + 66px;
    property <color> warm: #ffb27a;
    property <color> cool: #a9c4ff;
    property <color> lilac: #c9b6ff;
    // the state's colour, for the dot in the top chip
    property <color> tone: root.incoming ? #3ccf6a : root.phase == "talking" ? root.warm
        : root.phase == "listening" || root.phase == "hearing" ? root.cool : root.phase == "hold" ? root.lilac : root.ended ? #7d8088 : root.warm;

    RecordBack { fx: root.fx; fy: root.fy; k: 1.5; drawn-k: 1.5; source: @image-url("stage/record-close.png"); }
    Caller { fx: root.fx; fy: root.fy; }
    // The bottom of the picture darkens under the subtitles.
    Rectangle {
        y: root.fy - 70px;
        width: root.width;
        height: root.height - self.y;
        background: @linear-gradient(180deg, #0a090c00 0%, #0a090cc8 26%, #0a090cf2 52%, #0a090c 100%);
    }

    // ---- The chip at the top: who, how long, and the state's colour (a little record spins while it works) ----
    chip := Rectangle {
        x: 16px;
        y: Call.sat + 10px;
        width: row.preferred-width + 24px;
        height: 34px;
        border-radius: 17px;
        background: #0d0e10c0;
        border-width: 1px;
        border-color: #ffffff1a;
        animate width { duration: 320ms; easing: T.out; }
        row := HorizontalLayout {
            x: 12px;
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 16px;
                height: 34px;
                Rectangle {
                    property <float> pulse: root.phase == "talking" ? Math.min(1, Call.level * 1.6) : root.incoming ? 0.5 + 0.5 * Math.sin(root.t * 4.2rad) : 0;
                    x: 4px - 3px * self.pulse;
                    y: 13px - 3px * self.pulse;
                    width: 8px + 6px * self.pulse;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.tone.with-alpha(0.25);
                    opacity: root.working ? 0 : 1;
                }
                Rectangle {
                    x: 4px;
                    y: 13px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone;
                    opacity: root.working ? 0 : 1;
                    animate background { duration: 300ms; }
                    animate opacity { duration: 200ms; }
                }
                MiniRecord {
                    y: 9px;
                    t: root.t;
                    speed: root.phase == "hold" ? 0.35 : 1.1;
                    label: root.phase == "hold" ? root.lilac : #d97757;
                    opacity: root.working ? 1 : 0;
                    animate opacity { duration: 200ms; }
                }
            }
            Text { text: Call.agent; font-size: 13px; font-weight: 700; color: T.fg; vertical-alignment: center; }
            measure := Text { text: Call.time-text; font-size: 13px; visible: false; width: 0; }
            SwapText { width: measure.preferred-width + 2px; height: 34px; text: Call.time-text; key: Call.time-key; font-size: 13px; color: T.fg2; }
        }
    }

    // ---- The rail ----
    for i in 6: Glass {
        x: root.width - 8px - self.width;
        y: root.rail-y + i * 68px + (root.incoming ? 24px : 0);
        icon: i == 0 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.speaker : i == 2 ? Icons.speaker-off : i == 3 ? Icons.captions : i == 4 ? Icons.keyboard : Icons.later;
        label: i == 0 ? (Call.muted ? "Unmute" : "Mute") : i == 1 ? "Speaker" : i == 2 ? "Quiet" : i == 3 ? "Captions" : i == 4 ? "Type" : "In 5 min";
        on: i == 0 ? Call.muted : i == 1 ? Call.speaker : i == 2 ? Call.quiet : i == 3 ? Call.caps-open : i == 4 ? Call.typing : false;
        enabled: !root.incoming && !root.ended && !Call.typing;
        opacity: root.incoming || root.ended || Call.typing ? 0 : 1;
        animate y { duration: root.incoming ? 300ms : 560ms; delay: root.incoming ? 0ms : i * 35ms; easing: root.incoming ? T.close : T.spring; }
        animate opacity { duration: 220ms; delay: root.incoming ? 0ms : i * 35ms; easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-mute(); }
            else if (i == 1) { Call.toggle-speaker(); }
            else if (i == 2) { Call.toggle-quiet(); }
            else if (i == 3) { Call.caps-open = !Call.caps-open; }
            else if (i == 4) { Call.typing = !Call.typing; }
            else { if (!Call.asking-back) { Call.call-back(); } }
        }
    }

    // ---- Subtitles ----
    CapView {
        x: 22px;
        y: root.fy + 36px;
        width: root.width - 44px;
        height: root.pills-y - 34px - self.y;
        align: end;
        hide: root.thread;
        s0: 25px;
        s1: 21px;
        s2: 18px;
        small: Call.typing;
        label-size: 13px;
        gap: 8px;
    }
    VerticalLayout {
        x: 22px;
        y: root.fy + 36px;
        width: root.width - 44px;
        height: root.pills-y - 34px - self.y;
        alignment: end;
        spacing: 8px;
        opacity: root.thread ? 1 : 0;
        animate opacity { duration: root.thread ? 320ms : 140ms; delay: root.thread ? 160ms : 0ms; easing: T.out; }
        Text { height: 19px; text: "You"; font-size: 13px; font-weight: 650; letter-spacing: 0.26px; color: root.cool; vertical-alignment: center; }
        if Call.me-text != "": Text { text: Call.me-text; wrap: word-wrap; font-size: Call.typing ? 18px : 22px; font-weight: 500; color: T.fg; }
        if Call.me-text == "": HorizontalLayout {
            height: 24px;
            spacing: 7px;
            alignment: start;
            for i in 3: Rectangle {
                width: 9px;
                Rectangle {
                    y: 8px - Call.me-level * 8px * (0.6 + 0.4 * Math.sin((root.t * 8.3 + i * 1.7) * 1rad));
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: root.cool;
                    opacity: Call.me-live ? 1 : 0.35 + 0.65 * (0.5 + 0.5 * Math.cos((root.t * 5.7 - i * 0.86) * 1rad));
                }
            }
        }
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            alignment: start;
            opacity: Call.show-pending ? 1 : 0;
            animate opacity { duration: 260ms; easing: T.out; }
            MiniRecord { y: 2px; t: root.t; speed: 1.1; }
            Text { text: Call.agent + " is thinking"; font-size: 14px; font-weight: 600; color: root.warm; vertical-alignment: center; }
        }
        // the mic's line, under your words
        Rectangle { height: 4px; }
    }
    // the mic's line, under the subtitles (empty while it rings: the pills say it)
    SwapText {
        x: 22px;
        y: root.pills-y - 24px;
        width: root.width - 44px;
        height: 18px;
        text: root.thread ? "" : Call.status;
        font-size: 12.5px;
        color: T.muted;
        visible: !Call.typing;
    }

    // ---- Hang up (Decline) and Done talking (Answer) ----
    Rectangle {
        x: 16px;
        y: root.pills-y;
        width: 124px;
        height: 60px;
        border-radius: 30px;
        background: endTouch.pressed ? #c23a3f : #e5484d;
        opacity: root.ended ? 0 : 1;
        transform-origin: { x: 62px, y: 30px };
        transform-scale: endTouch.pressed ? 0.95 : 1;
        animate background { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        animate opacity { duration: 240ms; easing: T.out; }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Icon {
                d: Icons.phone;
                y: 19px;
                width: 22px;
                height: 22px;
                stroke: white;
                transform-origin: { x: 11px, y: 11px };
                transform-rotation: 135deg;
            }
            endMeasure := Text { text: root.incoming ? "Decline" : "Hang up"; font-size: 15px; font-weight: 600; visible: false; width: 0; }
            SwapText { width: endMeasure.preferred-width + 2px; height: 60px; text: root.incoming ? "Decline" : "Hang up"; font-size: 15px; weight: 600; color: white; }
        }
        endTouch := TouchArea { enabled: !root.ended; clicked => { Call.hang-up(); } }
    }
    pill := Rectangle {
        property <bool> live: root.incoming || Call.can-finish;
        x: 152px;
        y: root.pills-y;
        width: root.width - 16px - self.x;
        height: 60px;
        opacity: root.ended ? 0 : 1;
        animate opacity { duration: 240ms; easing: T.out; }
        if root.incoming: Rectangle {
            property <float> p: Math.mod(root.t, 1.5) / 1.5;
            x: -8px * self.p;
            y: -8px * self.p;
            width: parent.width + 16px * self.p;
            height: parent.height + 16px * self.p;
            border-radius: self.height / 2;
            border-width: 2px;
            border-color: #3ccf6a.with-alpha(0.6 * (1 - self.p));
        }
        Rectangle {
            border-radius: 30px;
            background: root.incoming ? (pillTouch.pressed ? #27924a : #2fa84f) : pill.live ? (pillTouch.pressed ? #c4664a : T.accent) : #1d1e22e8;
            border-width: pill.live ? 0px : 1px;
            border-color: #ffffff18;
            transform-origin: { x: self.width / 2, y: 30px };
            transform-scale: pillTouch.pressed && pill.live ? 0.96 : 1;
            animate background { duration: 260ms; easing: T.out; }
            animate transform-scale { duration: 160ms; easing: T.out; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    width: 20px;
                    for g in [{ d: Icons.phone, show: root.incoming }, { d: Icons.check, show: !root.incoming }]: Icon {
                        d: g.d;
                        y: 20px;
                        width: 20px;
                        height: 20px;
                        stroke: pill.live ? white : #7d8088;
                        opacity: g.show ? 1 : 0;
                        transform-origin: { x: 10px, y: 10px };
                        transform-scale: g.show ? 1 : 0.6;
                        transform-rotation: g.show ? 0deg : -40deg;
                        animate opacity { duration: 180ms; }
                        animate transform-scale, transform-rotation { duration: 500ms; easing: T.spring; }
                    }
                }
                measure2 := Text { text: root.incoming ? "Answer" : "Done talking"; font-size: 15px; font-weight: 600; visible: false; width: 0; }
                SwapText { width: measure2.preferred-width + 2px; height: 60px; text: root.incoming ? "Answer" : "Done talking"; font-size: 15px; weight: 600; color: pill.live ? white : #8c8f97; }
            }
            pillTouch := TouchArea {
                enabled: pill.live;
                clicked => { if (root.incoming) { Call.answer(); } else { Call.done-talking(); } }
            }
        }
    }

    Sheets {
        width: root.width;
        height: root.height;
        caps-x: root.width - 8px - 64px + 9px;
        caps-y: root.rail-y + 3 * 68px;
        type-x: root.width - 8px - 64px + 9px;
        type-y: root.rail-y + 4 * 68px;
        fsize: 46px;
        keep: 96px;
        lift: 96px;
    }
}
