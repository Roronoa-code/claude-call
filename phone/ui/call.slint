// The Claude Call screen (design D: "Your mix"), drawn natively. Rust drives the call state; this file only lays it
// out and animates it. Nothing here runs a per-frame loop: when nothing changes, nothing is redrawn.

import { T, Icon, Icons, SwapText, Spoken, Glow, Orb, Round, Morph, Cap, Msg } from "parts.slint";
import { Actor } from "actor.slint";
import { Call } from "call_data.slint";
import { StageLook } from "call_stage.slint";
import { CloseLook } from "call_close.slint";
import { ComicLook } from "call_comic.slint";
import { LyricsLook } from "call_lyrics.slint";
import { SubsLook } from "call_subs.slint";
import { ScriptLook } from "call_script.slint";
import { LightLook } from "call_light.slint";
import { CameraLook } from "call_camera.slint";
export { Cap, Msg, Call }

export component CallScreen inherits Window {
    // ---- From Rust (call_data.slint) ----
    property <length> sat: Call.sat;
    property <length> sab: Call.sab;
    // The keyboard over the window, frame by frame as it slides (from Slint's own virtual-keyboard properties).
    // Put away (Back, or swiped down) while typing: the reply field closes with it.
    property <length> kb: self.virtual-keyboard-size.height > 0 ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;
    property <bool> had-kb;
    changed kb => {
        Call.kb = self.kb;
        if (self.kb > 0) {
            self.had-kb = true;
        } else if (self.had-kb) {
            self.had-kb = false;
            self.typing = false;
        }
    }
    // Back closes what is open over the call first (screen.rs back): the Transcript, the reply field, More.
    callback overlays(bool);
    property <bool> overlaid: Call.caps-open || Call.typing || Call.more;
    changed overlaid => { root.overlays(self.overlaid); }
    public function close-overlays() {
        Call.caps-open = false;
        Call.typing = false;
        Call.more = false;
    }
    property <string> phase: Call.phase;
    property <string> agent: Call.agent;
    property <string> time-text: Call.time-text;
    property <string> time-key: Call.time-key;
    property <string> status: Call.status;
    property <Cap> cap: Call.cap;
    property <string> bubble-text: Call.bubble-text;
    property <string> bubble-lit: Call.bubble-lit;
    property <bool> has-bubble: Call.has-bubble;
    property <string> me-text: Call.me-text;
    property <bool> me-live: Call.me-live;
    property <bool> show-me: Call.show-me;
    property <bool> show-pending: Call.show-pending;
    property <string> face: Call.face;
    property <float> face-x: Call.face-x;
    property <float> face-y: Call.face-y;
    property <float> face-k: Call.face-k;
    property <float> face-fade: Call.face-fade;
    property <bool> face-gpu: Call.face-gpu;
    property <image> face-live: Call.face-live;
    property <int> face-w: Call.face-w;
    property <int> face-h: Call.face-h;
    property <int> face-th: Call.face-th;
    property <float> level: Call.level;
    property <float> me-level: Call.me-level;
    property <float> t: Call.t;
    property <float> glow-t: Call.glow-t;
    property <bool> muted: Call.muted;
    property <bool> speaker: Call.speaker;
    property <bool> quiet: Call.quiet;
    property <bool> can-finish: Call.can-finish;
    property <bool> closed: Call.closed;
    property <[Msg]> msgs: Call.msgs;
    in-out property <bool> caps-open <=> Call.caps-open;
    in-out property <bool> typing <=> Call.typing;
    in-out property <string> draft <=> Call.draft;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> in-call: !incoming;
    property <bool> thread: phase == "hearing" || phase == "thinking";
    property <length> stage-top: sat + 60px;
    // While typing, the stage and the reply field sit above the keyboard (the window itself never resizes).
    property <length> stage-bottom: self.height - (typing ? kb + max(96px, sab + 302px - kb) : sab + 302px);
    property <length> controls-y: self.height - sab - 28px - 224px;
    property <length> col-w: (self.width - 32px) / 5;

    background: T.bg;
    title: "Claude Call";

    Glow {
        visible: Call.look == 0;
        width: parent.width;
        height: parent.height;
        level: root.level;
        t: root.glow-t;
        on: !root.ended;
    }

    screen := Rectangle {
        visible: Call.look == 0;
        opacity: root.closed ? 0 : 1;
        animate opacity { duration: 500ms; easing: T.close; }

        // ---- Header ----
        Rectangle {
            x: 24px;
            y: root.sat + 4px;
            width: parent.width - 48px;
            height: 52px;
            Text { x: 0; y: 2px; text: root.agent; font-size: 18px; font-weight: 700; color: T.fg; }
            SwapText { y: 28px; width: parent.width; height: 20px; text: root.time-text; key: root.time-key; font-size: 14px; color: T.muted; }
            // Hangs up and has Claude ring back in five minutes.
            later := Rectangle {
                x: parent.width - self.width;
                y: 6px;
                width: laterText.preferred-width + 28px;
                height: 40px;
                border-radius: 20px;
                background: laterTouch.pressed ? T.btn-on : T.btn;
                opacity: root.ended ? 0 : 1;
                transform-scale: laterTouch.pressed ? 0.94 : 1;
                animate background { duration: 200ms; easing: T.out; }
                animate transform-scale { duration: 160ms; easing: T.out; }
                animate opacity { duration: 200ms; easing: T.out; }
                laterText := Text { text: "Call back in 5 min"; font-size: 14px; color: laterTouch.pressed ? #111 : T.fg; vertical-alignment: center; horizontal-alignment: center; }
                laterTouch := TouchArea {
                    enabled: !root.ended;
                    clicked => { Call.call-back(); }
                }
            }
        }

        // ---- The stage: Clawd, the big caption, and the thread while you talk and Claude thinks ----
        stage := Rectangle {
            x: 0;
            y: root.stage-top;
            width: parent.width;
            height: root.stage-bottom - root.stage-top;

            // The caption flies into Claude's bubble when the thread opens, and grows back out of it.
            caps := Rectangle {
                x: 24px;
                y: 140px;
                width: parent.width - 48px;
                height: parent.height - 140px;
                clip: true;
                capSlots := Rectangle {
                    in-out property <Cap> a;
                    in-out property <Cap> b;
                    in-out property <int> pa: 1;
                    in-out property <int> pb: 0;
                    init => { self.a = root.cap; }
                    for slot in [0, 1]: VerticalLayout {
                        property <Cap> c: slot == 0 ? capSlots.a : capSlots.b;
                        property <int> p: slot == 0 ? capSlots.pa : capSlots.pb;
                        alignment: start;
                        spacing: 14px;
                        opacity: (p == 1 ? 1 : 0) * (root.thread ? 0 : 1);
                        y: (p == 0 ? 6px : p == 1 ? 0 : -6px) + (root.thread ? -68px : 0);
                        animate opacity { duration: p == 0 ? 0ms : root.thread ? 140ms : p == 1 ? 280ms : 140ms; delay: p == 1 && !root.thread ? 112ms : 0ms; easing: T.out; }
                        animate y { duration: p == 0 ? 0ms : root.thread ? 480ms : p == 1 ? 280ms : 140ms; delay: p == 1 && !root.thread ? 112ms : 0ms; easing: T.out; }
                        HorizontalLayout {
                            height: 20px;
                            spacing: 8px;
                            alignment: start;
                            visible: c.tone != "pre";
                            if c.orb: Orb { t: root.t; y: 0; c: #c9b6ff; }
                            Text {
                                text: c.label;
                                font-size: 14px;
                                font-weight: 650;
                                letter-spacing: 0.28px;
                                vertical-alignment: center;
                                color: c.tone == "rest" || c.tone == "dim" ? T.muted : c.tone == "hold" ? #c9b6ff : #e7a084;
                            }
                        }
                        Spoken {
                            text: c.text;
                            lit: c.lit;
                            font-size: root.typing || c.size == 2 ? 20px : c.size == 1 ? 24px : 30px; // smallest while the keyboard is up
                            weight: 500;
                            tracking: -0.012;
                            lit-color: c.tone == "dim" ? T.fg2 : T.fg;
                            opacity: c.tone == "rest" ? 0.62 : 1;
                        }
                    }
                }
            }

            thread := VerticalLayout {
                x: 16px;
                y: 72px;
                width: parent.width - 32px;
                height: parent.height - 72px;
                alignment: start;
                spacing: 12px;
                if root.has-bubble: HorizontalLayout {
                    alignment: start;
                    bubble := Rectangle {
                        max-width: (root.width - 32px) * 0.82;
                        background: #202227;
                        border-top-left-radius: 6px;
                        border-top-right-radius: 20px;
                        border-bottom-left-radius: 20px;
                        border-bottom-right-radius: 20px;
                        opacity: root.thread ? 1 : 0;
                        transform-origin: { x: 0, y: 0 };
                        transform-scale: root.thread ? 1 : 1.25;
                        y: root.thread ? 0 : 68px;
                        animate opacity { duration: root.thread ? 260ms : 170ms; delay: root.thread ? 90ms : 0ms; easing: T.out; }
                        animate transform-scale, y { duration: 480ms; easing: T.out; }
                        clip: true;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            max-height: 190px;
                            Spoken { text: root.bubble-text; lit: root.bubble-lit; hide-unsaid: true; }
                        }
                    }
                }
                if root.show-me: HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        background: T.me;
                        border-top-left-radius: 20px;
                        border-top-right-radius: 20px;
                        border-bottom-left-radius: 20px;
                        border-bottom-right-radius: 6px;
                        max-width: (root.width - 32px) * 0.82;
                        opacity: root.thread ? 1 : 0;
                        animate opacity { duration: root.thread ? 340ms : 140ms; delay: root.thread ? 220ms : 0ms; easing: T.out; }
                        if root.me-text != "": VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            Text { text: root.me-text; wrap: word-wrap; font-size: 16.5px; color: white; }
                        }
                        if root.me-text == "": HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 13px;
                            padding-bottom: 13px;
                            spacing: 6px;
                            for i in 3: Rectangle {
                                width: 8px;
                                height: 20px;
                                Rectangle {
                                    y: 6px - root.me-level * 7px * (0.6 + 0.4 * Math.sin((root.t * 8.3 + i * 1.7) * 1rad));
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #ffffffe0;
                                    opacity: root.me-live ? 1 : 0.35 + 0.65 * (0.5 + 0.5 * Math.cos((root.t * 5.7 - i * 0.86) * 1rad));
                                }
                            }
                        }
                    }
                }
                if root.show-pending: HorizontalLayout {
                    spacing: 10px;
                    padding-left: 4px;
                    height: 24px;
                    alignment: start;
                    opacity: root.thread ? 1 : 0;
                    animate opacity { duration: 340ms; delay: 220ms; easing: T.out; }
                    Orb { t: root.t; y: 2px; }
                    Text { text: root.agent + " is thinking…"; font-size: 15px; color: T.fg2; vertical-alignment: center; }
                }
            }

            // Whoever is calling: big over the caption, small on the bubble while the thread shows. A tap: a hop.
            Actor {
                x: root.face-x * 1px - 150px;
                y: root.face-y * 1px - 300px;
                width: 300px;
                height: 300px;
                face: root.face;
                k: root.face-k;
                live: root.face-gpu;
                source: root.face-live;
                lw: root.face-w;
                lh: root.face-h;
                th: root.face-th;
                opacity: root.face-fade;
                TouchArea {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height;
                    width: 260px * root.face-k;
                    height: 200px * root.face-k;
                    clicked => { Call.poke(); }
                }
            }
        }

        // ---- One status line, about the mic ----
        SwapText {
            x: 16px;
            y: root.height - root.sab - 270px - 22px;
            width: parent.width - 32px;
            height: 22px;
            text: root.status;
            font-size: 15px;
            color: #e8e9ec;
            align: center;
            visible: !root.typing;
        }

        // ---- Controls ----
        controls := Rectangle {
            x: 16px;
            y: root.controls-y;
            width: parent.width - 32px;
            height: 224px;
            for i in 5: Rectangle {
                x: root.col-w * i + (root.in-call ? 0 : (2 - i) * 76px);
                y: root.in-call ? 0 : 124px;
                width: root.col-w;
                height: 90px;
                opacity: root.in-call ? 1 : 0;
                transform-origin: { x: root.col-w / 2, y: 29px };
                transform-scale: root.in-call ? 1 : 0.35;
                animate x, y, transform-scale { duration: root.in-call ? 500ms : 300ms; delay: root.in-call ? i * 30ms : 0ms; easing: root.in-call ? T.spring : T.close; }
                animate opacity { duration: 200ms; delay: root.in-call ? i * 30ms : 0ms; easing: T.out; }
                Round {
                    size: 58px;
                    icon: i == 0 ? (root.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.speaker-off : i == 2 ? Icons.speaker : i == 3 ? Icons.captions : Icons.keyboard;
                    label: i == 0 ? (root.muted ? "Unmute" : "Mute") : i == 1 ? "Quiet" : i == 2 ? "Speaker" : i == 3 ? "Captions" : "Type";
                    pressed: i == 0 ? root.muted : i == 1 ? root.quiet : i == 2 ? root.speaker : i == 3 ? root.caps-open : root.typing;
                    enabled: root.in-call && !root.ended;
                    faded: root.typing;
                    clicked => {
                        if (i == 0) { Call.toggle-mute(); }
                        else if (i == 1) { Call.toggle-quiet(); }
                        else if (i == 2) { Call.toggle-speaker(); }
                        else if (i == 3) { root.caps-open = !root.caps-open; }
                        else { root.typing = !root.typing; }
                    }
                }
            }
            // The big buttons: Answer while ringing, then Done talking; beside it, red, Decline / Hang up.
            Rectangle {
                y: 118px;
                width: parent.width;
                height: 104px;
                big := Rectangle {
                    property <bool> live: root.incoming || root.can-finish;
                    x: parent.width / 2 - 76px - 28px;
                    y: 0;
                    width: 76px;
                    height: 76px;
                    // The ring pulses outward while it is ringing.
                    if root.incoming: Rectangle {
                        property <float> k: Math.mod(root.t, 1.8) / 1.8;
                        x: -26px * self.k;
                        y: -26px * self.k;
                        width: 76px + 52px * self.k;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: #2fa84f;
                        opacity: 0.55 * (1 - self.k);
                    }
                    Rectangle {
                        border-radius: 38px;
                        background: big.live ? T.ok : #2a2c31;
                        transform-origin: { x: 38px, y: 38px };
                        transform-scale: bigTouch.pressed && big.live ? 0.94 : 1;
                        animate background { duration: 260ms; easing: T.out; }
                        animate transform-scale { duration: 160ms; easing: T.out; }
                        for g in [{ d: Icons.phone, show: root.incoming }, { d: Icons.check, show: !root.incoming }]: Icon {
                            d: g.d;
                            width: 30px;
                            height: 30px;
                            x: 23px;
                            y: 23px;
                            stroke: big.live ? white : #7d8088;
                            opacity: g.show ? 1 : 0;
                            transform-origin: { x: 15px, y: 15px };
                            transform-scale: g.show ? 1 : 0.6;
                            transform-rotation: g.show ? 0deg : -40deg;
                            animate opacity { duration: 180ms; }
                            animate transform-scale, transform-rotation { duration: 500ms; easing: T.spring; }
                        }
                        bigTouch := TouchArea {
                            enabled: big.live;
                            clicked => { if (root.incoming) { Call.answer(); } else { Call.done-talking(); } }
                        }
                    }
                }
                hang := Rectangle {
                    x: parent.width / 2 + 28px;
                    y: 0;
                    width: 76px;
                    height: 76px;
                    opacity: root.ended ? 0 : 1;
                    animate opacity { duration: 200ms; easing: T.out; }
                    Rectangle {
                        border-radius: 38px;
                        background: endTouch.pressed ? #c23a3f : #e5484d;
                        transform-origin: { x: 38px, y: 38px };
                        transform-scale: endTouch.pressed ? 0.94 : 1;
                        animate background { duration: 200ms; easing: T.out; }
                        animate transform-scale { duration: 160ms; easing: T.out; }
                        Icon {
                            d: Icons.phone;
                            width: 30px;
                            height: 30px;
                            x: 23px;
                            y: 23px;
                            stroke: white;
                            transform-origin: { x: 15px, y: 15px };
                            transform-rotation: 135deg; // the handset put down
                        }
                        endTouch := TouchArea {
                            enabled: !root.ended;
                            clicked => { Call.hang-up(); }
                        }
                    }
                }
                Rectangle {
                    x: hang.x - 40px;
                    y: 84px;
                    width: 156px;
                    height: 20px;
                    opacity: hang.opacity;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: endLabel.preferred-width + 14px;
                            border-radius: 9px;
                            endLabel := Text { text: root.incoming ? "Decline" : "Hang up"; font-size: 14px; color: #e8e9ec; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle {
                    x: big.x - 40px;
                    y: 84px;
                    width: 156px;
                    height: 20px;
                    HorizontalLayout {
                        alignment: center;
                        // Sized to the label it is changing to (measured by a hidden copy).
                        measure := Text { text: root.incoming ? "Answer" : "Done talking"; font-size: 14px; visible: false; width: 0; }
                        Rectangle {
                            width: measure.preferred-width + 14px;
                            border-radius: 9px;
                            SwapText { width: measure.preferred-width + 14px; height: 20px; text: root.incoming ? "Answer" : "Done talking"; font-size: 14px; color: #e8e9ec; align: center; }
                        }
                    }
                }
            }
        }

        // ---- Transcript: grows out of the Captions button ----
        Morph {
            open: root.caps-open && root.in-call;
            fx: 16px + root.col-w * 3.5 - 29px;
            fy: root.controls-y;
            fsize: 58px;
            tx: 12px;
            ty: root.sat + 8px;
            tw: root.width - 24px;
            th: root.height - root.sat - 8px - root.sab - 162px - 106px;
            face: Icons.captions;
            panel: #1c1d21;
            VerticalLayout {
                Rectangle {
                    height: 60px;
                    Text { x: 20px; text: "Transcript"; font-size: 17px; font-weight: 700; color: T.fg; vertical-alignment: center; height: parent.height; }
                    Rectangle {
                        x: parent.width - 54px;
                        y: 6px;
                        width: 48px;
                        height: 48px;
                        Icon { d: Icons.close; x: 12px; y: 12px; }
                        TouchArea { clicked => { root.caps-open = false; } }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #2a2c31; }
                }
                log := Flickable {
                    content-height: rows.preferred-height;
                    content-y: Math.min(0px, self.height - rows.preferred-height);
                    rows := VerticalLayout {
                        width: root.width - 24px;
                        padding: 16px;
                        spacing: 12px;
                        for m in root.msgs: HorizontalLayout {
                            alignment: m.me ? end : start;
                            Rectangle {
                                max-width: (root.width - 56px) * 0.8;
                                background: m.me ? T.me : #202227;
                                border-top-left-radius: 20px;
                                border-top-right-radius: 20px;
                                border-bottom-left-radius: m.me ? 20px : 6px;
                                border-bottom-right-radius: m.me ? 6px : 20px;
                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    Spoken { text: m.text; lit: m.lit; lit-color: m.me ? white : T.fg; }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Type a reply: grows out of the Type button ----
        typeSheet := Morph {
            open: root.typing && root.in-call && !root.ended;
            fx: 16px + root.col-w * 4.5 - 29px;
            fy: root.controls-y;
            fsize: 58px;
            tx: 16px;
            ty: root.height - root.kb - max(12px, root.sab + 188px - root.kb) - 64px; // 12px above the keyboard
            tw: root.width - 32px;
            th: 64px;
            radius: 32px;
            face: Icons.keyboard;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 8px;
                spacing: 4px;
                alignment: stretch;
                input := TextInput {
                    text <=> root.draft;
                    font-size: 17px;
                    color: T.fg;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => { if (root.draft != "") { Call.send(root.draft); root.draft = ""; root.typing = false; } }
                    Text {
                        x: 0;
                        width: parent.width;
                        visible: root.draft == "";
                        text: "Type a reply";
                        font-size: 17px;
                        color: #8c8f97;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Rectangle {
                    width: 48px;
                    height: 48px;
                    y: 8px;
                    border-radius: 24px;
                    background: root.draft != "" ? T.accent : transparent;
                    animate background { duration: 200ms; easing: T.out; }
                    Icon { d: Icons.send; x: 12px; y: 12px; stroke: root.draft != "" ? white : T.muted; }
                    TouchArea {
                        enabled: root.draft != "";
                        clicked => { Call.send(root.draft); root.draft = ""; root.typing = false; }
                    }
                }
                Rectangle {
                    width: 48px;
                    height: 48px;
                    y: 8px;
                    Icon { d: Icons.close; x: 12px; y: 12px; }
                    TouchArea { clicked => { root.typing = false; } }
                }
            }
        }
    }

    // PREVIEW (branch preview/call-screen): the call screen directions, from debug.callme.call
    if Call.look == 1: StageLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    if Call.look == 2: CloseLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    if Call.look == 3: ComicLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    if Call.look == 4: LyricsLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    // PREVIEW (branch preview/call-screen-2): round 2, in the spotlight (debug.callme.call 1-4)
    if Call.look == 5: SubsLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    if Call.look == 6: ScriptLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    if Call.look == 7: LightLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }
    if Call.look == 8: CameraLook {
        width: root.width;
        height: root.height;
        opacity: root.closed || !Call.placed ? 0 : 1;
        animate opacity { duration: Call.placed && !root.closed ? 180ms : 500ms; easing: T.close; }
    }

    // Focus once the field has grown into view (Android won't raise the keyboard for a field still clipped away).
    focusSoon := Timer { interval: 220ms; running: false; triggered => { self.running = false; if (root.typing && Call.look == 0) { input.focus(); } } }
    changed typing => { if (self.typing) { focusSoon.running = true; } else if (Call.look == 0) { input.clear-focus(); } }
    // A new caption crossfades in over the old one; the same caption (more words said) updates in place.
    changed cap => {
        if (capSlots.pa == 1 && capSlots.a.key != self.cap.key) { capSlots.b = self.cap; capSlots.pb = 0; capSlots.pb = 1; capSlots.pa = 2; }
        else if (capSlots.pb == 1 && capSlots.b.key != self.cap.key) { capSlots.a = self.cap; capSlots.pa = 0; capSlots.pa = 1; capSlots.pb = 2; }
        else if (capSlots.pa == 1) { capSlots.a = self.cap; } else { capSlots.b = self.cap; }
    }
}
