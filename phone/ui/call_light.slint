// PREVIEW (branch preview/call-screen-2) direction 3, Your light: two places on the stage. The caller stands in its
// spotlight, its words hanging in the beam above its head, each fading in as it is said. You have a light too: a
// cool pool on the front of the stage, nearest you, that comes up when it's your turn, breathes while it waits for you
// and brightens as you speak; your words appear in it, and Done talking with them. While the caller works its beam
// goes low and its name says so; on hold both lights are low; at the end both go out.
// Controls: one row along the bottom, Hang up in the middle (Decline and Answer either side of it while it rings),
// Mute and Type beside it, Speaker and More at the ends; More raises Quiet, Transcript and In 5 min above it.
import { T, Icon, Icons, SwapText, Msg } from "parts.slint";
import { Call } from "call_data.slint";
import { Sheets } from "call_kit.slint";
import { Spot, SpotBack, SpotCap, Dots, Glyph, Pill, SpotCaller } from "call_spot.slint";

export component LightLook inherits Rectangle {
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <length> W: root.width;
    property <length> H: root.height;
    property <bool> keys: Call.typing && Call.kb > 0;
    property <length> fx: W / 2;
    property <length> fy: round(H * 0.54 / 1px) * 1px;
    property <length> by: H - Call.sab - 34px - 56px; // the bottom row (labels under it)

    // ---- Your light: a cool pool on the front of the stage ----
    property <float> mine: ended ? 0 : incoming ? 0.22 + 0.16 * Math.pow(0.5 + 0.5 * Math.cos(Math.mod(Call.t, 1.5) / 1.5 * 360deg), 2)
        : phase == "listening" ? 0.5 + 0.12 * Math.sin(Call.t * 0.55 * 360deg)
        : phase == "hearing" ? 0.7 + 0.3 * Math.min(1, Call.me-level * 1.6)
        : phase == "thinking" ? 0.32 : phase == "hold" ? 0.14 : 0.06;
    animate mine { duration: 260ms; easing: T.out; }

    SpotBack { width: W; height: H; fx: root.fx; fy: root.fy; k: 0.95; drawn-k: 0.95; source: @image-url("stage/spot-light.png"); }
    property <length> pool-w: W * 1.2;
    property <length> pool-y: root.fy + 104px + 58px; // its middle, on the floor in front of the caller, round your words
    Rectangle {
        x: (W - root.pool-w) / 2;
        y: root.pool-y - root.pool-w / 2;
        width: root.pool-w;
        height: root.pool-w;
        transform-origin: { x: root.pool-w / 2, y: root.pool-w / 2 };
        transform-scale-y: 0.3;
        background: @radial-gradient(circle, #c4d4f04c 0%, #b4c8ee36 38%, #a9bfe91c 56%, #a9bfe908 65%, #a9bfe900 70%);
        opacity: root.mine;
    }
    SpotCaller { fx: root.fx; fy: root.fy; }

    // ---- Header ----
    Text { y: Call.sat + 12px; width: W; height: 20px; text: Call.agent; font-size: 15px; font-weight: 600; color: T.fg; horizontal-alignment: center; vertical-alignment: center; }
    SwapText { x: 0; y: Call.sat + 33px; width: W; height: 18px; text: Call.time-text; key: Call.time-key; font-size: 12.5px; color: T.muted; align: center; }

    // ---- The caller's words, in its beam over its head ----
    property <length> top-y: Call.sat + 68px;
    property <length> top-bottom: root.fy - 232px;
    property <string> label: Call.notice != "" ? Call.notice.to-uppercase()
        : incoming ? "INCOMING CALL" : phase == "connecting" ? "CONNECTING" : phase == "thinking" ? (Call.agent + " is thinking").to-uppercase()
        : phase == "hold" ? Call.cap.label.to-uppercase() : ended ? Call.cap.label : Call.agent.to-uppercase();
    Rectangle {
        x: 32px;
        y: root.top-y;
        width: W - 64px;
        height: root.top-bottom - root.top-y;
        lmeasure := Text { text: root.label; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; visible: false; }
        SwapText {
            y: 0;
            width: parent.width;
            height: 16px;
            text: root.label;
            key: phase == "hold" ? "hold" : root.label;
            font-size: 11px;
            weight: 600;
            tracking: 1.6px;
            color: Call.notice != "" ? #e8a08a : phase == "hold" ? Spot.hold : Spot.label;
            align: center;
        }
        Dots {
            x: (parent.width + lmeasure.preferred-width) / 2 + 4px;
            y: 10px;
            opacity: phase == "thinking" && Call.notice == "" ? 1 : 0;
            animate opacity { duration: 300ms; }
        }
        SpotCap {
            y: 26px;
            width: parent.width;
            height: parent.height - 26px;
            hide: phase == "thinking";
            rest-opacity: 0.5;
        }
    }

    // ---- Your words, in your light ----
    property <bool> said-some: Call.me-text != "" && (phase == "hearing" || phase == "thinking");
    property <bool> your-turn: phase == "listening" || phase == "hearing" || phase == "thinking";
    // while the caller answers, what you last said stays in your light, dim (usually the line before its own)
    property <Msg> before: Call.msgs[Call.msgs.length - 2];
    property <bool> echo: phase == "talking" && root.before.me;
    property <length> me-top: root.fy + 104px;
    property <length> me-bottom: root.by - 22px - (Call.can-finish ? 64px : 0px);
    animate me-bottom { duration: 420ms; easing: T.spring; }
    Rectangle {
        x: 32px;
        y: root.me-top;
        width: W - 64px;
        height: root.me-bottom - root.me-top;
        opacity: (root.your-turn ? 1 : root.echo ? 0.42 : 0) * (root.keys ? 0 : 1);
        animate opacity { duration: 360ms; easing: T.out; }
        Text {
            y: 0;
            width: parent.width;
            height: 16px;
            text: "YOU";
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            color: Spot.label-cool;
            horizontal-alignment: center;
        }
        Text {
            y: 26px;
            width: parent.width;
            height: parent.height - 26px;
            text: root.said-some ? Call.me-text : root.echo ? root.before.text : Call.notice != "" ? Call.notice : phase == "thinking" ? "" : "Take your time.";
            wrap: word-wrap;
            font-size: root.said-some || root.echo ? 21px : 17px;
            color: root.said-some || root.echo ? Spot.cool : Spot.cool.with-alpha(0.55);
            horizontal-alignment: center;
            vertical-alignment: top;
            opacity: phase == "thinking" ? 0.66 : 1;
            animate opacity { duration: 300ms; }
        }
    }
    // Done talking, in your light under your words, only while there's something to finish
    Pill {
        x: (W - self.width) / 2;
        y: root.by - 14px - 56px - 10px;
        width: 176px;
        icon: Icons.check;
        label: "Done talking";
        fill: Spot.cool;
        ink: #111722;
        enabled: Call.can-finish && !root.ended && !root.keys;
        opacity: Call.can-finish && !root.ended && !root.keys ? 1 : 0;
        transform-origin: { x: self.width / 2, y: 28px };
        transform-scale: Call.can-finish ? 1 : 0.86;
        animate opacity { duration: Call.can-finish ? 260ms : 160ms; easing: T.out; }
        animate transform-scale { duration: Call.can-finish ? 520ms : 200ms; easing: Call.can-finish ? T.spring : T.close; }
        clicked => { Call.done-talking(); }
    }

    // ---- The bottom row ----
    property <length> step: Math.min(84px, (W - 32px) / 4.6);
    property <bool> more <=> Call.more;
    for i in 4: Glyph {
        // Speaker, Mute | Type, More, either side of Hang up
        property <int> at: i == 0 ? -2 : i == 1 ? -1 : i == 2 ? 1 : 2;
        x: W / 2 + self.at * root.step - self.width / 2;
        y: root.by + 15px;
        icon: i == 0 ? Icons.speaker : i == 1 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 2 ? Icons.keyboard : (root.more ? Icons.close : "M5 12h0.01 M12 12h0.01 M19 12h0.01");
        label: i == 0 ? "Speaker" : i == 1 ? (Call.muted ? "Unmute" : "Mute") : i == 2 ? "Type" : (root.more ? "Close" : "More");
        on: i == 0 ? Call.speaker : i == 1 ? Call.muted : i == 2 ? Call.typing : root.more;
        enabled: !root.incoming && !root.ended && self.opacity > 0.9; // live once shown: a second tap on Answer lands on nothing
        opacity: root.incoming || root.ended || root.keys ? 0 : 1;
        animate opacity { duration: 240ms; delay: root.incoming ? 0ms : 120ms + 60ms * Math.abs(self.at); easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-speaker(); }
            else if (i == 1) { Call.toggle-mute(); }
            else if (i == 2) { Call.typing = !Call.typing; root.more = false; }
            else { root.more = !root.more; }
        }
    }
    // Hang up in the middle; while it rings, Decline and Answer either side of it
    Pill {
        x: (root.incoming ? W / 2 - root.step : W / 2) - 28px;
        y: root.by;
        width: 56px;
        icon: Icons.phone;
        turn: true;
        fill: Spot.red;
        enabled: !root.ended && !root.keys; // hidden while typing: a tap there must not hang up
        opacity: root.ended || root.keys ? 0 : 1;
        animate x { duration: 520ms; easing: T.spring; }
        animate opacity { duration: 260ms; easing: T.out; }
        clicked => { Call.hang-up(); }
    }
    Pill {
        x: W / 2 + root.step - 28px;
        y: root.by;
        width: 56px;
        icon: Icons.phone;
        fill: Spot.green;
        enabled: root.incoming;
        opacity: root.incoming ? 1 : 0;
        transform-origin: { x: 28px, y: 28px };
        transform-scale: root.incoming ? 1 : 0.6;
        animate opacity { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 300ms; easing: T.close; }
        clicked => { Call.answer(); }
    }
    for side in 2: Text {
        x: (side == 0 ? W / 2 - root.step : W / 2 + root.step) - 50px;
        y: root.by + 60px;
        width: 100px;
        height: 16px;
        text: side == 0 ? "Decline" : "Answer";
        font-size: 11px;
        color: #ebe5dc99;
        horizontal-alignment: center;
        opacity: root.incoming ? 1 : 0;
        animate opacity { duration: 220ms; }
    }

    // ---- More: Quiet, Transcript and In 5 min rise in a column over the More button ----
    for j in 3: Glyph {
        property <bool> shown: root.more && !root.ended && !root.keys;
        x: W / 2 + 2 * root.step - self.width / 2;
        y: root.by + 15px - (j + 1) * 62px + (self.shown ? 0 : 12px);
        icon: j == 0 ? Icons.speaker-off : j == 1 ? Icons.captions : Icons.later;
        label: j == 0 ? "Quiet" : j == 1 ? "Transcript" : "In 5 min";
        on: j == 0 ? Call.quiet : j == 1 ? Call.caps-open : false;
        enabled: self.shown;
        opacity: self.shown ? 1 : 0;
        animate y { duration: self.shown ? 520ms : 220ms; delay: self.shown ? j * 45ms : 0ms; easing: self.shown ? T.spring : T.close; }
        animate opacity { duration: self.shown ? 280ms : 160ms; delay: self.shown ? j * 45ms : 0ms; easing: T.out; }
        clicked => {
            if (j == 0) { Call.toggle-quiet(); }
            else if (j == 1) { Call.caps-open = !Call.caps-open; root.more = false; }
            else { Call.call-back(); }
        }
    }

    Sheets {
        width: W;
        height: H;
        caps-x: W / 2 + 2 * root.step - 22px;
        caps-y: root.by + 15px - 2 * 62px + 13px - 22px;
        type-x: W / 2 + root.step - 22px;
        type-y: root.by + 15px + 13px - 22px;
        fsize: 44px;
        keep: H - root.by - Call.sab + 8px;
        lift: 110px;
    }
    changed phase => { if (root.ended) { root.more = false; } }
}
