// The home screen ("stage"): Clawd and Null in the spotlight, one line under them naming the contact mode, and a row
// along the bottom: Chats (the in-app chats with the agents) and Call (asks the agent picked by tapping Clawd or Null
// to phone you); while setup is unfinished, a quiet amber line under the mode opens it; once it is done, the same
// place names an agent's question while it waits, and opens it. The mode is changed on Null
// himself: drag up or down on him and his LED face rolls through the six modes; letting go keeps the one he shows.
import { T, Icon, Icons, Morph, SwapText } from "parts.slint";
import { Home, RoundIcon } from "home_parts.slint";
import { Toys, Clawd, Null } from "toys.slint";
import { Chats, NewChat, Ink } from "chat.slint";
import { ChatList } from "chats/list.slint";
import { ChatThread } from "chats/thread.slint";
import { Sheet } from "chats/open.slint";
import { StageBack, Look } from "stage.slint";

export component HomeScreen inherits Window {
    background: Look.bg;
    title: "Claude Call";
    property <length> row-y: self.height - Home.sab - 20px - 56px; // the bottom row
    // each stage leaves its own room under the pair, so the line sits clear of the floor they stand on
    property <length> under: Toys.stage == 1 ? 112px : Toys.stage == 2 ? 74px : Toys.stage == 3 ? 104px : Toys.stage == 4 ? 84px : 28px;
    // while Null's face rolls, the rest steps back
    property <float> rest: Home.shown >= 0 ? 0.35 : 1;
    animate rest { duration: 260ms; easing: T.out; }
    // The keyboard, while a field is in use, frame by frame as it slides (Home.kb). An open chat always follows it:
    // back from another app, Android raises the keyboard again for the field without it taking focus anew.
    property <length> kb: Home.typing || (Chats.open && Chats.current != "") ? Home.kb : 0px;

    // Clawd's eyes follow a finger anywhere on the screen that nothing else takes.
    TouchArea {
        function point(down: bool) {
            Toys.point(self.mouse-x - clawd.absolute-position.x - clawd.width / 2, self.mouse-y - clawd.absolute-position.y - clawd.height * 0.4, down);
        }
        pointer-event(e) => { self.point(e.kind == PointerEventKind.down || e.kind == PointerEventKind.move); }
        moved => { self.point(true); }
    }
    StageBack {
        width: parent.width;
        height: parent.height;
        feet: stage.y + 176px * Toys.k * 0.967;
    }
    // The stage light behind Clawd and Null.
    if Toys.stage == 0: Rectangle {
        x: (parent.width - 440px) / 2;
        y: stage.y + 40px - 220px; // centred on the pair
        width: 440px;
        height: 440px;
        background: @radial-gradient(circle, #d977572e 0%, #8a5cff14 40%, #11121400 70%);
    }
    Text {
        y: Home.sat + 14px;
        width: parent.width;
        text: "Claude Call";
        font-size: 18px;
        font-weight: 700;
        color: T.fg;
        horizontal-alignment: center;
        opacity: root.rest;
    }
    // The stage, centred between the title and the bottom row.
    stage := VerticalLayout {
        // Out of the way while the keyboard is up.
        opacity: root.kb > 0 ? 0 : 1;
        animate opacity { duration: 200ms; easing: T.out; }
        x: 20px;
        width: parent.width - 40px;
        y: Home.sat + 52px + (root.row-y - Home.sat - 52px - self.preferred-height) * 0.5;
        height: self.preferred-height;
        // The vinyl Clawd and Null (toys.slint), alive; the one the Call button asks for is lit, the other dimmed.
        pair := HorizontalLayout {
            alignment: center;
            spacing: 4px * Toys.k;
            clawd := Clawd {
                width: 230px * Toys.k;
                height: 176px * Toys.k;
                // on a stage the one not asked for is dimmed in its light (stage.rs), not see-through
                opacity: Home.caller == "claude" || Toys.stage > 0 ? 1 : 0.55;
                animate opacity { duration: 250ms; easing: T.out; }
                tapped => { Home.caller = "claude"; Toys.tapped("claude"); }
            }
            null := Null {
                width: 96px * Toys.k;
                height: 172px * Toys.k;
                opacity: Home.caller == "codex" || Toys.stage > 0 ? 1 : 0.55;
                animate opacity { duration: 250ms; easing: T.out; }
                tapped => { Home.caller = "codex"; Toys.tapped("codex"); }
            }
        }
        Rectangle { height: root.under; }
        // The mode, in words: it changes as Null's face rolls.
        SwapText {
            height: 34px;
            text: Home.current.title;
            font-size: 24px;
            weight: 600;
            color: T.fg;
            align: center;
        }
        // Setup, while unfinished: one quiet amber line; a tap goes through what is still needed.
        if !Home.ready: Rectangle {
            height: 30px;
            opacity: root.rest;
            Text {
                text: Home.setup-text;
                font-size: 14px;
                font-weight: 600;
                color: #e8a33d;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { y: -9px; height: 48px; clicked => { Home.set-up(); } }
        }
    }
    // An agent's question waiting (setup done): its chat named in warm words where the setup line was; a tap opens it
    // as a notification does. Over the stage, not in it, so the pair never moves when one comes or goes.
    property <bool> asking: Home.ready && Home.ask-chat != "" && root.kb == 0;
    Rectangle {
        x: 24px;
        y: stage.y + stage.height;
        width: parent.width - 48px;
        height: 30px;
        opacity: root.asking ? root.rest : 0;
        animate opacity { duration: 260ms; easing: T.out; }
        Text {
            width: parent.width;
            height: parent.height;
            text: Home.ask-line;
            font-size: 14px;
            font-weight: 600;
            color: T.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            y: -9px;
            height: 48px;
            enabled: root.asking;
            clicked => {
                Chats.picker = false;
                Chats.from-id = ""; // no card to carry a character from
                Chats.open = true;
                Chats.open-chat(Home.ask-chat); // through Rust, as the list does: its own draft is in place first
            }
        }
    }
    // The one-time hint by Null's feet: his face rolls up or down.
    Icon {
        d: Icons.updown;
        width: 18px;
        height: 18px;
        x: stage.x + pair.x + null.x + (null.width - self.width) / 2;
        y: stage.y + pair.y + null.y + null.height + 4px + (Home.hint ? 3px * Math.sin(animation-tick() / 1400ms * 360deg) : 0px);
        stroke: T.fg2;
        stroke-width: 1.8px;
        opacity: Home.hint && Home.shown < 0 ? 0.8 : 0;
        animate opacity { duration: 600ms; easing: T.out; }
    }

    // The bottom row: Chats, and Call filling the rest (the one big warm button).
    Rectangle {
        x: 24px;
        y: root.row-y;
        width: parent.width - 48px;
        height: 56px;
        opacity: root.rest;
        RoundIcon {
            x: 0;
            y: 2px;
            icon: Icons.chat;
            dot: Chats.unread;
            clicked => { Chats.open = true; }
        }
        // Asks Claude (or Codex, if Null is picked) to call you; it rings within a minute or so.
        Rectangle {
            x: 52px + 16px;
            width: parent.width - self.x;
            border-radius: self.height / 2;
            background: Home.requested || Home.no-answer ? T.btn : call.pressed ? #c4664a : T.accent;
            animate background { duration: 250ms; easing: T.out; }
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: call.pressed && !Home.requested ? 0.96 : 1;
            animate transform-scale { duration: 160ms; easing: T.out; }
            SwapText {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: Home.requested ? "Calling you…" : Home.no-answer ? "No answer from the PC" : Home.caller == "codex" ? "Call Codex" : "Call Claude";
                font-size: 16px;
                weight: 600;
                color: Home.requested || Home.no-answer ? T.fg2 : #ffffff;
                align: center;
            }
            call := TouchArea { clicked => { if (!Home.requested) { Home.call(Home.caller); } } }
        }
    }

    // Back closes what is open (the new-chat picker, a chat, the Chats screen); otherwise the app goes to the
    // background.
    forward-focus: keys;
    // Leaving a chat, or putting the keyboard away in one, hands focus back here: with nothing focused, Back went
    // straight past the Chats screen and left the app, and the field kept its cursor handle on screen.
    property <string> chat-now: Chats.current;
    changed chat-now => { if (chat-now == "") { keys.focus(); } }
    // At the end of the keyboard's slide away the chat's field lets go of the focus, so Back right after lands on
    // the chat, not past it.
    changed kb => { if (self.kb == 0 && Chats.current != "") { keys.focus(); } }
    // Back steps out one level: the photo, picker, a row slid open, thread, Chats screen. False when nothing is left;
    // then the app goes to the background, warm, as the launcher left it (not closed).
    function back() -> bool {
        return Chats.back();
    }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Back) {
                if (!root.back()) { Home.leave(); }
                return accept;
            }
            reject
        }
    }
    // The system back swipe (Shell.kt, while something is open): phase 0 starts, 1 moves (p 0..1), 2 lets go (Back),
    // 3 cancels. An open chat follows the thumb as it does a pull down (chats/open.slint), up to the point where a
    // pull would close it; the rest close as Back always has. The keyboard goes first, as it does for Back.
    property <bool> held;
    public function back-gesture(phase: int, p: float) {
        if (phase == 0) {
            root.held = Chats.current != "" && !Chats.viewing && !Home.typing && root.kb == 0;
            if (root.held) { Chats.held = true; }
        } else if (phase == 1) {
            if (root.held) { thread.pull(p * 0.3 * root.height); }
        } else if (phase == 3) {
            if (root.held) { root.held = false; thread.let-go(false); }
        } else if (root.held) {
            root.held = false;
            thread.let-go(true);
        } else if (Home.typing && Chats.current != "") {
            keys.focus(); // the field lets go: the keyboard goes
        } else if (!root.back()) {
            Home.leave();
        }
    }
    property <bool> backable: Chats.open || Chats.viewing || Chats.picker || Chats.revealed != "";
    changed backable => { Home.backable(self.backable); }

    // The Chats screen grows out of its button and fills the screen; the new-chat picker grows out of its "+".
    Morph {
        open: Chats.open;
        panel: Ink.bg;
        fx: 24px;
        fy: root.row-y + 2px;
        fsize: 52px;
        tx: 0px;
        ty: 0px;
        tw: root.width;
        th: root.height;
        radius: 0px;
        face: Icons.chat;
        from: T.btn;
        // The list sinks back a little under a chat rising over it (chats/open.slint).
        ChatList {
            width: root.width;
            height: root.height;
            visible: !thread.full;
            transform-origin: { x: self.width * 0.5, y: self.height * 0.7 };
            transform-scale: 1 - 0.06 * Chats.open-k;
        }
        thread := Sheet {
            open: Chats.current != "";
            kb: root.kb;
            width: root.width;
            height: root.height;
            if thread.shown: ChatThread {
                width: root.width;
                height: root.height;
                kb: root.kb;
                pulled(p) => { thread.pull(p); }
                let-go(close) => { thread.let-go(close); }
            }
        }
    }

    // The list dims behind the picker; a tap there closes it.
    Rectangle {
        background: #000000;
        opacity: Chats.picker ? 0.55 : 0;
        animate opacity { duration: Chats.picker ? 300ms : Chats.current != "" ? 0ms : 220ms; easing: T.out; }
    }
    if Chats.picker: TouchArea {
        clicked => { Chats.picker = false; }
    }

    // Picking an agent opens its chat at once, out of the picker: the picker gives way to it there and then, rather
    // than shrinking back into a "+" that the chat doesn't have (or fading out over it).
    Rectangle {
        opacity: Chats.current == "" ? 1 : 0;
        Morph {
            open: Chats.picker;
            panel: #1c1c20;
            fx: root.width - 60px; // the list's + (chats/screens.slint)
            fy: Home.sat + 6px;
            fsize: 48px;
            tw: root.width - 24px;
            tx: 12px;
            th: 166px;
            ty: Home.sat + 58px;
            radius: 26px;
            face: Icons.plus;
            NewChat { width: parent.width; height: parent.height; }
        }
    }
}
