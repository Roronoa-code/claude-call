// The home screen ("stage"): Clawd and Null in the spotlight, one line under them naming the contact mode, and a row
// along the bottom: Chats (the in-app chats with the agents), Call (asks the agent picked by tapping Clawd or Null to
// phone you) and ••• (Test ring, Widget, and setup while it is unfinished). The mode is changed on Null himself: drag
// up or down on him and his LED face rolls through the six modes; letting go keeps the one he shows.
import { T, Icon, Icons, Morph, SwapText } from "parts.slint";
import { Home, RoundIcon } from "home_parts.slint";
import { Toys, Clawd, Null } from "toys.slint";
import { Chats, ChatList, ChatThread, NewChat, Ink } from "chat.slint";
import { StageBack, Look } from "stage.slint";

// A choice in a sheet: icon, title and a line under it.
component Choice {
    in property <string> icon;
    in property <brush> tint: T.fg;
    in property <string> title;
    in property <string> desc;
    callback clicked;
    height: 64px;
    Rectangle {
        border-radius: 18px;
        background: touch.pressed ? #34363c : #26282d;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Rectangle {
            width: 24px;
            Icon { d: root.icon; y: 20px; stroke: root.tint; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: T.fg; }
            Text { text: root.desc; font-size: 13px; color: T.muted; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component HomeScreen inherits Window {
    background: Look.bg;
    title: "Claude Call";
    property <string> draft;
    property <length> row-y: self.height - Home.sab - 20px - 56px; // the bottom row
    property <length> more-x: self.width - 24px - 52px; // the ••• button, where its sheets grow from
    property <length> sheet-x: 16px;
    property <length> sheet-w: self.width - 2 * self.sheet-x;
    property <length> sheet-bottom: self.row-y + 56px;
    // each stage leaves its own room under the pair, so the line sits clear of the floor they stand on
    property <length> under: Toys.stage == 1 ? 112px : Toys.stage == 2 ? 74px : Toys.stage == 3 ? 104px : Toys.stage == 4 ? 84px : 28px;
    // while Null's face rolls, the rest steps back
    property <float> rest: Home.shown >= 0 ? 0.35 : 1;
    animate rest { duration: 260ms; easing: T.out; }

    // Clawd's eyes follow a finger anywhere on the screen that nothing else takes.
    TouchArea {
        function point(down: bool) {
            Toys.point(self.mouse-x - clawd.absolute-position.x - clawd.width / 2, self.mouse-y - clawd.absolute-position.y - clawd.height * 0.4, down);
        }
        pointer-event(e) => { self.point(e.kind == PointerEventKind.down || e.kind == PointerEventKind.move); }
        moved => { self.point(true); }
    }
    StageBack {
        width: parent.width;
        height: parent.height;
        feet: stage.y + 176px * Toys.k * 0.967;
    }
    // The stage light behind Clawd and Null.
    if Toys.stage == 0: Rectangle {
        x: (parent.width - 440px) / 2;
        y: stage.y + 40px - 220px; // centred on the pair
        width: 440px;
        height: 440px;
        background: @radial-gradient(circle, #d977572e 0%, #8a5cff14 40%, #11121400 70%);
    }
    Text {
        y: Home.sat + 14px;
        width: parent.width;
        text: "Claude Call";
        font-size: 18px;
        font-weight: 700;
        color: T.fg;
        horizontal-alignment: center;
        opacity: root.rest;
    }
    // The stage, centred between the title and the bottom row.
    stage := VerticalLayout {
        // Out of the way while the keyboard is up (only the channel sheet is in use then).
        opacity: Home.kb > 0 ? 0 : 1;
        animate opacity { duration: 200ms; easing: T.out; }
        x: 20px;
        width: parent.width - 40px;
        y: Home.sat + 52px + (root.row-y - Home.sat - 52px - self.preferred-height) * 0.5;
        height: self.preferred-height;
        // The vinyl Clawd and Null (toys.slint), alive; the one the Call button asks for is lit, the other dimmed.
        pair := HorizontalLayout {
            alignment: center;
            spacing: 4px * Toys.k;
            clawd := Clawd {
                width: 230px * Toys.k;
                height: 176px * Toys.k;
                // on a stage the one not asked for is dimmed in its light (stage.rs), not see-through
                opacity: Home.caller == "claude" || Toys.stage > 0 ? 1 : 0.55;
                animate opacity { duration: 250ms; easing: T.out; }
                tapped => { Home.caller = "claude"; Toys.tapped("claude"); }
            }
            null := Null {
                width: 96px * Toys.k;
                height: 172px * Toys.k;
                opacity: Home.caller == "codex" || Toys.stage > 0 ? 1 : 0.55;
                animate opacity { duration: 250ms; easing: T.out; }
                tapped => { Home.caller = "codex"; Toys.tapped("codex"); }
            }
        }
        Rectangle { height: root.under; }
        // The mode, in words: it changes as Null's face rolls.
        SwapText {
            height: 34px;
            text: Home.current.title;
            font-size: 24px;
            weight: 600;
            color: T.fg;
            align: center;
        }
        // Setup, while unfinished: one quiet line (and the first row of the ••• sheet).
        if !Home.ready: Rectangle {
            height: 30px;
            // out of the way of an open sheet, which would cut it off
            opacity: Home.more || Home.widgets || Home.channel ? 0 : root.rest;
            animate opacity { duration: 200ms; easing: T.out; }
            Text {
                text: "Finish setting up";
                font-size: 14px;
                font-weight: 600;
                color: #e8a33d;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { Home.set-up(); } }
        }
    }
    // The one-time hint by Null's feet: his face rolls up or down.
    Icon {
        d: Icons.updown;
        width: 18px;
        height: 18px;
        x: stage.x + pair.x + null.x + (null.width - self.width) / 2;
        y: stage.y + pair.y + null.y + null.height + 4px + (Home.hint ? 3px * Math.sin(animation-tick() / 1400ms * 360deg) : 0px);
        stroke: T.fg2;
        stroke-width: 1.8px;
        opacity: Home.hint && Home.shown < 0 ? 0.8 : 0;
        animate opacity { duration: 600ms; easing: T.out; }
    }

    // The bottom row: Chats, Call, •••.
    Rectangle {
        x: 24px;
        y: root.row-y;
        width: parent.width - 48px;
        height: 56px;
        opacity: root.rest;
        RoundIcon {
            x: 0;
            y: 2px;
            icon: Icons.chat;
            dot: Chats.unread;
            clicked => { Home.widgets = false; Home.channel = false; Home.more = false; Home.editing(false); Chats.open = true; }
        }
        // Asks Claude (or Codex, if Null is picked) to call you; it rings within a minute or so.
        Rectangle {
            x: (parent.width - self.width) / 2;
            width: min(208px, parent.width - 2 * 52px - 24px);
            border-radius: self.height / 2;
            background: Home.requested ? T.btn : call.pressed ? #c4664a : T.accent;
            animate background { duration: 250ms; easing: T.out; }
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: call.pressed && !Home.requested ? 0.96 : 1;
            animate transform-scale { duration: 160ms; easing: T.out; }
            SwapText {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: Home.requested ? "Calling you…" : Home.caller == "codex" ? "Call Codex" : "Call Claude";
                font-size: 16px;
                weight: 600;
                color: Home.requested ? T.fg2 : #ffffff;
                align: center;
            }
            call := TouchArea { clicked => { if (!Home.requested) { Home.call(Home.caller); } } }
        }
        RoundIcon {
            x: parent.width - self.width;
            y: 2px;
            icon: Icons.more;
            dot: !Home.ready;
            dot-color: #e8a33d;
            clicked => { Home.widgets = false; Home.channel = false; Home.editing(false); Home.more = !Home.more; }
        }
    }

    // Back closes what is open (the new-chat picker, a chat, the Chats screen, a sheet); otherwise it is left
    // unhandled and leaves the app.
    forward-focus: keys;
    // Leaving a chat, or putting the keyboard away in one, hands focus back here: with nothing focused, Back went
    // straight past the Chats screen and left the app, and the field kept its cursor handle on screen.
    property <string> chat-now: Chats.current;
    changed chat-now => { if (chat-now == "") { keys.focus(); } }
    property <length> kb-now: Home.kb;
    changed kb-now => { if (kb-now == 0 && Chats.current != "") { keys.focus(); } }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Back && Chats.back()) {
                return accept;
            }
            if (e.text == Key.Back && (Home.widgets || Home.channel || Home.more)) {
                Home.more = false;
                Home.widgets = false;
                Home.channel = false;
                Home.editing(false);
                return accept;
            }
            reject
        }
    }

    // A tap outside an open sheet closes it.
    if Home.widgets || Home.channel || Home.more: TouchArea {
        clicked => { Home.more = false; Home.widgets = false; Home.channel = false; Home.editing(false); }
    }

    // The ••• sheet: setup (while unfinished), Test ring and Widget.
    Morph {
        open: Home.more;
        panel: #1c1d21;
        fx: root.more-x;
        fy: root.row-y + 2px;
        fsize: 52px;
        tx: root.sheet-x;
        tw: root.sheet-w;
        th: Home.ready ? 170px : 244px;
        ty: root.sheet-bottom - self.th;
        face: Icons.more;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            if !Home.ready: Choice { icon: Icons.alert; tint: #e8a33d; title: "Finish setting up"; desc: Home.missing; clicked => { Home.more = false; Home.set-up(); } }
            Choice { icon: Icons.bell; title: "Test ring"; desc: "Rings like a real call, to check the sound."; clicked => { Home.more = false; Home.test-ring(); } }
            Choice { icon: Icons.grid; title: "Widget"; desc: "The mode on your home screen, and the channel."; clicked => { Home.more = false; Home.widgets = true; } }
        }
    }

    Morph {
        open: Home.widgets;
        panel: #1c1d21;
        fx: root.more-x;
        fy: root.row-y + 2px;
        fsize: 52px;
        tx: root.sheet-x;
        tw: root.sheet-w;
        th: Home.can-pin ? 244px : 96px; // three (or one) rows
        ty: root.sheet-bottom - self.th; // over the bottom row
        face: Icons.grid;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            if Home.can-pin: Choice { icon: Icons.grid; title: "Small"; desc: "The mode, one tap to change it."; clicked => { Home.pin(false); Home.widgets = false; } }
            if Home.can-pin: Choice { icon: Icons.wide; title: "Wide"; desc: "All four modes side by side."; clicked => { Home.pin(true); Home.widgets = false; } }
            Choice {
                icon: Icons.hash;
                title: "Private channel";
                desc: "The ntfy topic the phone and PC share.";
                clicked => { root.draft = Home.topic; Home.widgets = false; Home.channel = true; Home.editing(true); }
            }
        }
    }

    Morph {
        open: Home.channel;
        panel: #1c1d21;
        fx: root.more-x; // opened from the Widget sheet
        fy: root.row-y + 2px;
        fsize: 52px;
        tx: root.sheet-x;
        tw: root.sheet-w;
        th: 196px;
        // Over the bottom row; above the keyboard while typing.
        ty: min(root.sheet-bottom - self.th, root.height - Home.kb - self.th - 12px);
        face: Icons.hash;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: "Private channel"; font-size: 17px; font-weight: 700; color: T.fg; height: 24px; vertical-alignment: center; }
            Text { text: "The same as \"topic\" in the PC's config.json."; font-size: 13px; color: T.muted; }
            Rectangle {
                height: 52px;
                border-radius: 14px;
                background: #26282d;
                // The field only exists while the sheet is open, so nothing can focus it (and bring up the keyboard)
                // while it's closed; a plain copy of the text shows as the sheet folds away.
                if Home.channel: TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    text <=> root.draft;
                    font-size: 15px;
                    color: T.fg;
                    single-line: true;
                    vertical-alignment: center;
                }
                if !Home.channel: Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.draft;
                    font-size: 15px;
                    color: T.fg;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                height: 44px;
                Rectangle {
                    width: 96px;
                    border-radius: 22px;
                    background: save.pressed ? #c4664a : T.accent;
                    opacity: root.draft != "" && root.draft != Home.topic ? 1 : 0.4;
                    Text { text: "Save"; font-size: 15px; font-weight: 600; color: white; }
                    save := TouchArea {
                        enabled: root.draft != "" && root.draft != Home.topic;
                        clicked => {
                            Home.save-topic(root.draft);
                            Home.channel = false;
                            Home.editing(false);
                        }
                    }
                }
            }
        }
    }

    // The Chats screen grows out of its button and fills the screen; the new-chat picker grows out of its "+".
    Morph {
        open: Chats.open;
        panel: Ink.bg;
        fx: 24px;
        fy: root.row-y + 2px;
        fsize: 52px;
        tx: 0px;
        ty: 0px;
        tw: root.width;
        th: root.height;
        radius: 0px;
        face: Icons.chat;
        if Chats.current == "": ChatList { width: root.width; height: root.height; }
        if Chats.current != "": ChatThread { width: root.width; height: root.height; }
    }

    // The list dims behind the picker; a tap there closes it.
    Rectangle {
        background: #000000;
        opacity: Chats.picker ? 0.55 : 0;
        animate opacity { duration: Chats.picker ? 300ms : Chats.current != "" ? 0ms : 220ms; easing: T.out; }
    }
    if Chats.picker: TouchArea {
        clicked => { Chats.picker = false; }
    }

    // Picking an agent opens its chat at once: the picker goes with a quick fade there, rather than shrinking back
    // into a "+" that the chat doesn't have.
    Rectangle {
        opacity: Chats.current == "" ? 1 : 0;
        animate opacity { duration: Chats.current == "" ? 0ms : 140ms; }
        Morph {
            open: Chats.picker;
            panel: #1c1c20;
            fx: root.width - 52px;
            fy: Home.sat + 6px;
            fsize: 48px;
            tw: root.width - 24px;
            tx: 12px;
            th: 166px;
            ty: Home.sat + 58px;
            radius: 26px;
            face: Icons.plus;
            NewChat { width: parent.width; height: parent.height; }
        }
    }
}
