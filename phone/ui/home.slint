// The home screen ("stage"): Clawd and Null on a soft light in the middle, how agents can reach you as one sliding control,
// and round buttons along the bottom: Test ring, Widget (its sheet also holds the channel), Chats (the in-app chats
// with the agents) and Call, which asks the agent picked by tapping Clawd or Null to phone you.
import { T, Icon, Icons, Morph, Round } from "parts.slint";
import { Home, Mode, SetupCard } from "home_parts.slint";
import { Toys, Clawd, Null } from "toys.slint";
import { Chats, ChatList, ChatThread, PickRow } from "chat.slint";
import { StageBack, Look } from "stage.slint";
import { Ctl, Tuner, Amp } from "controls.slint";
import { Type, Pucks } from "controls_b.slint";

// A choice in a sheet: icon, title and a line under it.
component Choice {
    in property <string> icon;
    in property <string> title;
    in property <string> desc;
    callback clicked;
    height: 64px;
    Rectangle {
        border-radius: 18px;
        background: touch.pressed ? #34363c : #26282d;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Rectangle {
            width: 24px;
            Icon { d: root.icon; y: 20px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: T.fg; }
            Text { text: root.desc; font-size: 13px; color: T.muted; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A row of contact modes: the white highlight slides to your choice. sel = -1 when the choice is in the other row: the
// highlight shrinks away where it was, and the other row's grows in just after, so it moves from row to row.
component ModeRow inherits Rectangle {
    in property <[Mode]> modes;
    in property <int> sel;
    property <int> shown: 0;
    property <length> w: (self.width - 8px) / modes.length;
    init => { if (sel >= 0) { shown = sel; } }
    changed sel => { if (sel >= 0) { shown = sel; } }
    height: 52px;
    border-radius: 26px;
    background: #1a1b1e;
    Rectangle {
        x: 4px + root.w * root.shown;
        y: 4px;
        width: root.w;
        height: parent.height - 8px;
        animate x { duration: 500ms; easing: T.spring; }
        // 1 = shown; shrinking out is quick, growing in waits for the other row's to have shrunk.
        property <float> k: root.sel >= 0 ? 1 : 0;
        animate k { duration: root.sel >= 0 ? 260ms : 160ms; delay: root.sel >= 0 ? 120ms : 0ms; easing: root.sel >= 0 ? T.spring : T.out; }
        Rectangle {
            x: parent.width * (1 - parent.k) / 2;
            y: parent.height * (1 - parent.k) / 2;
            width: parent.width * parent.k;
            height: parent.height * parent.k;
            border-radius: self.height / 2;
            background: T.fg;
            opacity: min(1, parent.k * 3);
        }
    }
    for m[i] in root.modes: Rectangle {
        x: 4px + root.w * i;
        y: 4px;
        width: root.w;
        height: parent.height - 8px;
        property <bool> on: i == root.sel;
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Icon {
                d: m.icon;
                width: 16px;
                height: 16px;
                y: (parent.height - 16px) / 2;
                stroke: on ? #111214 : T.fg2;
                animate stroke { duration: 200ms; }
            }
            Text {
                text: m.label;
                font-size: 14px;
                font-weight: 600;
                color: on ? #111214 : T.fg2;
                vertical-alignment: center;
                animate color { duration: 200ms; }
            }
        }
        TouchArea { clicked => { Home.set-mode(m.id); } }
    }
}

export component HomeScreen inherits Window {
    background: Look.bg;
    title: "Claude Call";
    property <string> draft;
    property <length> row-y: Ctl.v > 0 ? self.height - Home.sab - Ctl.act-h : self.height - Home.sab - 24px - 88px; // the round buttons
    // PREVIEW (controls.slint): where the Widget and Chats sheets grow from, the centre of each one's button.
    property <length> widget-x: Ctl.v == 3 ? 108px + 25px : Ctl.v == 4 ? 26px + 62px + 31px : Ctl.v > 0 ? 16px + (self.width - 32px) * 1.5 / 4 : 20px + root.col-w * 1.5;
    property <length> chats-x: Ctl.v == 3 ? 176px + 21px : Ctl.v == 4 ? 26px + 124px + 31px : Ctl.v > 0 ? 16px + (self.width - 32px) * 2.5 / 4 : 20px + root.col-w * 2.5;
    property <length> sheet-bottom: Ctl.v > 0 ? self.height - Home.sab - 16px : self.row-y + 88px;
    property <length> act-y: Ctl.v == 1 ? 30px : Ctl.v == 2 ? 27px : Ctl.v == 3 ? 40px : Ctl.v == 4 ? 25px : 32px;
    property <length> col-w: (self.width - 40px) / 4;
    property <length> sheet-x: Ctl.v == 1 || Ctl.v == 4 ? 16px : 20px; // PREVIEW: as wide as the key bar or dock it covers
    property <length> sheet-w: self.width - 2 * self.sheet-x;
    // PREVIEW (stage.slint): the moon stage has its title and status at the top left; each stage leaves its own room
    // under the pair, so the status sits clear of the floor they stand on.
    property <bool> status-top: Toys.stage == 3 && Ctl.v == 0;
    property <length> top-room: root.status-top ? 104px : 52px;
    property <length> under: Toys.stage == 1 ? 112px : Toys.stage == 2 ? 74px : Toys.stage == 3 ? 104px : Toys.stage == 4 ? 84px : 28px;

    // Clawd's eyes follow a finger anywhere on the screen that nothing else takes.
    TouchArea {
        function point(down: bool) {
            Toys.point(self.mouse-x - clawd.absolute-position.x - clawd.width / 2, self.mouse-y - clawd.absolute-position.y - clawd.height * 0.4, down);
        }
        pointer-event(e) => { self.point(e.kind == PointerEventKind.down || e.kind == PointerEventKind.move); }
        moved => { self.point(true); }
    }
    StageBack {
        width: parent.width;
        height: parent.height;
        feet: stage.y + 176px * Toys.k * 0.967;
    }
    // The stage light behind Clawd and Null.
    if Toys.stage == 0: Rectangle {
        x: (parent.width - 440px) / 2;
        y: stage.y + 40px - 220px; // centred on the pair
        width: 440px;
        height: 440px;
        background: @radial-gradient(circle, #d977572e 0%, #8a5cff14 40%, #11121400 70%);
    }
    Text {
        x: root.status-top ? 24px : 0px;
        y: Home.sat + 14px;
        width: parent.width - self.x;
        text: "Claude Call";
        font-size: root.status-top ? 15px : 18px;
        font-weight: root.status-top ? 600 : 700;
        color: root.status-top ? T.fg2 : T.fg;
        horizontal-alignment: root.status-top ? left : center;
    }
    if root.status-top: Text {
        x: 24px;
        y: Home.sat + 40px;
        width: parent.width - 48px;
        text: Home.ready ? Home.current.title : "Almost ready";
        font-size: 30px;
        font-weight: 700;
        color: T.fg;
        horizontal-alignment: left;
    }
    // The stage, centred between the title and the buttons.
    stage := VerticalLayout {
        // Out of the way while the keyboard is up (only the channel sheet is in use then).
        opacity: Home.kb > 0 ? 0 : 1;
        animate opacity { duration: 200ms; easing: T.out; }
        x: 20px;
        width: parent.width - 40px;
        // PREVIEW (controls.slint): with the new controls, two thirds of the spare room goes above, so the controls sit
        // nearer the thumb
        y: Home.sat + root.top-room + (root.row-y - Home.sat - root.top-room - self.preferred-height) * (Ctl.v > 0 ? 0.66 : 0.5);
        height: self.preferred-height;
        // The vinyl Clawd and Null (toys.slint), alive; the one the Call button asks for is lit, the other dimmed.
        HorizontalLayout {
            alignment: center;
            spacing: 4px * Toys.k;
            clawd := Clawd {
                width: 230px * Toys.k;
                height: 176px * Toys.k;
                // on a stage the one not asked for is dimmed in its light (stage.rs), not see-through
                opacity: Home.caller == "claude" || Toys.stage > 0 ? 1 : 0.55;
                animate opacity { duration: 250ms; easing: T.out; }
                tapped => { Home.caller = "claude"; Toys.tapped("claude"); }
            }
            Null {
                width: 96px * Toys.k;
                height: 172px * Toys.k;
                opacity: Home.caller == "codex" || Toys.stage > 0 ? 1 : 0.55;
                animate opacity { duration: 250ms; easing: T.out; }
                tapped => { Home.caller = "codex"; Toys.tapped("codex"); }
            }
        }
        Rectangle { height: root.under; }
        // PREVIEW: the room the controls' block takes (controls.slint draws it there)
        block := Rectangle { height: Ctl.v > 0 ? Ctl.block-h : 0px; }
        if !root.status-top && Ctl.v == 0: Text {
            text: Home.ready ? Home.current.title : "Almost ready";
            font-size: 26px;
            font-weight: 700;
            color: T.fg;
            horizontal-alignment: center;
        }
        // Only the setup hint: the modes need no explaining.
        if !Home.ready && Ctl.v == 0: Rectangle { height: 8px; }
        if !Home.ready && Ctl.v == 0: Text {
            text: "A few phone settings first, then they can call.";
            font-size: 15px;
            color: T.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if !root.status-top && Ctl.v == 0: Rectangle { height: 26px; }
        // How agents can reach you, and under it the two Sleep modes.
        if Ctl.v == 0: ModeRow { modes: Home.modes; sel: Home.index < 4 ? Home.index : -1; }
        if Ctl.v == 0: Rectangle { height: 10px; }
        if Ctl.v == 0: ModeRow { modes: Home.sleep-modes; sel: Home.index >= 4 ? Home.index - 4 : -1; }
        if !Home.ready && Ctl.v == 0: Rectangle { height: 20px; }
        if !Home.ready && Ctl.v == 0: SetupCard { }
    }
    if Ctl.v == 1: Tuner { width: root.width; height: root.height; block-y: stage.y + block.y; }
    if Ctl.v == 2: Amp { width: root.width; height: root.height; block-y: stage.y + block.y; }
    if Ctl.v == 3: Type { width: root.width; height: root.height; block-y: stage.y + block.y; }
    if Ctl.v == 4: Pucks { width: root.width; height: root.height; block-y: stage.y + block.y; }

    // The round buttons.
    if Ctl.v == 0: HorizontalLayout {
        x: 20px;
        y: root.row-y;
        width: parent.width - 40px;
        height: 88px;
        Round { icon: Icons.bell; label: "Test ring"; label-color: T.fg2; clicked => { Home.test-ring(); } }
        Round { icon: Icons.grid; label: "Widget"; label-color: T.fg2; pressed: Home.widgets || Home.channel; clicked => { Home.widgets = !Home.widgets && !Home.channel; Home.channel = false; Home.editing(false); } }
        Round {
            icon: Icons.chat;
            label: "Chats";
            label-color: T.fg2;
            pressed: Chats.open;
            dot: Chats.unread;
            clicked => { Home.widgets = false; Home.channel = false; Home.editing(false); Chats.open = true; }
        }
        // Asks Claude (or Codex, if Null is picked) to call you; it rings within a minute or so.
        Round {
            icon: Icons.phone;
            label: Home.requested ? "Calling you…" : Home.caller == "codex" ? "Call Codex" : "Call Claude";
            label-color: T.fg2;
            pressed: Home.requested;
            clicked => { if (!Home.requested) { Home.call(Home.caller); } }
        }
    }

    // Back closes what is open (the new-chat picker, a chat, the Chats screen, a sheet); otherwise it is left
    // unhandled and leaves the app.
    forward-focus: keys;
    // Leaving a chat, or putting the keyboard away in one, hands focus back here: with nothing focused, Back went
    // straight past the Chats screen and left the app, and the field kept its cursor handle on screen.
    property <string> chat-now: Chats.current;
    changed chat-now => { if (chat-now == "") { keys.focus(); } }
    property <length> kb-now: Home.kb;
    changed kb-now => { if (kb-now == 0 && Chats.current != "") { keys.focus(); } }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Back && Chats.back()) {
                return accept;
            }
            if (e.text == Key.Back && (Home.widgets || Home.channel)) {
                Home.widgets = false;
                Home.channel = false;
                Home.editing(false);
                return accept;
            }
            reject
        }
    }

    // A tap outside an open sheet closes it.
    if Home.widgets || Home.channel: TouchArea {
        clicked => { Home.widgets = false; Home.channel = false; Home.editing(false); }
    }

    Morph {
        open: Home.widgets;
        panel: #1c1d21;
        fx: root.widget-x - 32px;
        fy: root.row-y + root.act-y - 32px;
        tx: root.sheet-x;
        tw: root.sheet-w;
        th: Home.can-pin ? 244px : 96px; // three (or one) rows, clear of the mode control
        ty: root.sheet-bottom - self.th; // over the buttons, clear of the mode control
        face: Icons.grid;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            if Home.can-pin: Choice { icon: Icons.grid; title: "Small"; desc: "The mode, one tap to change it."; clicked => { Home.pin(false); Home.widgets = false; } }
            if Home.can-pin: Choice { icon: Icons.wide; title: "Wide"; desc: "All four modes side by side."; clicked => { Home.pin(true); Home.widgets = false; } }
            Choice {
                icon: Icons.hash;
                title: "Private channel";
                desc: "The ntfy topic the phone and PC share.";
                clicked => { root.draft = Home.topic; Home.widgets = false; Home.channel = true; Home.editing(true); }
            }
        }
    }

    Morph {
        open: Home.channel;
        panel: #1c1d21;
        fx: root.widget-x - 32px; // opened from the Widget sheet
        fy: root.row-y + root.act-y - 32px;
        tx: root.sheet-x;
        tw: root.sheet-w;
        th: 196px;
        // Over the buttons; above the keyboard while typing.
        ty: min(root.sheet-bottom - self.th, root.height - Home.kb - self.th - 12px);
        face: Icons.hash;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: "Private channel"; font-size: 17px; font-weight: 700; color: T.fg; height: 24px; vertical-alignment: center; }
            Text { text: "The same as \"topic\" in the PC's config.json."; font-size: 13px; color: T.muted; }
            Rectangle {
                height: 52px;
                border-radius: 14px;
                background: #26282d;
                // The field only exists while the sheet is open, so nothing can focus it (and bring up the keyboard)
                // while it's closed; a plain copy of the text shows as the sheet folds away.
                if Home.channel: TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    text <=> root.draft;
                    font-size: 15px;
                    color: T.fg;
                    single-line: true;
                    vertical-alignment: center;
                }
                if !Home.channel: Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.draft;
                    font-size: 15px;
                    color: T.fg;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                height: 44px;
                Rectangle {
                    width: 96px;
                    border-radius: 22px;
                    background: save.pressed ? #c4664a : T.accent;
                    opacity: root.draft != "" && root.draft != Home.topic ? 1 : 0.4;
                    Text { text: "Save"; font-size: 15px; font-weight: 600; color: white; }
                    save := TouchArea {
                        enabled: root.draft != "" && root.draft != Home.topic;
                        clicked => {
                            Home.save-topic(root.draft);
                            Home.channel = false;
                            Home.editing(false);
                        }
                    }
                }
            }
        }
    }

    // The Chats screen grows out of its button and fills the screen; the new-chat picker grows out of its "+".
    Morph {
        open: Chats.open;
        panel: #1c1d21;
        fx: root.chats-x - 32px;
        fy: root.row-y + root.act-y - 32px;
        tx: 0px;
        ty: 0px;
        tw: root.width;
        th: root.height;
        radius: 0px;
        face: Icons.chat;
        if Chats.current == "": ChatList { width: root.width; height: root.height; }
        if Chats.current != "": ChatThread { width: root.width; height: root.height; }
    }

    if Chats.picker: TouchArea {
        clicked => { Chats.picker = false; }
    }

    Morph {
        open: Chats.picker;
        panel: #26282d;
        fx: root.width - 54px;
        fy: Home.sat + 6px;
        fsize: 48px;
        tw: min(root.width - 32px, 280px);
        tx: root.width - 16px - self.tw;
        th: 272px;
        ty: Home.sat + 60px;
        face: Icons.plus;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            PickRow { title: "Agent 1 · Haiku"; clicked => { Chats.picker = false; Chats.new-chat("claude", "haiku-5.5"); Chats.want-focus = true; } }
            PickRow { title: "Agent 2 · Sonnet"; clicked => { Chats.picker = false; Chats.new-chat("claude", "sonnet-5.5"); Chats.want-focus = true; } }
            PickRow { title: "Agent 3 · Opus"; clicked => { Chats.picker = false; Chats.new-chat("claude", "opus-5.5"); Chats.want-focus = true; } }
            PickRow { title: "Codex"; clicked => { Chats.picker = false; Chats.new-chat("codex", ""); Chats.want-focus = true; } }
        }
    }
}
