// The home screen ("stage"): Clawd and Null on a soft light in the middle, how agents can reach you as one sliding control,
// and round buttons along the bottom: Test ring, Widget (its sheet also holds the channel) and Call, which asks the
// agent picked by tapping Clawd or Null to phone you.
import { T, Icon, Icons, Morph, Round } from "parts.slint";
import { Home, Clawd, Null, SetupCard } from "home_parts.slint";

// A choice in a sheet: icon, title and a line under it.
component Choice {
    in property <string> icon;
    in property <string> title;
    in property <string> desc;
    callback clicked;
    height: 64px;
    Rectangle {
        border-radius: 18px;
        background: touch.pressed ? #34363c : #26282d;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Rectangle {
            width: 24px;
            Icon { d: root.icon; y: 20px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: 16px; font-weight: 600; color: T.fg; }
            Text { text: root.desc; font-size: 13px; color: T.muted; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component HomeScreen inherits Window {
    background: T.bg;
    title: "Claude Call";
    property <bool> widgets;
    property <bool> channel;
    property <string> draft;
    property <length> row-y: self.height - Home.sab - 24px - 88px; // the round buttons
    property <length> col-w: (self.width - 40px) / 3;
    property <length> sheet-w: self.width - 40px;

    // The stage light behind Clawd and Null.
    Rectangle {
        x: (parent.width - 440px) / 2;
        y: stage.y + 40px - 220px; // centred on the pair
        width: 440px;
        height: 440px;
        background: @radial-gradient(circle, #d977572e 0%, #8a5cff14 40%, #11121400 70%);
    }
    Text {
        y: Home.sat + 14px;
        width: parent.width;
        text: "Claude Call";
        font-size: 18px;
        font-weight: 700;
        color: T.fg;
        horizontal-alignment: center;
    }

    // The stage, centred between the title and the buttons.
    stage := VerticalLayout {
        // Out of the way while the keyboard is up (only the channel sheet is in use then).
        opacity: Home.kb > 0 ? 0 : 1;
        animate opacity { duration: 200ms; easing: T.out; }
        x: 20px;
        width: parent.width - 40px;
        y: Home.sat + 52px + (root.row-y - Home.sat - 52px - self.preferred-height) / 2;
        height: self.preferred-height;
        // Whoever may call: Clawd (Claude) and Null (Codex), side by side. Tap one to pick who the Call button asks for.
        HorizontalLayout {
            alignment: center;
            spacing: 30px;
            Rectangle {
                width: 144px;
                height: 80px;
                opacity: Home.caller == "claude" ? 1 : 0.4;
                animate opacity { duration: 250ms; easing: T.out; }
                Clawd { u: 4; }
                TouchArea { clicked => { Home.caller = "claude"; } }
            }
            Rectangle {
                width: 64px;
                height: 80px;
                opacity: Home.caller == "codex" ? 1 : 0.4;
                animate opacity { duration: 250ms; easing: T.out; }
                Null { }
                TouchArea { clicked => { Home.caller = "codex"; } }
            }
        }
        Rectangle { height: 28px; }
        Text {
            text: Home.ready ? Home.modes[Home.index].title : "Almost ready";
            font-size: 26px;
            font-weight: 700;
            color: T.fg;
            horizontal-alignment: center;
        }
        Rectangle { height: 8px; }
        Text {
            text: Home.ready ? Home.modes[Home.index].desc : "A few phone settings first, then they can call.";
            font-size: 15px;
            color: T.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Rectangle { height: 26px; }
        // How agents can reach you: the white highlight slides to your choice.
        seg := Rectangle {
            height: 52px;
            border-radius: 26px;
            background: #1a1b1e;
            property <length> w: (self.width - 8px) / 4;
            Rectangle {
                x: 4px + seg.w * Home.index;
                y: 4px;
                width: seg.w;
                height: parent.height - 8px;
                border-radius: 22px;
                background: T.fg;
                animate x { duration: 500ms; easing: T.spring; }
            }
            for m[i] in Home.modes: Rectangle {
                x: 4px + seg.w * i;
                y: 4px;
                width: seg.w;
                height: parent.height - 8px;
                property <bool> on: i == Home.index;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Icon {
                        d: m.icon;
                        width: 16px;
                        height: 16px;
                        y: (parent.height - 16px) / 2;
                        stroke: on ? #111214 : T.fg2;
                        animate stroke { duration: 200ms; }
                    }
                    Text {
                        text: m.label;
                        font-size: 14px;
                        font-weight: 600;
                        color: on ? #111214 : T.fg2;
                        vertical-alignment: center;
                        animate color { duration: 200ms; }
                    }
                }
                TouchArea { clicked => { Home.set-mode(m.id); } }
            }
        }
        if !Home.ready: Rectangle { height: 20px; }
        if !Home.ready: SetupCard { }
    }

    // The round buttons.
    HorizontalLayout {
        x: 20px;
        y: root.row-y;
        width: parent.width - 40px;
        height: 88px;
        Round { icon: Icons.bell; label: "Test ring"; label-color: T.fg2; clicked => { Home.test-ring(); } }
        Round { icon: Icons.grid; label: "Widget"; label-color: T.fg2; pressed: root.widgets || root.channel; clicked => { root.widgets = !root.widgets && !root.channel; root.channel = false; Home.editing(false); } }
        // Asks Claude (or Codex, if Null is picked) to call you; it rings within a minute or so.
        Round {
            icon: Icons.phone;
            label: Home.requested ? "Calling you…" : Home.caller == "codex" ? "Call Codex" : "Call Claude";
            label-color: T.fg2;
            pressed: Home.requested;
            clicked => { if (!Home.requested) { Home.call(Home.caller); } }
        }
    }

    // A tap outside an open sheet closes it.
    if root.widgets || root.channel: TouchArea {
        clicked => { root.widgets = false; root.channel = false; Home.editing(false); }
    }

    Morph {
        open: root.widgets;
        panel: #1c1d21;
        fx: 20px + root.col-w * 1.5 - 32px;
        fy: root.row-y;
        tx: 20px;
        tw: root.sheet-w;
        th: Home.can-pin ? 244px : 96px; // three (or one) rows, clear of the mode control
        ty: root.row-y + 88px - self.th; // over the buttons, clear of the mode control
        face: Icons.grid;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            if Home.can-pin: Choice { icon: Icons.grid; title: "Small"; desc: "The mode, one tap to change it."; clicked => { Home.pin(false); root.widgets = false; } }
            if Home.can-pin: Choice { icon: Icons.wide; title: "Wide"; desc: "All four modes side by side."; clicked => { Home.pin(true); root.widgets = false; } }
            Choice {
                icon: Icons.hash;
                title: "Private channel";
                desc: "The ntfy topic the phone and PC share.";
                clicked => { root.draft = Home.topic; root.widgets = false; root.channel = true; Home.editing(true); }
            }
        }
    }

    Morph {
        open: root.channel;
        panel: #1c1d21;
        fx: 20px + root.col-w * 1.5 - 32px; // opened from the Widget sheet
        fy: root.row-y;
        tx: 20px;
        tw: root.sheet-w;
        th: 196px;
        // Over the buttons; above the keyboard while typing.
        ty: min(root.row-y + 88px - self.th, root.height - Home.kb - self.th - 12px);
        face: Icons.hash;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: "Private channel"; font-size: 17px; font-weight: 700; color: T.fg; height: 24px; vertical-alignment: center; }
            Text { text: "The same as \"topic\" in the PC's config.json."; font-size: 13px; color: T.muted; }
            Rectangle {
                height: 52px;
                border-radius: 14px;
                background: #26282d;
                // The field only exists while the sheet is open, so nothing can focus it (and bring up the keyboard)
                // while it's closed; a plain copy of the text shows as the sheet folds away.
                if root.channel: TextInput {
                    x: 14px;
                    width: parent.width - 28px;
                    text <=> root.draft;
                    font-size: 15px;
                    color: T.fg;
                    single-line: true;
                    vertical-alignment: center;
                }
                if !root.channel: Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: root.draft;
                    font-size: 15px;
                    color: T.fg;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                height: 44px;
                Rectangle {
                    width: 96px;
                    border-radius: 22px;
                    background: save.pressed ? #c4664a : T.accent;
                    opacity: root.draft != "" && root.draft != Home.topic ? 1 : 0.4;
                    Text { text: "Save"; font-size: 15px; font-weight: 600; color: white; }
                    save := TouchArea {
                        enabled: root.draft != "" && root.draft != Home.topic;
                        clicked => {
                            Home.save-topic(root.draft);
                            root.channel = false;
                            Home.editing(false);
                        }
                    }
                }
            }
        }
    }
}
