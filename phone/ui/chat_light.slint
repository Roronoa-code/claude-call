// PREVIEW (branch preview/chats) direction 4, In the light: the whole chat is the spotlight. The agent stands at the
// bottom in the middle, just above today's field, and its light rises behind the conversation, so the words are read
// in the beam that falls on it (open text, no bubbles; yours to the right in a quieter tone). While it works the
// light dims and breathes and it says so over its head; as an answer lands the light comes up. While you type it
// steps back out of the way. The list is a column of small stages, each chat's agent in its own light (lit while it
// has something new) with its last line under it.
import { T, Icon, Icons } from "parts.slint";
import { Home } from "home_parts.slint";
import { Actor } from "actor.slint";
import { Chats } from "chat.slint";
import { ChatLook, Viewer, Arrival, Back, Spot, Composer, Plus, Lines, Thinking, StopLink, TopFade, BeamFade } from "chat_kit.slint";

export component LightList inherits Rectangle {
    background: ChatLook.bg;
    property <length> ih: 222px;
    Rectangle {
        y: Home.sat;
        height: 60px;
        Back { }
        Text { x: 66px; text: "Chats"; font-size: 17px; font-weight: 700; color: T.fg; vertical-alignment: center; height: parent.height; }
        Plus { x: parent.width - 54px; y: 6px; }
    }
    if Chats.rows.length == 0: Text {
        y: Home.sat + 60px + 48px;
        width: parent.width;
        text: "No chats yet.\nTap + to start one.";
        font-size: 15px;
        color: T.muted;
        horizontal-alignment: center;
    }
    Flickable {
        y: Home.sat + 60px;
        width: parent.width;
        height: parent.height - self.y;
        content-height: Chats.rows.length * root.ih + Home.sab;
        for r[i] in Chats.rows: Rectangle {
            x: 0;
            y: i * root.ih;
            width: root.width;
            height: root.ih;
            clip: true;
            Rectangle { x: 16px; y: 6px; width: parent.width - 32px; height: parent.height - 12px; border-radius: 24px; background: #ffffff; opacity: touch.pressed ? 0.04 : 0; }
            Spot { fx: root.width / 2; fy: 120px; k: 0.32; spread: 0.95; lit: r.unread ? 1 : 0.42; }
            BeamFade { x: 0; y: 0; width: parent.width; }
            Actor { x: root.width / 2 - 70px; y: 120px - 100px; width: 140px; height: 100px; face: r.face; k: 0.32; }
            HorizontalLayout {
                y: 144px;
                height: 22px;
                alignment: center;
                spacing: 8px;
                Text { text: r.name; font-size: 16px; font-weight: 650; color: T.fg; vertical-alignment: center; }
                Text { text: r.time; font-size: 12px; color: r.unread ? ChatLook.label : T.muted; vertical-alignment: center; }
                if r.unread: Rectangle { width: 8px; Rectangle { y: 7px; height: 8px; border-radius: 4px; background: T.accent; } }
            }
            Text {
                x: 40px;
                y: 170px;
                width: root.width - 80px;
                height: 38px;
                text: r.preview;
                font-size: 13.5px;
                color: r.unread ? T.fg2 : T.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
            touch := TouchArea { clicked => { Chats.open-chat(r.id); } }
        }
    }
}

export component LightThread inherits Rectangle {
    background: ChatLook.bg;
    property <string> draft;
    property <bool> working: Chats.action == "stop";
    property <float> t: animation-tick() / 1s;
    property <float> think: root.working ? 1 : 0;
    animate think { duration: root.working ? 480ms : 320ms; easing: T.out; }
    // while you type it steps back out of the way (and while the chat is empty the big one stands in the middle)
    property <float> here: Home.kb > 0 || Chats.empty ? 0 : 1;
    animate here { duration: Home.kb > 0 || Chats.empty ? 300ms : 460ms; easing: T.out; }
    property <length> fx: self.width / 2; // the agent's feet, just over the field
    property <length> fy: composer.top - 8px;
    property <length> log-bottom: composer.top - 8px - 112px * root.here - 40px * root.think;
    arrive := Arrival { }

    // its light, rising behind the words: dims and breathes while it works, comes up as an answer lands
    Spot {
        fx: root.fx;
        fy: root.fy;
        k: 0.42;
        spread: 1.5;
        lit: root.here * min(1, 0.9 - root.think * (0.36 + (root.working ? 0.1 * Math.sin(root.t * 2.4rad) : 0)) + 0.5 * max(0, 1 - arrive.k));
    }

    composer := Composer {
        x: 16px;
        width: root.width - 32px;
        height: root.height;
        draft <=> root.draft;
        bottom: root.height - max(Home.kb, Home.sab) - 12px;
    }

    log := Flickable {
        y: Home.sat + 64px;
        width: parent.width;
        height: root.log-bottom - self.y;
        content-height: rows.preferred-height;
        property <length> bottom: Math.min(0px, self.height - rows.preferred-height);
        init => { self.content-y = self.bottom; }
        changed bottom => { self.content-y = self.bottom; }
        rows := Lines { width: parent.width; colw: root.width - 48px; arrive: arrive.k; working: root.working; }
    }
    TopFade { x: 0; y: log.y; width: root.width; }

    // while it works: it says so over its head (just over the field while it has stepped back), with Stop
    HorizontalLayout {
        y: root.fy - 112px * root.here - 38px;
        height: 34px;
        alignment: center;
        spacing: 14px;
        opacity: root.think;
        if root.think > 0.01: Thinking { vertical-alignment: center; }
        if root.working: StopLink { }
    }

    Actor {
        x: root.fx - 70px;
        y: root.fy - 130px;
        width: 140px;
        height: 130px;
        face: Chats.face;
        k: 0.42; // faces.rs SMALL_K for this direction
        live: Chats.live;
        source: Chats.face-live;
        lw: Chats.face-w;
        lh: Chats.face-h;
        th: Chats.face-th;
        opacity: root.here;
        transform-origin: { x: 70px, y: 130px };
        transform-scale: 0.85 + 0.15 * root.here;
        TouchArea { x: 25px; width: 90px; y: 30px; height: 100px; enabled: root.here > 0.5; clicked => { Chats.poke(); } }
    }

    // ---- a new chat: the agent big in the light ----
    empty := Rectangle {
        property <length> room: composer.top - 8px - Home.sat - 64px;
        property <length> efy: Home.sat + 64px + max(0px, (self.room - 260px) / 2) + 180px;
        opacity: Chats.empty ? 1 : 0;
        animate opacity { duration: 220ms; easing: T.out; }
        visible: self.opacity > 0.01;
        Spot { fx: root.width / 2; fy: empty.efy; k: 0.62; }
        Actor {
            x: root.width / 2 - 140px;
            y: empty.efy - 200px;
            width: 280px;
            height: 200px;
            face: Chats.face;
            k: 0.62;
            live: Chats.live;
            source: Chats.big-live;
            lw: Chats.big-w;
            lh: Chats.big-h;
            th: Chats.big-th;
            TouchArea { x: 60px; width: 160px; y: 60px; height: 140px; enabled: Chats.empty; clicked => { Chats.poke(); } }
        }
        Text { y: empty.efy + 44px; width: root.width; text: Chats.name; font-size: 20px; font-weight: 700; color: T.fg; horizontal-alignment: center; }
        Text { y: empty.efy + 74px; width: root.width; text: "Your message goes to the PC."; font-size: 14px; color: T.muted; horizontal-alignment: center; }
    }

    // ---- the header, over the words ----
    Rectangle {
        x: 0;
        y: 0;
        height: Home.sat + 64px;
        background: Chats.empty ? transparent : ChatLook.bg;
        Back { y: Home.sat + 8px; }
        Text { x: 60px; y: Home.sat + (Chats.title == "" ? 20px : 10px); width: root.width - 120px; height: 22px; text: Chats.name; font-size: 17px; font-weight: 700; color: T.fg; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        if Chats.title != "": Text { x: 60px; y: Home.sat + 33px; width: root.width - 120px; height: 16px; text: Chats.title; font-size: 12.5px; color: T.muted; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    if Chats.viewing: Viewer { }
}

// The new-chat picker: the four agents, two by two, each in its own light.
export component LightPick inherits Rectangle {
    background: #0b0b0d;
    border-radius: 24px;
    border-width: 1px;
    border-color: ChatLook.line;
    clip: true;
    property <length> cw: (self.width - 16px) / 2;
    for a[i] in [
        { face: "haiku", name: "Haiku", sub: "Agent 1", agent: "claude", model: "haiku-5.5" },
        { face: "sonnet", name: "Sonnet", sub: "Agent 2", agent: "claude", model: "sonnet-5.5" },
        { face: "opus", name: "Opus", sub: "Agent 3", agent: "claude", model: "opus-5.5" },
        { face: "null", name: "Codex", sub: "On the PC", agent: "codex", model: "" },
    ]: Rectangle {
        x: 8px + Math.mod(i, 2) * root.cw;
        y: 8px + floor(i / 2) * 140px;
        width: root.cw;
        height: 140px;
        clip: true;
        Rectangle { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; border-radius: 18px; background: #ffffff; opacity: pick.pressed ? 0.05 : 0; }
        Spot { fx: root.cw / 2; fy: 92px; k: 0.26; spread: 0.95; }
        BeamFade { x: 0; y: 0; width: parent.width; height: 30px; dark: #0b0b0d; }
        Actor { x: root.cw / 2 - 50px; y: 92px - 80px; width: 100px; height: 80px; face: a.face; k: a.face == "null" ? 0.23 : 0.26; }
        Text { y: 102px; width: parent.width; text: a.name; font-size: 14.5px; font-weight: 650; color: T.fg; horizontal-alignment: center; }
        Text { y: 121px; width: parent.width; text: a.sub; font-size: 11.5px; color: T.muted; horizontal-alignment: center; }
        pick := TouchArea { clicked => { Chats.picker = false; Chats.new-chat(a.agent, a.model); Chats.want-focus = true; } }
    }
}
