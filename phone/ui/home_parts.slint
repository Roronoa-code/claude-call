import { T, Icon } from "parts.slint";

export struct Mode { id: string, title: string }

export global Home {
    in property <bool> ready: true;
    in property <string> setup-text: "Finish setting up";
    in property <string> ask-chat;
    in property <string> ask-line;
    in property <string> mode: "both";
    in property <length> sat: 36px;
    in property <length> sab: 24px;
    in property <length> kb;
    in-out property <bool> typing;
    in-out property <string> caller: "claude";
    in property <bool> requested;
    in property <bool> no-answer;
    callback set-mode(string);
    callback set-up();
    callback call(string);
    callback leave();
    callback backable(bool);
    in property <int> shown: -1;
    in property <bool> hint;
    out property <[Mode]> modes: [
        { id: "call", title: "Calls only" },
        { id: "text", title: "Texts only" },
        { id: "both", title: "Calls and texts" },
        { id: "none", title: "Quiet for now" },
        { id: "wake", title: "Asleep, wake me" },
        { id: "sleep", title: "Asleep" },
    ];
    out property <int> index: mode == "call" ? 0 : mode == "text" ? 1 : mode == "both" ? 2 : mode == "none" ? 3 : mode == "wake" ? 4 : 5;
    out property <Mode> current: modes[shown >= 0 ? shown : index];
}

export component RoundIcon {
    in property <string> icon;
    in property <bool> dot;
    in property <color> dot-color: T.accent;
    callback clicked;
    width: 52px;
    height: 52px;
    Rectangle {
        border-radius: self.height / 2;
        background: touch.pressed ? #34363c : T.btn;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: touch.pressed ? 0.93 : 1;
        animate background { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        Icon { d: root.icon; }
        if root.dot: Rectangle { x: parent.width - 17px; y: 6px; width: 10px; height: 10px; border-radius: 5px; background: root.dot-color; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}
