import { T, Icon } from "parts.slint";

export struct Mode { id: string, title: string }

export global Home {
    in property <bool> desktop;
    in property <bool> ready: true;
    in property <string> setup-text: "Finish setting up";
    in property <string> ask-chat;
    in property <string> ask-line;
    in property <string> mode: "both";
    in property <length> sat: 36px;
    in property <length> sab: 24px;
    in property <length> kb;
    in-out property <bool> typing;
    in-out property <string> caller: "claude";
    in property <bool> requested;
    in property <bool> no-answer;
    callback set-mode(string);
    callback set-up();
    callback call(string);
    callback cancel-call();
    callback leave();
    callback backable(bool);
    in property <int> shown: -1;
    in property <bool> hint;
    out property <[Mode]> modes: [
        { id: "call", title: "Calls only" },
        { id: "text", title: "Texts only" },
        { id: "both", title: "Calls and texts" },
        { id: "none", title: "Quiet for now" },
        { id: "wake", title: "Asleep, wake me" },
        { id: "sleep", title: "Asleep" },
    ];
    out property <int> index: mode == "call" ? 0 : mode == "text" ? 1 : mode == "both" ? 2 : mode == "none" ? 3 : mode == "wake" ? 4 : 5;
    in property <float> drum: index;
    in property <float> spread;
}

export component Drum {
    in property <length> font-size;
    callback stepped(int);
    TouchArea {
        y: -root.radius / 2;
        height: root.height + root.radius;
        property <length> wheel;
        scroll-event(e) => {
            if (e.delta-y == 0) { return reject; }
            self.wheel = (self.wheel > 0 && e.delta-y < 0) || (self.wheel < 0 && e.delta-y > 0) ? e.delta-y : self.wheel + e.delta-y;
            if (Math.abs(self.wheel) >= 40px) {
                root.stepped(self.wheel < 0 ? 1 : -1);
                self.wheel = 0;
            }
            accept
        }
    }
    property <length> radius: 78px;
    property <length> eye: 520px;
    property <angle> pitch: 36deg;
    property <length> face: 52px;
    property <float> fade-power: 1.6;
    property <float> front-falloff: 2.2;
    property <float> back-tint: 0.3;
    for m[i] in Home.modes: Text {
        property <float> off: i - Home.drum;
        property <angle> turn: self.off * root.pitch;
        property <float> facing: max(0, Math.cos(self.turn));
        property <float> near: root.eye / (root.eye + root.radius * (1 - Math.cos(self.turn)));
        property <float> front: max(0, 1 - Math.abs(self.off) * root.front-falloff);
        visible: self.facing > 0 && (self.front > 0 || Home.spread > 0);
        y: (root.height - root.face) / 2 - root.radius * Math.sin(self.turn) * self.near;
        width: root.width;
        height: root.face;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: self.near;
        transform-scale-y: self.facing * self.near;
        text: m.title.to-uppercase();
        font-size: root.font-size;
        font-weight: 900;
        font-italic: true;
        letter-spacing: -0.01 * root.font-size;
        color: T.fg.with-alpha(Math.pow(self.facing, root.fade-power) * (self.front + (1 - self.front) * Home.spread) * (root.back-tint + (1 - root.back-tint) * self.front));
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component RoundIcon {
    in property <string> icon;
    in property <bool> dot;
    in property <color> dot-color: T.accent;
    callback clicked;
    width: 52px;
    height: 52px;
    Rectangle {
        border-radius: self.height / 2;
        background: touch.pressed ? #34363c : T.btn;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: touch.pressed ? 0.93 : 1;
        animate background { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        Icon { d: root.icon; }
        if root.dot: Rectangle { x: parent.width - 17px; y: 6px; width: 10px; height: 10px; border-radius: 5px; background: root.dot-color; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}
