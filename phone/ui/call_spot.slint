import { T, Icon, Icons, Cap } from "parts.slint";
import { Call } from "call_data.slint";
import { Actor } from "actor.slint";

export global Spot {
    out property <color> bg: #010101;
    out property <color> warm: #f3ece2;
    out property <color> cool: #d6e0f0;
    out property <color> label: #c9a58a;
    out property <color> label-cool: #9fb3cf;
    out property <color> hold: #c4b5ec;
    out property <color> red: #d9463e;
    out property <color> green: #2fa84f;
}

export component SpotBack inherits Rectangle {
    in property <length> fx;
    in property <length> fy;
    in property <float> k: 1;
    in property <float> drawn-k: 1;
    in property <image> source;
    in property <length> bw: 500px;
    in property <length> bh: 1400px;
    in property <length> above: 640px;
    property <string> phase: Call.phase;
    property <float> s: root.k / root.drawn-k;
    property <float> dim: root.phase == "ended" ? 0.94 : root.phase == "hold" ? 0.52 : root.phase == "thinking" ? 0.38
        : root.phase == "listening" || root.phase == "hearing" ? 0.14 : root.phase == "incoming" ? 0.22 : 0;
    animate dim { duration: root.phase == "ended" ? 900ms : 700ms; easing: T.close; }
    property <float> ring: root.phase == "incoming" ? Math.pow(0.5 + 0.5 * Math.cos(Math.mod(Call.t, 1.5) / 1.5 * 360deg), 3) : 0;
    background: Spot.bg;
    Image {
        source: root.source;
        x: root.fx - root.bw / 2 * root.s;
        y: root.fy - root.above * root.s;
        width: root.bw * root.s;
        height: root.bh * root.s;
        image-fit: fill;
    }
    Rectangle {
        background: black;
        opacity: Math.max(0, root.dim - 0.22 * root.ring);
    }
    property <length> pw: 400px * root.k;
    Rectangle {
        x: root.fx - root.pw / 2;
        y: root.fy + 4px * root.k - root.pw / 2;
        width: root.pw;
        height: root.pw;
        transform-origin: { x: root.pw / 2, y: root.pw / 2 };
        transform-scale-y: 0.32;
        background: @radial-gradient(circle, #ffd2a0a0 0%, #ffc88a40 38%, #ffc88a00 70%);
        opacity: root.phase == "talking" ? Math.min(1, Call.level * 1.4) * 0.55 : 0;
        animate opacity { duration: 140ms; }
    }
}

export component Words inherits Rectangle {
    in property <string> said;
    in property <string> fresh;
    in property <string> rest;
    in property <length> size: 22px;
    in property <color> ink: Spot.warm;
    in property <color> unsaid: transparent;
    in property <string> family;
    in property <TextHorizontalAlignment> align: center;
    property <float> start: -10;
    property <bool> fading;
    changed said => { self.start = Call.t; self.fading = true; }
    changed fresh => { self.start = Call.t; self.fading = true; }
    Timer { interval: 250ms; running: root.fading; triggered => { if (Call.t - root.start > 0.45) { root.fading = false; } } }
    property <float> f: root.fading ? Math.min(1, Math.max(0, (Call.t - root.start) / 0.42)) : 1;
    property <float> e: 1 - (1 - root.f) * (1 - root.f);
    height: st.preferred-height;
    st := StyledText {
        width: root.width;
        default-font-size: root.size;
        default-color: root.ink;
        default-font-family: root.family;
        horizontal-alignment: root.align;
        text: @markdown("\{root.said}<font color=\"\{root.ink.with-alpha(root.e)}\">\{root.fresh}</font><font color=\"\{root.unsaid}\">\{root.rest}</font>");
    }
}

export component SpotCap inherits Rectangle {
    in property <bool> hide;
    in property <length> s0: 23px;
    in property <length> s1: 20.5px;
    in property <length> s2: 18px;
    in property <bool> small;
    in property <color> ink: Spot.warm;
    in property <color> unsaid: transparent;
    in property <string> family;
    in property <TextHorizontalAlignment> align: center;
    in property <bool> bottom;
    in property <float> rest-opacity: 0.6;
    in property <length> rise: 6px;
    property <Cap> cap: Call.cap;
    property <Cap> a;
    property <Cap> b;
    property <int> pa: 1;
    property <int> pb: 0;
    init => { self.a = self.cap; }
    changed cap => {
        if (self.pa == 1 && self.a.key != self.cap.key) { self.b = self.cap; self.pb = 0; self.pb = 1; self.pa = 2; }
        else if (self.pb == 1 && self.b.key != self.cap.key) { self.a = self.cap; self.pa = 0; self.pa = 1; self.pb = 2; }
        else if (self.pa == 1) { self.a = self.cap; } else { self.b = self.cap; }
    }
    for slot in [0, 1]: Rectangle {
        property <Cap> c: slot == 0 ? root.a : root.b;
        property <int> p: slot == 0 ? root.pa : root.pb;
        opacity: (self.p == 1 ? 1 : 0) * (root.hide ? 0 : 1) * (self.c.tone == "rest" || self.c.tone == "dim" ? root.rest-opacity : 1);
        y: (self.p == 0 ? root.rise : self.p == 1 ? 0 : -root.rise) + (root.hide ? -root.rise : 0);
        animate opacity { duration: self.p == 0 ? 0ms : root.hide ? 220ms : self.p == 1 ? 340ms : 180ms; delay: self.p == 1 && !root.hide ? 140ms : 0ms; easing: T.out; }
        animate y { duration: self.p == 0 ? 0ms : self.p == 1 ? 420ms : 220ms; delay: self.p == 1 && !root.hide ? 140ms : 0ms; easing: T.out; }
        Words {
            y: root.bottom ? parent.height - self.height : 0;
            width: parent.width;
            said: parent.c.said;
            fresh: parent.c.fresh;
            rest: parent.c.rest;
            size: root.small || parent.c.size == 2 ? root.s2 : parent.c.size == 1 ? root.s1 : root.s0;
            ink: parent.c.tone == "hold" ? Spot.hold : root.ink;
            unsaid: root.unsaid;
            family: root.family;
            align: root.align;
        }
    }
}

export component Dots inherits Rectangle {
    in property <color> ink: Spot.label;
    in property <length> d: 3px;
    width: root.d * 3 + root.d * 2 * 1.4;
    height: root.d;
    for i in 3: Rectangle {
        x: i * root.d * 2.4;
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: root.ink;
        opacity: 0.25 + 0.75 * Math.max(0, Math.sin((Call.t * 1.6 - i * 0.22) * 360deg));
    }
}

export component Glyph inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <color> ink: #ebe5dc;
    in property <color> lit: #f2b089;
    in property <bool> show-label: true;
    in property <bool> glow;
    callback clicked;
    width: 60px;
    height: root.show-label ? 52px : 44px;
    Rectangle {
        x: (root.width - 56px) / 2;
        y: (root.show-label ? 13px : root.height / 2) - 28px;
        width: 56px;
        height: 56px;
        background: @radial-gradient(circle, #f2b08955 0%, #f2b08922 45%, #f2b08900 70%);
        opacity: root.glow && root.on ? 1 : 0;
        transform-origin: { x: 28px, y: 28px };
        transform-scale: root.glow && root.on ? 1 : 0.6;
        animate opacity { duration: 260ms; easing: T.out; }
        animate transform-scale { duration: 480ms; easing: T.spring; }
    }
    Rectangle {
        transform-origin: { x: root.width / 2, y: 13px };
        transform-scale: touch.pressed && root.enabled ? 0.86 : 1;
        animate transform-scale { duration: 160ms; easing: T.out; }
        Icon {
            d: root.icon;
            x: (root.width - 22px) / 2;
            y: root.show-label ? 2px : (root.height - 22px) / 2;
            width: 22px;
            height: 22px;
            stroke-width: 1.8px;
            stroke: root.on ? root.lit : root.ink;
            opacity: root.enabled ? (root.on ? 1 : 0.86) : 0.3;
            animate stroke { duration: 220ms; }
            animate opacity { duration: 220ms; }
        }
    }
    if root.show-label: Text {
        y: 31px;
        width: root.width;
        height: 16px;
        text: root.label;
        font-size: 11px;
        letter-spacing: 0.2px;
        color: root.on ? root.lit : root.ink.with-alpha(root.enabled ? 0.6 : 0.25);
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 220ms; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component Pill inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> fill;
    in property <color> ink: white;
    in property <bool> turn;
    in property <bool> enabled: true;
    in property <length> size: 15px;
    callback clicked;
    height: 56px;
    Rectangle {
        border-radius: root.height / 2;
        background: touch.pressed && root.enabled ? root.fill.darker(0.18) : root.fill;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: touch.pressed && root.enabled ? 0.95 : 1;
        animate background { duration: 240ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        HorizontalLayout {
            alignment: center;
            spacing: root.label == "" ? 0 : 9px;
            Icon {
                d: root.icon;
                y: (root.height - 22px) / 2;
                width: 22px;
                height: 22px;
                stroke: root.ink;
                transform-origin: { x: 11px, y: 11px };
                transform-rotation: root.turn ? 135deg : 0deg;
            }
            if root.label != "": Text {
                text: root.label;
                font-size: root.size;
                font-weight: 600;
                color: root.ink;
                vertical-alignment: center;
            }
        }
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

export component SpotCaller inherits Rectangle {
    in property <length> fx;
    in property <length> fy;
    Actor {
        x: root.fx - 150px;
        y: root.fy - 300px;
        width: 300px;
        height: 300px;
        face: Call.face;
        k: Call.face-k;
        live: Call.face-gpu;
        source: Call.face-live;
        lw: Call.face-w;
        lh: Call.face-h;
        th: Call.face-th;
        opacity: Call.face-fade;
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height;
            width: 240px * Call.face-k;
            height: 210px * Call.face-k;
            clicked => { Call.poke(); }
        }
    }
}
