import { T, Cap } from "parts.slint";
import { Call } from "call_data.slint";
import { Spot } from "call_spot.slint";

export global Rise {
    out property <duration> fade: 300ms;
    out property <duration> sharpen: 380ms;
    out property <duration> lift: 500ms;
    out property <duration> glow: 700ms;
    out property <duration> cool-after: 550ms;
    out property <duration> letter: 50ms;
    out property <duration> word-min: 160ms;
    out property <duration> leave-fade: 450ms;
    out property <duration> leave-lift: 600ms;
    out property <duration> arm: 40ms;
    out property <float> drop: 0.32;
    out property <float> shrink: 0.04;
    out property <float> drift: 0.9;
    out property <float> leave-blur: 0.57;
    out property <float> sharp-dip: 0.75;
    out property <int> copies: 8;
    out property <float> haze: 0.16;
    out property <float> spread: 0.16;
    out property <float> inner: 0.55;
    out property <float> halo: 1.7;
    out property <float> halo-alpha: 0.3;
    out property <float> line: 1.3;
    out property <int> weight: 500;
    out property <color> ink: white;
    out property <color> warm: #ffc9a6;
    out property <easing> settle: cubic-bezier(0.22, 0.9, 0.24, 1);
}

component Letter inherits Rectangle {
    in property <string> ch;
    in property <bool> on;
    in property <duration> wait;
    in property <length> em;
    in property <color> ink;
    in property <float> gone;
    width: glyph.preferred-width;
    height: glyph.preferred-height;
    property <float> o: root.on ? 1 : 0;
    animate o { duration: Rise.fade; delay: root.wait; easing: ease; }
    property <float> s: root.on ? 1 : 0;
    animate s { duration: Rise.sharpen; delay: root.wait; easing: ease; }
    property <float> k: root.on ? 1 : 0;
    animate k { duration: Rise.lift; delay: root.wait; easing: Rise.settle; }
    property <float> g: root.on ? 1 : 0;
    animate g { duration: Rise.glow; delay: root.wait; easing: ease; }
    property <float> c: root.on ? 1 : 0;
    animate c { duration: Rise.glow; delay: root.wait + Rise.cool-after; easing: ease; }
    property <float> blur: Math.max(1 - root.s, root.gone * Rise.leave-blur);
    property <float> warmth: root.g * (1 - root.c);
    property <length> dy: (1 - root.k) * Rise.drop * root.em;
    property <float> scale: 1 - Rise.shrink * (1 - root.k);
    property <length> d: Rise.halo * root.em;
    Rectangle {
        x: (root.width - root.d) / 2;
        y: (root.height - root.d) / 2 + root.dy;
        width: root.d;
        height: root.d;
        visible: root.warmth > 0.01;
        background: @radial-gradient(circle, Rise.warm.with-alpha(Rise.halo-alpha * root.warmth) 0%, Rise.warm.with-alpha(0) 70%);
    }
    for i in Rise.copies: Text {
        property <length> r: Rise.spread * root.em * root.blur * (Math.mod(i, 2) == 0 ? 1 : Rise.inner);
        x: Math.cos(i * 360deg / Rise.copies) * self.r;
        y: root.dy + Math.sin(i * 360deg / Rise.copies) * self.r;
        width: root.width;
        height: root.height;
        text: root.ch;
        font-size: root.em;
        font-weight: Rise.weight;
        color: root.ink.mix(Rise.warm, 1 - root.warmth).with-alpha(Rise.haze * root.o * root.blur);
        visible: root.o * root.blur > 0.01;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.scale;
    }
    glyph := Text {
        y: root.dy;
        width: root.width;
        height: root.height;
        text: root.ch;
        font-size: root.em;
        font-weight: Rise.weight;
        color: root.ink.with-alpha(root.o * (1 - Rise.sharp-dip * root.blur));
        visible: root.o > 0;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: root.scale;
    }
}

export component SpotCap inherits Rectangle {
    in property <bool> hide;
    in property <length> s0: 25px;
    in property <length> s2: 18px;
    in property <bool> small;
    in property <float> rest-opacity: 0.6;
    in property <length> rise: 6px;
    property <length> em: root.small ? root.s2 : root.s0;
    property <Cap> cap: Call.cap;
    property <Cap> a;
    property <Cap> b;
    property <int> pa: 1;
    property <int> pb: 0;
    property <int> la;
    property <int> lb;
    init => { self.a = self.cap; self.la = self.cap.lit; }
    changed cap => {
        if (self.pa == 1 && self.a.key != self.cap.key) { self.b = self.cap; self.lb = self.cap.rise ? 0 : self.cap.lit; self.pb = 0; self.pb = 1; self.pa = 2; }
        else if (self.pb == 1 && self.b.key != self.cap.key) { self.a = self.cap; self.la = self.cap.rise ? 0 : self.cap.lit; self.pa = 0; self.pa = 1; self.pb = 2; }
        else if (self.pa == 1) { self.a = self.cap; } else { self.b = self.cap; }
    }
    Timer {
        interval: Rise.arm;
        running: root.la != root.a.lit || root.lb != root.b.lit;
        triggered => { root.la = root.a.lit; root.lb = root.b.lit; }
    }
    one := Text { text: "xx"; font-size: root.em; font-weight: Rise.weight; visible: false; }
    two := Text { text: "x x"; font-size: root.em; font-weight: Rise.weight; visible: false; }
    for slot in [0, 1]: card := Rectangle {
        property <Cap> c: slot == 0 ? root.a : root.b;
        property <int> p: slot == 0 ? root.pa : root.pb;
        property <int> shown: slot == 0 ? root.la : root.lb;
        property <bool> rise: self.c.rise;
        property <bool> leaving: self.p == 2 && self.rise;
        property <float> gone: self.leaving ? 1 : 0;
        animate gone { duration: self.leaving ? Rise.leave-fade : 0ms; easing: ease; }
        opacity: (self.p == 1 ? 1 : 0) * (root.hide ? 0 : 1) * (self.c.tone == "rest" || self.c.tone == "dim" ? root.rest-opacity : 1);
        y: (self.p == 0 ? (self.rise ? 0 : root.rise) : self.p == 1 ? 0 : self.rise ? -Rise.drift * root.em : -root.rise) + (root.hide ? -root.rise : 0);
        animate opacity {
            duration: self.p == 0 ? 0ms : root.hide ? 220ms : self.p == 1 ? (self.rise ? Rise.leave-fade : 340ms) : self.rise ? Rise.leave-fade : 180ms;
            delay: self.p == 1 && !root.hide && !self.rise ? 140ms : 0ms;
            easing: self.rise ? ease : T.out;
        }
        animate y {
            duration: self.p == 0 ? 0ms : self.p == 1 ? 420ms : self.rise ? Rise.leave-lift : 220ms;
            delay: self.p == 1 && !root.hide && !self.rise ? 140ms : 0ms;
            easing: self.rise ? Rise.settle : T.out;
        }
        FlexboxLayout {
            width: parent.width;
            spacing-horizontal: two.preferred-width - one.preferred-width;
            spacing-vertical: Math.max(0px, Rise.line * root.em - one.preferred-height);
            cross-axis-line-alignment: start;
            cross-axis-alignment: start;
            for word[wi] in card.c.words: span := HorizontalLayout {
                property <duration> step: Math.max(Rise.word-min, word.length * Rise.letter) / Math.max(1, word.length);
                for ch[i] in word: Letter {
                    ch: ch;
                    on: wi < card.shown;
                    wait: i * span.step;
                    em: root.em;
                    ink: card.c.tone == "hold" ? Spot.hold : Rise.ink;
                    gone: card.gone;
                }
            }
        }
    }
}
