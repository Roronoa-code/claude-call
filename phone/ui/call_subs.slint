// PREVIEW (branch preview/call-screen-2) direction 1, Subtitles: a still film frame. The caller stands big in the
// middle of the spotlight; what it says runs under the pool as film subtitles, each word fading in as it is said, a
// small spaced name over them; your words take their place in cool italics while you talk. The light tells the
// state (call_spot.slint). Controls are quiet, one row: Hang up, and three bare icons beside it (Mute, Type, More)
// that make way for Answer while it rings and Done talking while you speak; More raises a row with the rest.
import { T, Icon, Icons, SwapText } from "parts.slint";
import { Call } from "call_data.slint";
import { Sheets } from "call_kit.slint";
import { Spot, SpotBack, SpotCap, Words, Dots, Glyph, Pill, SpotCaller } from "call_spot.slint";

export component SubsLook inherits Rectangle {
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> yours: (phase == "hearing" || phase == "thinking") && Call.me-text != "";
    property <length> W: root.width;
    property <length> H: root.height;
    // The reply field's top while typing (call_kit Sheets, lift 96): the scene rises so the caller and its line stay
    // in view above it.
    property <length> field-top: H - Call.kb - Math.max(12px, Call.sab + 96px - Call.kb) - Call.field-h;
    property <bool> keys: Call.typing && Call.kb > 0;
    property <length> fy0: round(H * 0.5 / 1px) * 1px;
    property <length> dy: keys ? Math.max(0px, fy0 + 40px - (field-top - 116px)) : 0px;
    property <length> fy: fy0 - dy;
    property <length> fx: W / 2;
    // the bottom row: Hang up; Mute, Type, More or Answer / Done talking; More's row rises above it
    property <length> by: H - Call.sab - 22px - 56px;
    property <length> sub-top: keys ? field-top - 112px : fy + 92px;
    property <length> sub-h: keys ? 96px : by - 62px - 14px - sub-top;

    SpotBack { width: W; height: H; fx: root.fx; fy: root.fy; k: 1.0; drawn-k: 1.0; source: @image-url("stage/spot-subs.png"); }
    SpotCaller { fx: root.fx; fy: root.fy; }

    // ---- Header: who, and the clock ----
    Text { y: Call.sat + 12px; width: W; height: 20px; text: Call.agent; font-size: 15px; font-weight: 600; color: T.fg; horizontal-alignment: center; vertical-alignment: center; }
    SwapText { x: 0; y: Call.sat + 33px; width: W; height: 18px; text: Call.time-text; key: Call.time-key; font-size: 12.5px; color: T.muted; align: center; }

    // ---- Subtitles ----
    property <string> label: Call.notice != "" ? Call.notice.to-uppercase()
        : incoming ? "INCOMING CALL" : phase == "connecting" ? "CONNECTING" : phase == "talking" ? Call.agent.to-uppercase()
        : phase == "listening" ? "YOUR TURN" : phase == "hearing" ? "YOU" : phase == "thinking" ? (Call.agent + " is thinking").to-uppercase()
        : phase == "hold" ? Call.cap.label.to-uppercase() : Call.cap.label;
    property <bool> cool-label: Call.notice == "" && (phase == "listening" || phase == "hearing");
    subs := Rectangle {
        x: 28px;
        y: root.sub-top;
        width: W - 56px;
        height: root.sub-h;
        animate y, height { duration: 300ms; easing: T.out; }
        lbl := SwapText {
            y: 0;
            width: parent.width;
            height: 16px;
            text: root.label;
            key: phase == "hold" ? "hold" : root.label;
            font-size: 11px;
            weight: 600;
            tracking: 1.6px;
            color: Call.notice != "" ? #e8a08a : phase == "hold" ? Spot.hold : root.cool-label ? Spot.label-cool : Spot.label;
            align: center;
        }
        // the dots after "CLAUDE IS THINKING", just past the label's end
        lmeasure := Text { text: root.label; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; visible: false; }
        Dots {
            x: (parent.width + lmeasure.preferred-width) / 2 + 4px;
            y: 10px;
            ink: Spot.label;
            opacity: phase == "thinking" && Call.notice == "" ? 1 : 0;
            animate opacity { duration: 300ms; }
        }
        SpotCap {
            y: 26px;
            width: parent.width;
            height: parent.height - 26px;
            hide: root.yours;
            small: root.keys;
        }
        // your words, while you talk and while it works on them
        Text {
            y: 26px;
            width: parent.width;
            height: parent.height - 26px;
            text: Call.me-text;
            wrap: word-wrap;
            font-size: root.keys ? 18px : 21px;
            font-italic: true;
            color: Spot.cool;
            horizontal-alignment: center;
            vertical-alignment: top;
            opacity: root.yours ? (phase == "thinking" ? 0.62 : 1) : 0;
            animate opacity { duration: 320ms; delay: root.yours ? 120ms : 0ms; easing: T.out; }
        }
    }

    // ---- The bare icons: Mute, Type, More; More opens Speaker, Quiet, Transcript and In 5 min in the same row ----
    // Mute, Type and More share the bottom row's right side with Answer and Done talking: only one set shows at a time.
    property <bool> more;
    property <bool> big-live: root.incoming || Call.can-finish;
    property <bool> icons: !root.incoming && !Call.can-finish && !root.ended && !root.keys;
    for i in 3: Glyph {
        x: W - 24px - 30px - (2 - i) * 66px - self.width / 2;
        y: root.by + 15px;
        icon: i == 0 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.keyboard : (root.more ? Icons.close : "M5 12h0.01 M12 12h0.01 M19 12h0.01");
        label: i == 0 ? (Call.muted ? "Unmute" : "Mute") : i == 1 ? "Type" : (root.more ? "Close" : "More");
        on: i == 0 ? Call.muted : i == 1 ? Call.typing : false;
        enabled: root.icons && self.opacity > 0.9; // live only once shown: a second tap on Answer lands on nothing
        opacity: root.icons ? 1 : 0;
        transform-origin: { x: self.width / 2, y: 13px };
        transform-scale: root.icons ? 1 : 0.8;
        animate opacity { duration: root.icons ? 260ms : 160ms; delay: root.icons ? 160ms + i * 40ms : 0ms; easing: T.out; }
        animate transform-scale { duration: root.icons ? 480ms : 200ms; delay: root.icons ? 160ms + i * 40ms : 0ms; easing: root.icons ? T.spring : T.close; }
        clicked => {
            if (i == 0) { Call.toggle-mute(); }
            else if (i == 1) { Call.typing = !Call.typing; root.more = false; }
            else { root.more = !root.more; }
        }
    }
    // More: Speaker, Quiet, Transcript and In 5 min rise in a row above, one after another
    for i in 4: Glyph {
        property <bool> shown: root.more && root.icons;
        x: 24px + (W - 48px) * (i + 0.5) / 4 - self.width / 2;
        y: root.by - 62px + (self.shown ? 0 : 14px);
        icon: i == 0 ? Icons.speaker : i == 1 ? Icons.speaker-off : i == 2 ? Icons.captions : Icons.later;
        label: i == 0 ? "Speaker" : i == 1 ? "Quiet" : i == 2 ? "Transcript" : "In 5 min";
        on: i == 0 ? Call.speaker : i == 1 ? Call.quiet : i == 2 ? Call.caps-open : false;
        enabled: self.shown;
        opacity: self.shown ? 1 : 0;
        animate y { duration: self.shown ? 520ms : 220ms; delay: self.shown ? (3 - i) * 45ms : 0ms; easing: self.shown ? T.spring : T.close; }
        animate opacity { duration: self.shown ? 280ms : 160ms; delay: self.shown ? (3 - i) * 45ms : 0ms; easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-speaker(); }
            else if (i == 1) { Call.toggle-quiet(); }
            else if (i == 2) { Call.caps-open = !Call.caps-open; root.more = false; }
            else { if (!Call.asking-back) { Call.call-back(); } }
        }
    }

    // ---- Hang up (Decline) on the left; Answer, then Done talking only while there's something to finish, on the right ----
    Pill {
        x: 24px;
        y: root.by;
        width: 56px;
        icon: Icons.phone;
        turn: true;
        fill: Spot.red;
        enabled: !root.ended && !root.keys; // hidden while typing: a tap there must not hang up
        opacity: root.ended || root.keys ? 0 : 1;
        animate opacity { duration: 260ms; easing: T.out; }
        clicked => { Call.hang-up(); }
    }
    Pill {
        x: W - 24px - self.width;
        y: root.by;
        width: 188px;
        icon: root.incoming ? Icons.phone : Icons.check;
        label: root.incoming ? "Answer" : "Done talking";
        fill: root.incoming ? Spot.green : Spot.warm;
        ink: root.incoming ? white : #1b1713;
        enabled: root.big-live && !root.ended && !root.keys;
        opacity: root.big-live && !root.ended && !root.keys ? 1 : 0;
        transform-origin: { x: self.width / 2, y: 28px };
        transform-scale: root.big-live ? 1 : 0.9;
        animate opacity { duration: root.big-live ? 260ms : 180ms; easing: T.out; }
        animate transform-scale { duration: root.big-live ? 520ms : 220ms; easing: root.big-live ? T.spring : T.close; }
        clicked => { if (root.incoming) { Call.answer(); } else { Call.done-talking(); } }
    }
    // while it rings: "Decline" under the red button, so it's never a mystery
    Text {
        x: 24px - 22px;
        y: root.by + 60px;
        width: 100px;
        height: 16px;
        text: "Decline";
        font-size: 11px;
        color: #ebe5dc99;
        horizontal-alignment: center;
        opacity: root.incoming ? 1 : 0;
        animate opacity { duration: 200ms; }
    }

    Sheets {
        width: W;
        height: H;
        caps-x: 24px + (W - 48px) * 2.5 / 4 - 22px;
        caps-y: root.by - 62px + 13px - 22px;
        type-x: W - 24px - 30px - 66px - 22px;
        type-y: root.by + 15px + 13px - 22px;
        fsize: 44px;
        keep: H - root.by + 76px - Call.sab;
        lift: 96px;
    }
    changed phase => { if (root.ended) { root.more = false; } }
}
