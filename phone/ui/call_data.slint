// The call, as Rust (screen.rs) sets it: one global, so the call screen and its preview directions (branch
// preview/call-screen, debug.callme.call) all read the same state and send the same requests.
import { Cap, Msg } from "parts.slint";

export global Call {
    in property <length> sat: 36px; // status bar and gesture bar
    in property <length> sab: 24px;
    in property <length> kb; // how far the keyboard reaches up from the bottom edge, frame by frame as it slides
    in property <string> phase: "incoming"; // incoming connecting talking listening hearing thinking hold ended
    in property <string> agent: "Claude"; // who is calling: Claude or Codex
    in property <string> time-text: "Calling you";
    in property <string> time-key: "Calling you"; // the header line animates only when this changes
    in property <bool> asking-back; // "Call back" was tapped and the PC hasn't answered yet: it takes no second tap
    in property <string> notice; // round 2: only what is out of the ordinary (a dropped line, a muted mic)
    in property <Cap> cap: { key: 0, label: "Calling now", text: "Claude would like to talk.", lit: "Claude would like to talk.", size: 0, tone: "", orb: false };
    in property <string> me-text; // your words (live, then heard); empty = dots
    // Whoever is calling, alive (caller.rs): the middle of its feet in the stage, its size, how visible it is.
    in property <string> face: "clawd";
    in property <float> face-k: 0.55;
    in property <float> face-fade;
    in property <bool> face-gpu: true; // false: the GPU can't draw it, so its still picture stands in
    in property <image> face-live;
    in property <int> face-w;
    in property <int> face-h;
    in property <int> face-th;
    in property <float> level; // whoever is talking, 0..1
    in property <float> t; // seconds, advanced by Rust only while something moves
    in property <bool> muted;
    in property <bool> speaker;
    in property <bool> quiet;
    in property <bool> closed;
    in property <[Msg]> msgs;
    in-out property <bool> caps-open;
    in-out property <bool> typing;
    in-out property <bool> more;
    in-out property <string> draft;
    in-out property <length> field-h: 64px; // the reply field's height as it grows with its lines (call_kit.slint)
    in property <bool> placed; // the real status and gesture bar sizes are known: the directions show only then
    callback answer();
    callback hang-up();
    callback toggle-mute();
    callback toggle-speaker();
    callback toggle-quiet();
    callback call-back();
    // what is typed, the keyboard's word still being put together, and where it goes (a byte offset into the text)
    callback send(string, string, int);
    callback clear-field(); // the keyboard's own copy of the text emptied too (the sent word must not come back)
    callback poke();
}
