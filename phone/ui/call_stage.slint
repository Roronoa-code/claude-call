// PREVIEW (branch preview/call-screen) direction 1, Stage: the caller stands big in the middle of the screen on the
// home screen's floating record, and the record's edge is the call's light: rings spread from it while it rings, it
// glows warm with the caller's voice and cool with yours, a light runs round it while the caller works (lilac and
// slower on hold). The words sit under the record like subtitles; the controls are the home screen's vinyl tokens
// and a floating dock (Hang up, Call back in 5 min, and the big Answer / Done talking pill).
import { T, Icon, Icons, SwapText } from "parts.slint";
import { Call } from "call_data.slint";
import { CapView, Sheets, RecordBack, Lip, Caller, Puck } from "call_kit.slint";

// The record's edge, lit: three strokes (a core and two softer halos) round the ellipse, `s` times the record's size.
component LipRing inherits Rectangle {
    in property <length> fx;
    in property <length> fy;
    in property <float> k;
    in property <float> s: 1;
    in property <color> c;
    in property <float> glow: 1;
    property <length> w: 2px * Lip.a * root.k * root.s;
    property <length> h: 2px * Lip.b * root.k * root.s;
    for p in [{ w: 14px, a: 0.08 }, { w: 6px, a: 0.22 }, { w: 1.6px, a: 0.9 }]: Path {
        x: root.fx - root.w / 2;
        y: root.fy + Lip.cy * root.k * 1px - root.h / 2;
        width: root.w;
        height: root.h;
        viewbox-width: 380.5;
        viewbox-height: 125.14;
        commands: "M 0 62.57 A 190.25 62.57 0 1 0 380.5 62.57 A 190.25 62.57 0 1 0 0 62.57 Z";
        fill: transparent;
        stroke: root.c;
        stroke-width: p.w;
        opacity: p.a * root.glow;
    }
}

export component StageLook inherits Rectangle {
    background: #0a090c;
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> thread: phase == "hearing" || phase == "thinking";
    property <bool> working: phase == "thinking" || phase == "hold";
    property <float> t: Call.t;
    property <float> k: 1.0;
    property <length> fx: root.width / 2;
    property <length> fy: Call.sat + 336px;
    property <length> dock-y: root.height - Call.sab - 12px - 70px;
    property <length> pucks-y: root.dock-y - 106px;
    property <length> cw: (root.width - 32px) / 5;
    property <color> warm: #ffb27a;
    property <color> cool: #a9c4ff;
    property <color> lilac: #c9b6ff;

    // ---- The record and its lights, under the caller ----
    RecordBack { fx: root.fx; fy: root.fy; k: root.k; drawn-k: root.k; source: @image-url("stage/record-stage.png"); }
    // Talking, your turn: the edge glows with whoever's voice
    LipRing {
        fx: root.fx;
        fy: root.fy;
        k: root.k;
        c: root.phase == "talking" ? root.warm : root.cool;
        glow: root.phase == "talking" ? 0.22 + 0.78 * Math.min(1, Call.level * 1.6)
            : root.phase == "listening" || root.phase == "hearing" ? 0.42 + 0.14 * Math.sin(root.t * 2.2rad) + 0.5 * Math.min(1, Call.me-level * 1.8)
            : 0;
        animate glow { duration: 140ms; }
    }
    // Ringing: rings spread out from the record, one per ring (caller.rs hops once every 1.5 s)
    for i in 3: LipRing {
        property <float> p: Math.mod(root.t / 1.5 + i / 3, 1);
        fx: root.fx;
        fy: root.fy;
        k: root.k;
        s: 0.55 + 0.9 * self.p;
        c: root.warm;
        glow: root.incoming ? (1 - self.p) * Math.min(1, self.p * 5) * 0.9 : 0;
        animate glow { duration: 300ms; }
    }
    // Working: a light runs round the edge with a fading tail (lilac and slower on hold)
    for i in 14: Rectangle {
        property <float> head: root.t * (root.phase == "hold" ? 0.16 : 0.42);
        property <float> turn: self.head - i * 0.011;
        property <length> d: (7px - i * 0.38px);
        x: root.fx + Lip.x(root.k, self.turn) - self.d / 2;
        y: root.fy + Lip.y(root.k, self.turn) - self.d / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: (root.phase == "hold" ? root.lilac : root.warm).with-alpha(1 - i / 14);
        drop-shadow-blur: 10px;
        drop-shadow-color: (root.phase == "hold" ? root.lilac : root.warm).with-alpha(0.8 * (1 - i / 14));
        opacity: root.working ? 1 : 0;
        animate opacity { duration: 360ms; easing: T.out; }
    }

    Caller { fx: root.fx; fy: root.fy; }

    // ---- Who and how long ----
    Text {
        y: Call.sat + 10px;
        width: root.width;
        height: 22px;
        text: Call.agent;
        font-size: 17px;
        font-weight: 700;
        color: T.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    SwapText {
        y: Call.sat + 34px;
        width: root.width;
        height: 18px;
        text: Call.time-text;
        key: Call.time-key;
        font-size: 13px;
        color: T.muted;
        align: center;
    }

    // ---- The words, like subtitles under the record ----
    CapView {
        x: 28px;
        y: root.fy + 96px;
        width: root.width - 56px;
        height: root.pucks-y - 40px - self.y;
        hide: root.thread || Call.typing; // the reply field sits here over the keyboard
        s0: 28px;
        s1: 23px;
        s2: 19px;
        small: Call.typing;
        label-size: 13px;
        gap: 10px;
    }
    // While you talk and the caller thinks: your words, then that it's thinking
    VerticalLayout {
        x: 28px;
        y: root.fy + 96px;
        width: root.width - 56px;
        alignment: start;
        spacing: 10px;
        opacity: root.thread && !Call.typing ? 1 : 0;
        animate opacity { duration: root.thread ? 320ms : 140ms; delay: root.thread ? 160ms : 0ms; easing: T.out; }
        Text { height: 19px; text: "You"; font-size: 13px; font-weight: 650; letter-spacing: 0.26px; color: root.cool; vertical-alignment: center; }
        if Call.me-text != "": Text {
            text: Call.me-text;
            wrap: word-wrap;
            font-size: Call.typing ? 19px : 23px;
            font-weight: 500;
            letter-spacing: -0.012 * 23px;
            color: T.fg;
        }
        if Call.me-text == "": HorizontalLayout {
            height: 26px;
            spacing: 7px;
            alignment: start;
            for i in 3: Rectangle {
                width: 9px;
                Rectangle {
                    y: 9px - Call.me-level * 8px * (0.6 + 0.4 * Math.sin((root.t * 8.3 + i * 1.7) * 1rad));
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: root.cool;
                    opacity: Call.me-live ? 1 : 0.35 + 0.65 * (0.5 + 0.5 * Math.cos((root.t * 5.7 - i * 0.86) * 1rad));
                }
            }
        }
        Text {
            height: 20px;
            text: Call.agent + " is thinking";
            font-size: 14px;
            font-weight: 600;
            color: root.warm;
            vertical-alignment: center;
            opacity: Call.show-pending ? 1 : 0;
            animate opacity { duration: 260ms; easing: T.out; }
        }
    }

    // ---- One status line, about the mic ----
    SwapText {
        x: 16px;
        y: root.pucks-y - 34px;
        width: root.width - 32px;
        height: 20px;
        text: Call.status;
        font-size: 14px;
        color: #c9cbd1;
        align: center;
        visible: !Call.typing;
    }

    // ---- The tokens ----
    for i in 5: Puck {
        property <float> off: (i - 2) / 2;
        x: 16px + root.cw * (i + 0.5) - self.width / 2;
        y: root.pucks-y + 10px * (1 - self.off * self.off) + (root.incoming ? 40px : 0);
        icon: i == 0 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.speaker-off : i == 2 ? Icons.speaker : i == 3 ? Icons.captions : Icons.keyboard;
        label: i == 0 ? (Call.muted ? "Unmute" : "Mute") : i == 1 ? "Quiet" : i == 2 ? "Speaker" : i == 3 ? "Captions" : "Type";
        on: i == 0 ? Call.muted : i == 1 ? Call.quiet : i == 2 ? Call.speaker : i == 3 ? Call.caps-open : Call.typing;
        enabled: !root.incoming && !root.ended && !Call.typing;
        opacity: root.incoming || root.ended || Call.typing ? 0 : 1;
        animate y { duration: root.incoming ? 300ms : 560ms; delay: root.incoming ? 0ms : i * 35ms; easing: root.incoming ? T.close : T.spring; }
        animate opacity { duration: 220ms; delay: root.incoming ? 0ms : i * 35ms; easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-mute(); }
            else if (i == 1) { Call.toggle-quiet(); }
            else if (i == 2) { Call.toggle-speaker(); }
            else if (i == 3) { Call.caps-open = !Call.caps-open; }
            else { Call.typing = !Call.typing; }
        }
    }

    // ---- The dock: Hang up (Decline), Call back in 5 min, and the big Answer / Done talking pill ----
    dock := Rectangle {
        x: 16px;
        y: root.dock-y;
        width: root.width - 32px;
        height: 70px;
        border-radius: 35px;
        background: @linear-gradient(180deg, #1b1c20 0%, #151619 100%);
        border-width: 1px;
        border-color: #ffffff10;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000090;
        opacity: root.ended ? 0 : 1;
        animate opacity { duration: 260ms; easing: T.out; }
        // Hang up / Decline
        Rectangle {
            x: 9px;
            y: 9px;
            width: 52px;
            height: 52px;
            border-radius: 26px;
            background: endTouch.pressed ? #c23a3f : #e5484d;
            transform-origin: { x: 26px, y: 26px };
            transform-scale: endTouch.pressed ? 0.93 : 1;
            animate background { duration: 200ms; easing: T.out; }
            animate transform-scale { duration: 160ms; easing: T.out; }
            Icon {
                d: Icons.phone;
                x: 15px;
                y: 15px;
                width: 22px;
                height: 22px;
                stroke: white;
                transform-origin: { x: 11px, y: 11px };
                transform-rotation: 135deg; // the handset put down
            }
            endTouch := TouchArea { enabled: !root.ended; clicked => { Call.hang-up(); } }
        }
        SwapText {
            x: 66px;
            y: 0;
            width: 64px;
            height: 70px;
            text: root.incoming ? "Decline" : "Hang up";
            font-size: 12px;
            weight: 600;
            color: T.fg2;
        }
        // Call back in 5 min (on a call only)
        later := Rectangle {
            x: 128px;
            y: 9px;
            width: 52px;
            height: 52px;
            border-radius: 26px;
            background: laterTouch.pressed ? #ffffff14 : #ffffff08;
            opacity: root.incoming ? 0 : 1;
            transform-origin: { x: 26px, y: 26px };
            transform-scale: root.incoming ? 0.6 : laterTouch.pressed ? 0.93 : 1;
            animate opacity { duration: 220ms; easing: T.out; }
            animate transform-scale { duration: 420ms; easing: T.spring; }
            Icon { d: Icons.later; x: 15px; y: 11px; width: 22px; height: 22px; stroke: T.fg2; }
            Text { y: 34px; width: parent.width; height: 12px; text: "In 5 min"; font-size: 10px; font-weight: 600; color: T.muted; horizontal-alignment: center; vertical-alignment: center; }
            laterTouch := TouchArea { enabled: !root.incoming && !root.ended; clicked => { Call.call-back(); } }
        }
        // Answer, then Done talking
        pill := Rectangle {
            property <bool> live: root.incoming || Call.can-finish;
            x: root.incoming ? 136px : 192px;
            y: 9px;
            width: parent.width - 9px - self.x;
            height: 52px;
            animate x { duration: 520ms; easing: T.spring; }
            // while it rings, the pill breathes out a ring
            if root.incoming: Rectangle {
                property <float> p: Math.mod(root.t, 1.5) / 1.5;
                x: -8px * self.p;
                y: -8px * self.p;
                width: parent.width + 16px * self.p;
                height: parent.height + 16px * self.p;
                border-radius: self.height / 2;
                background: transparent;
                border-width: 2px;
                border-color: #3ccf6a.with-alpha(0.6 * (1 - self.p));
            }
            Rectangle {
                border-radius: 26px;
                background: root.incoming ? (pillTouch.pressed ? #27924a : #2fa84f) : pill.live ? (pillTouch.pressed ? #c4664a : T.accent) : #26282d;
                transform-origin: { x: self.width / 2, y: 26px };
                transform-scale: pillTouch.pressed && pill.live ? 0.96 : 1;
                animate background { duration: 260ms; easing: T.out; }
                animate transform-scale { duration: 160ms; easing: T.out; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Rectangle {
                        width: 20px;
                        for g in [{ d: Icons.phone, show: root.incoming }, { d: Icons.check, show: !root.incoming }]: Icon {
                            d: g.d;
                            y: 16px;
                            width: 20px;
                            height: 20px;
                            stroke: pill.live ? white : #7d8088;
                            opacity: g.show ? 1 : 0;
                            transform-origin: { x: 10px, y: 10px };
                            transform-scale: g.show ? 1 : 0.6;
                            transform-rotation: g.show ? 0deg : -40deg;
                            animate opacity { duration: 180ms; }
                            animate transform-scale, transform-rotation { duration: 500ms; easing: T.spring; }
                        }
                    }
                    measure := Text { text: root.incoming ? "Answer" : "Done talking"; font-size: 15px; font-weight: 600; visible: false; width: 0; }
                    SwapText {
                        width: measure.preferred-width + 2px;
                        height: 52px;
                        text: root.incoming ? "Answer" : "Done talking";
                        font-size: 15px;
                        weight: 600;
                        color: pill.live ? white : #8c8f97;
                    }
                }
                pillTouch := TouchArea {
                    enabled: pill.live;
                    clicked => { if (root.incoming) { Call.answer(); } else { Call.done-talking(); } }
                }
            }
        }
    }

    Sheets {
        width: root.width;
        height: root.height;
        caps-x: 16px + root.cw * 3.5 - 26px;
        caps-y: root.pucks-y + 7.5px;
        type-x: 16px + root.cw * 4.5 - 26px;
        type-y: root.pucks-y;
        fsize: 52px;
        keep: root.height - root.pucks-y - Call.sab + 12px;
        lift: 100px;
    }
}
