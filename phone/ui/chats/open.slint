import { Home } from "../home_parts.slint";
import { Chats, Ink } from "../chat.slint";
import { Figure } from "still.slint";

export component Sheet inherits Rectangle {
    in property <bool> open;
    in property <length> kb;
    property <float> k;
    property <float> kx;
    property <float> ky;
    property <bool> held;
    property <bool> back;
    animate k { duration: held ? 0ms : 460ms; easing: cubic-bezier(0.22, 0.9, 0.24, 1); }
    animate kx { duration: held ? 0ms : 460ms; easing: back ? cubic-bezier(0.22, 0.9, 0.24, 1) : cubic-bezier(0.3, 0.7, 0.3, 1); }
    animate ky {
        duration: held ? 0ms : 460ms;
        easing: back ? cubic-bezier(0.22, 0.9, 0.24, 1) : open ? cubic-bezier(0.5, -0.45, 0.4, 1) : cubic-bezier(0.3, 0.6, 0.4, 1.3);
    }
    function to(v: float) {
        self.k = v;
        self.kx = v;
        self.ky = v;
    }
    init => {
        self.held = true;
        self.to(open ? 1 : 0);
        self.held = false;
    }
    changed open => {
        self.held = false;
        self.back = false;
        self.to(open ? 1 : 0);
    }
    public function pull(p: length) {
        if (!open) { return; }
        self.held = true;
        Chats.held = true;
        self.to(max(0, 1 - p / self.height));
    }
    // Back can come with no pull before it: a key, or a swipe Android gave no progress for.
    public function let-go(close: bool) {
        Chats.held = false;
        let was = self.held;
        self.held = false;
        if (close && open) {
            Chats.back();
        } else if (was) {
            self.back = true;
            self.to(1);
        }
    }
    out property <bool> shown: open || k > 0.001;
    out property <bool> full: k > 0.999 && kx > 0.999 && ky > 0.999;
    property <bool> carry: Chats.from-id != "" && Chats.fk > 0 && !Chats.readonly && !Chats.empty;
    property <bool> moving: shown && !full && carry;
    changed k => { Chats.open-k = k; }
    changed moving => { Chats.flying = self.moving; }
    visible: shown;
    property <length> tx: 4px;
    property <length> tw: 76px;
    property <length> th: 74px;
    property <length> ty: self.height - max(root.kb, Home.sab) - 10px - 84px + 2px;
    Rectangle { background: #000000; opacity: 0.45 * k; }
    Rectangle {
        y: (1 - root.k) * root.height;
        height: root.height;
        background: Ink.bg;
        border-top-left-radius: 28px * (1 - root.k);
        border-top-right-radius: 28px * (1 - root.k);
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: -6px;
        drop-shadow-color: root.k < 0.999 ? #00000099 : #00000000;
        clip: true;
        @children
    }
    if root.moving: Figure {
        x: Chats.fx + (root.tx - Chats.fx) * root.kx;
        y: Chats.fy + (root.ty - Chats.fy) * root.ky;
        width: Chats.fw + (root.tw - Chats.fw) * root.kx;
        height: Chats.fh + (root.th - Chats.fh) * root.kx;
        face: Chats.face;
        pose: Chats.waiting ? "think" : "idle";
        k: Chats.fk + (0.26 - Chats.fk) * root.kx;
    }
}
