// A chat opening out of the list and closing back into it, carried by its character: the character leaves its card
// and travels to its place by the text box while the chat comes in (and back on the way out). The chat is opaque the
// whole way; the list behind dims or steps away, so two screens never show through each other.
// PREVIEW (chats-5): three ways, picked with `adb shell setprop debug.callme.open <n>` and a restart:
//   1 Hop in: the chat rises from the bottom like a sheet; the character hops from its card to the text box.
//   2 Walk in: the chat slides in from the right over the list (which drifts left); the character walks across.
//   3 Lift: the list clears away, the card's name rises into the header, the chat settles in under it, and the
//     character hops down to the text box.
import { T } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, Ink } from "../chat.slint";
import { Figure } from "still.slint";

export component Opener inherits Rectangle {
    in property <bool> open;
    property <int> s: Chats.open-style;
    property <float> k: open ? 1 : 0;
    animate k { duration: (open ? (s == 3 ? 560ms : 480ms) : (s == 3 ? 420ms : 360ms)) * Chats.open-slow; easing: open ? T.out : T.close; }
    out property <bool> shown: open || k > 0.002;
    out property <bool> full: k > 0.999;
    // The character travels when it has a card to leave and a place to land (not a new chat or Updates).
    property <bool> carry: Chats.from-id != "" && Chats.fk > 0 && !Chats.readonly && !Chats.empty;
    property <bool> moving: shown && !full && carry;
    changed k => { Chats.open-k = k; }
    changed moving => { Chats.flying = self.moving; }
    visible: shown;
    // Where the character lands: its place by the text box (thread.slint), with no keyboard up.
    property <length> tx: 4px;
    property <length> tw: 76px;
    property <length> th: 74px;
    property <length> ty: self.height - max(Home.kb, Home.sab) - 10px - 84px + 2px;
    // The list behind dims as the chat covers it (1, 2).
    Rectangle { background: #000000; opacity: s == 3 ? 0 : 0.55 * k; }
    // The chat itself: 1 rises from the bottom, 2 slides in from the right with a soft shadow on its edge, 3 comes up
    // in place once the list has cleared.
    page := Rectangle {
        x: s == 2 ? (1 - k) * (root.width + 24px) : 0px;
        y: s == 1 ? (1 - k) * root.height : s == 3 ? (1 - k) * 28px : 0px;
        width: root.width;
        height: root.height;
        background: Ink.bg;
        opacity: s == 3 ? clamp((k - 0.4) * 2, 0, 1) : 1;
        drop-shadow-blur: s == 1 ? 0px : 24px;
        drop-shadow-color: #00000099;
        drop-shadow-offset-x: s == 2 ? -6px : 0px;
        // 1: a rounded top edge while it is on its way up
        border-top-left-radius: s == 1 ? 24px * (1 - k) : 0px;
        border-top-right-radius: s == 1 ? 24px * (1 - k) : 0px;
        clip: s == 1;
        @children
    }
    // 3: the card's name rising into the header (thread.slint hides its own until it lands).
    if s == 3 && Chats.from-id != "" && !self.full: Text {
        property <float> m: clamp(k * 1.25, 0, 1);
        property <length> fs: 13.5px + (17px - 13.5px) * m;
        property <bool> alone: Chats.title == "" && !Chats.waiting;
        text: Chats.name;
        font-size: fs;
        font-weight: 650;
        color: Ink.text;
        width: self.preferred-width;
        height: 22px;
        vertical-alignment: center;
        // from the card's name line (list.slint: card x 12 + 80, 12 down), or the top character's (156, 30 down)
        property <length> x0: Chats.from-h > 120px ? 156px : 92px;
        property <length> y0: Chats.from-y + (Chats.from-h > 120px ? 28px : 11px);
        x: x0 + ((root.width - self.preferred-width) / 2 - x0) * m;
        y: y0 + (Home.sat + (alone ? 19px : 9px) - y0) * m;
    }
    // The character on its way, as its still picture (the live one takes over once it stands in its place).
    if carry && !self.full: Figure {
        property <float> m: s == 3 ? clamp((k - 0.15) / 0.85, 0, 1) : k;
        property <length> hop: s == 2 ? 22px : 64px;
        x: Chats.fx + (root.tx - Chats.fx) * m;
        y: Chats.fy + (root.ty - Chats.fy) * m - hop * Math.sin(m * 180deg);
        width: Chats.fw + (root.tw - Chats.fw) * m;
        height: Chats.fh + (root.th - Chats.fh) * m;
        face: Chats.face;
        pose: Chats.waiting ? "think" : "idle";
        k: Chats.fk + (0.26 - Chats.fk) * m;
    }
}
