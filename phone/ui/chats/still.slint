// The cast on the Chats screens: a character's picture (sharp posed stills from art/live3d/stills4.py, or the live
// texture while it moves), framed like actor.slint, full-body.

// The posed still of `face` in `pose` (idle, think, happy).
export component Pic inherits Image {
    in property <string> face;
    in property <string> pose: "idle";
    image-fit: fill;
    source: face == "null" ? (pose == "think" ? @image-url("faces/null-think.png") : pose == "happy" ? @image-url("faces/null-happy.png") : @image-url("faces/null-idle.png"))
        : face == "haiku" ? (pose == "think" ? @image-url("faces/haiku-think.png") : pose == "happy" ? @image-url("faces/haiku-happy.png") : @image-url("faces/haiku-idle.png"))
        : face == "sonnet" ? (pose == "think" ? @image-url("faces/sonnet-think.png") : pose == "happy" ? @image-url("faces/sonnet-happy.png") : @image-url("faces/sonnet-idle.png"))
        : face == "opus" ? (pose == "think" ? @image-url("faces/opus-think.png") : pose == "happy" ? @image-url("faces/opus-happy.png") : @image-url("faces/opus-idle.png"))
        : (pose == "think" ? @image-url("faces/clawd-think.png") : pose == "happy" ? @image-url("faces/clawd-happy.png") : @image-url("faces/clawd-idle.png"));
}

// The picture at scale s (k times home size, Null's solo size already in), its top-left at (left, top): the still,
// or the live texture (lw x lh px of it) while `live`.
component Picture {
    in property <string> face;
    in property <string> pose;
    in property <float> s;
    in property <bool> live;
    in property <image> source;
    in property <int> lw;
    in property <int> lh;
    in property <int> th;
    in property <length> left;
    in property <length> top;
    property <float> fw: root.face == "null" ? 150 : 300;
    property <float> fh: (root.face == "null" ? 230 : 250) + 40;
    if !root.live: Pic {
        face: root.face;
        pose: root.pose;
        x: root.left;
        y: root.top;
        width: root.fw * root.s * 1px;
        height: root.fh * root.s * 1px;
    }
    if root.live: Image {
        source: root.source;
        source-clip-x: 0;
        source-clip-y: root.th - root.lh;
        source-clip-width: root.lw;
        source-clip-height: root.lh;
        x: root.left;
        y: root.top;
        width: root.fw * root.s * 1px;
        height: root.fh * root.s * 1px;
        image-fit: fill;
    }
}

// Full-body, the middle of its feet at the bottom middle of this element, at k times home size.
export component Figure {
    in property <string> face: "clawd";
    in property <string> pose: "idle";
    in property <float> k: 0.3;
    in property <bool> live;
    in property <image> source;
    in property <int> lw;
    in property <int> lh;
    in property <int> th;
    property <float> s: root.k * (root.face == "null" ? 1.2 : 1);
    property <float> cx: root.face == "null" ? 73 : 148;
    property <float> feet: (root.face == "null" ? 194.6 : 221.25) + 40;
    Picture {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        face: root.face;
        pose: root.pose;
        s: root.s;
        live: root.live;
        source: root.source;
        lw: root.lw;
        lh: root.lh;
        th: root.th;
        left: round((root.width / 2 - root.cx * root.s * 1px) / 1phx) * 1phx;
        top: round((root.height - root.feet * root.s * 1px) / 1phx) * 1phx;
    }
    @children
}
