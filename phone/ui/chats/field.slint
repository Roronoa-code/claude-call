import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, Ink, IconButton } from "../chat.slint";

export component Composer inherits Rectangle {
    in property <brush> fill: Ink.surface;
    in property <length> radius: 28px;
    in property <color> go-color: Ink.me;
    property <string> draft;
    property <string> chat;
    init => {
        root.chat = Chats.current;
        root.draft = Chats.draft;
    }
    changed draft => { Chats.keep-draft(root.chat, root.draft); }
    property <string> now-chat: Chats.current;
    changed now-chat => {
        if (self.now-chat != "" && self.now-chat != self.chat) {
            input.clear-focus();
            self.chat = self.now-chat;
            self.draft = Chats.draft;
        }
    }
    property <int> left: Chats.room(root.draft + input.preedit-text);
    property <bool> near: left < 200;
    property <bool> picked-media: Chats.pick == "image" || Chats.pick == "video";
    property <bool> has-pick: Chats.pick != "" && Chats.ready;
    property <bool> composing;
    property <bool> can-send: Chats.pick != "loading" && (draft != "" || composing || picked-media) && left >= 0;
    property <bool> can-stop: Chats.action == "stop" && !can-send;
    property <length> pick-h: has-pick ? (picked-media ? 76px : 48px) : 0px;
    animate pick-h { duration: 300ms; easing: T.out; }
    property <length> line: probe.preferred-height;
    property <length> pad: (56px - line) / 2;
    property <length> area: max(56px, min(input.preferred-height, 6 * line) + 2 * pad);
    animate area { duration: 300ms; easing: T.out; }
    out property <bool> focused;
    public function blur() { input.clear-focus(); }
    height: area + pick-h;
    border-radius: radius;
    background: fill;
    border-width: 1px;
    border-color: root.focused ? #ffffff24 : Ink.hair;
    animate border-color { duration: 200ms; }
    clip: true;
    if !Chats.ready: Text {
        width: parent.width;
        height: parent.height;
        text: "Chat isn't set up on the PC yet";
        font-size: 15px;
        color: Ink.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-pick: Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: root.pick-h - 6px;
        if root.picked-media: Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: Ink.raised;
            clip: true;
            Image { width: parent.width; height: parent.height; source: Chats.pick-pic; image-fit: cover; }
            if Chats.pick == "video": Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #0e0e10b3;
                Path { x: 10px; y: 7.5px; width: 8px; height: 11px; viewbox-width: 16; viewbox-height: 20; commands: "M2 1.5 L15 10 L2 18.5 Z"; fill: white; }
            }
        }
        Text {
            x: root.picked-media ? 78px : 10px;
            width: parent.width - self.x - 48px;
            height: root.picked-media ? 64px : parent.height;
            text: Chats.pick-text;
            font-size: 14px;
            color: Chats.pick == "error" ? #ec8a6f : Ink.text2;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        IconButton {
            x: parent.width - 46px;
            y: (min(parent.height, 64px) - self.height) / 2;
            icon: Icons.close;
            stroke: Ink.muted;
            label: "Remove";
            clicked => { Chats.unpick(); }
        }
    }
    probe := Text { visible: false; text: "Ag"; font-size: 16.5px; }
    HorizontalLayout {
        visible: Chats.ready;
        y: parent.height - root.area;
        height: root.area;
        padding-left: 4px;
        padding-right: 6px;
        Rectangle {
            width: 48px;
            IconButton { y: parent.height - 52px; icon: Icons.plus; stroke: Ink.text2; label: "Attach a photo or video"; clicked => { Chats.attach(); } }
        }
        FocusScope {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            Timer { interval: 220ms; running: Chats.want-focus; triggered => { Chats.want-focus = false; input.focus(); } }
            key-pressed(e) => {
                if (e.text == Key.Back && Chats.back()) { return accept; }
                reject
            }
            window := Rectangle {
                y: root.pad;
                height: parent.height - 2 * root.pad;
                clip: true;
                property <length> scroll: 0px;
                input := TextInput {
                    y: max(parent.height - self.height, min(0px, parent.scroll));
                    width: parent.width;
                    height: max(root.line, self.preferred-height);
                    enabled: Chats.ready;
                    text <=> root.draft;
                    font-size: 16.5px;
                    color: Ink.text;
                    // Slint draws the keyboard's word in progress as a selection, and Android draws the caret in this colour.
                    selection-background-color: self.preedit-text != "" ? #e3a48c00 : #e3a48c33;
                    selection-foreground-color: Ink.text;
                    single-line: false;
                    wrap: word-wrap;
                    changed preedit-text => {
                        root.composing = self.preedit-text != "";
                        if (self.preedit-text == "" && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                            self.set-selection-offsets(self.cursor-position-byte-offset, self.cursor-position-byte-offset);
                        }
                    }
                    changed text => { if (self.text == "") { self.set-selection-offsets(0, 0); } }
                    function send-all() {
                        if (root.can-send && Chats.send-composed(root.draft, self.preedit-text, self.cursor-position-byte-offset)) {
                            root.draft = "";
                            Chats.clear-field();
                        }
                    }
                    changed has-focus => { Home.typing = self.has-focus; root.focused = self.has-focus; }
                    cursor-position-changed(at) => {
                        if (at.y + window.scroll < 0px) {
                            window.scroll = -at.y;
                        } else if (at.y + root.line + window.scroll > window.height) {
                            window.scroll = window.height - root.line - at.y;
                        }
                    }
                }
                Text {
                    visible: root.draft == "" && input.preedit-text == "";
                    x: 2px;
                    text: Chats.hint;
                    font-size: 16.5px;
                    color: #6f7178;
                    width: parent.width - self.x;
                    height: root.line;
                    y: parent.height - self.height;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            width: 48px;
            if root.near: Text {
                y: parent.height - 52px - self.height - 2px;
                width: parent.width;
                text: root.left >= 0 ? root.left + "\nleft" : (-root.left) + "\nover";
                font-size: 11.5px;
                font-weight: root.left >= 0 ? 400 : 600;
                color: root.left >= 0 ? Ink.muted : #ec8a6f;
                horizontal-alignment: center;
            }
            Rectangle {
                x: 2px;
                y: parent.height - 50px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.can-stop ? Ink.text : root.can-send ? root.go-color : Ink.raised;
                animate background { duration: 220ms; easing: T.out; }
                transform-origin: { x: 22px, y: 22px };
                transform-scale: go.pressed ? 0.9 : 1;
                animate transform-scale { duration: 140ms; easing: T.out; }
                Icon {
                    d: "M12 19V5.5 M6 11l6 -6l6 6";
                    x: 10px;
                    y: 10px;
                    width: 24px;
                    height: 24px;
                    stroke: root.can-send ? #fff8f5 : #6f7178;
                    stroke-width: 2.2px;
                    opacity: root.can-stop ? 0 : 1;
                    animate opacity { duration: 180ms; }
                }
                Rectangle {
                    width: 13px;
                    height: 13px;
                    border-radius: 3px;
                    background: Ink.bg;
                    opacity: root.can-stop ? 1 : 0;
                    animate opacity { duration: 180ms; }
                }
            }
            go := TouchArea {
                y: parent.height - 52px;
                height: 48px;
                enabled: root.can-send || root.can-stop;
                accessible-role: button;
                accessible-label: root.can-stop ? "Stop" : "Send";
                clicked => {
                    if (root.can-stop) { Chats.stop(); } else { input.send-all(); }
                }
            }
        }
    }
}
