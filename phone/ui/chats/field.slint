import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, Ink, IconButton } from "../chat.slint";

export component Composer inherits Rectangle {
    in property <brush> fill: Ink.surface;
    in property <length> radius: 28px;
    in property <color> go-color: Ink.me;
    property <string> draft;
    property <string> chat;
    init => {
        root.chat = Chats.current;
        root.draft = Chats.draft;
    }
    changed draft => { Chats.keep-draft(root.chat, root.draft); }
    property <string> now-chat: Chats.current;
    changed now-chat => {
        root.ghost-at = 0;
        root.filled = false;
        if (self.now-chat != "" && self.now-chat != self.chat) {
            input.clear-focus();
            self.chat = self.now-chat;
            self.draft = Chats.draft;
        }
    }
    property <int> left: Chats.room(root.draft + input.preedit-text);
    property <bool> near: left < 200;
    property <bool> picked-media: Chats.pick == "image" || Chats.pick == "video";
    property <bool> has-pick: Chats.pick != "" && Chats.ready;
    property <bool> composing;
    property <color> ghost-ink: #6e6c76;
    property <color> fill-warm: #ffb489;
    property <color> fill-glow: #ff9d6a88;
    property <length> swipe-past: 28px;
    property <length> slide: 18px;
    property <length> haze-most: 3px;
    property <duration> letter-gap: 22ms;
    property <duration> letter-fill: 550ms;
    property <duration> two-frames: 34ms;
    property <float> half-warm: 1.1;
    property <float> warm-from: 3.2;
    property <float> warm-to: 8.7;
    property <float> half-white: 10.9;
    property <float> white-from: 14.8;
    out property <int> ghost-at;
    property <int> ghost-go: 1;
    property <int> ghost-step;
    property <bool> filled;
    property <bool> filling;
    property <duration> fill-t;
    property <bool> swiped;
    property <bool> blank: draft == "" && input.preedit-text == "";
    changed blank => { if (!self.blank) { self.filled = false; } }
    property <bool> ghost-on: Chats.ready && Chats.pick == "" && Chats.ghosts.length > 0 && blank;
    property <bool> chosen: ghost-on && filled;
    out property <bool> offering: ghost-on && !chosen;
    property <string> ghost: Chats.ghosts[ghost-at];
    property <length> ghost-x: ghost-step == 1 ? -slide * ghost-go : ghost-step == 2 ? slide * ghost-go : 0px;
    animate ghost-x { duration: ghost-step == 2 ? 0ms : 320ms; easing: cubic-bezier(0.22, 0.9, 0.24, 1); }
    property <float> ghost-seen: ghost-step == 0 ? 1 : 0;
    animate ghost-seen { duration: ghost-step == 2 ? 0ms : 220ms; easing: ease; }
    property <color> warm-white: fill-warm.mix(#fff, 0.5);
    property <color> grey-warm: ghost-ink.mix(fill-warm, 0.5);
    property <float> front: filling ? (animation-tick() - fill-t) / letter-gap : 0;
    property <length> per: ghost-text.preferred-width / max(1, ghost.character-count);
    pure function stop(behind: float) -> float {
        return clamp((root.front - behind) * root.per / max(1px, ghost-text.width), 0, 1);
    }
    function cycle(dir: int) {
        if (root.offering && root.ghost-step == 0 && Chats.ghosts.length > 1) {
            root.ghost-go = dir;
            root.ghost-step = 1;
        }
    }
    function accept-ghost() {
        root.filled = true;
        root.fill-t = animation-tick();
        root.filling = true;
    }
    Timer {
        interval: 170ms;
        running: root.ghost-step == 1;
        triggered => {
            root.ghost-at = Math.mod(root.ghost-at + root.ghost-go + Chats.ghosts.length, Chats.ghosts.length);
            root.ghost-step = 2;
        }
    }
    Timer { interval: root.two-frames; running: root.ghost-step == 2; triggered => { root.ghost-step = 0; } }
    Timer {
        interval: root.letter-fill + root.letter-gap * max(0, root.ghost.character-count - 1);
        running: root.filling;
        triggered => { root.filling = false; }
    }
    property <bool> can-send: Chats.pick != "loading" && (draft != "" || composing || picked-media || chosen) && left >= 0;
    property <bool> can-stop: Chats.action == "stop" && !can-send;
    property <length> pick-h: has-pick ? (picked-media ? 76px : 48px) : 0px;
    animate pick-h { duration: 300ms; easing: T.out; }
    property <length> line: probe.preferred-height;
    property <length> pad: (56px - line) / 2;
    property <length> area: max(56px, min(input.preferred-height, 6 * line) + 2 * pad);
    animate area { duration: 300ms; easing: T.out; }
    out property <bool> focused;
    public function blur() { input.clear-focus(); }
    height: area + pick-h;
    border-radius: radius;
    background: fill;
    border-width: 1px;
    border-color: root.focused ? #ffffff24 : Ink.hair;
    animate border-color { duration: 200ms; }
    clip: true;
    if !Chats.ready: Text {
        width: parent.width;
        height: parent.height;
        text: "Chat isn't set up on the PC yet";
        font-size: 15px;
        color: Ink.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-pick: Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: root.pick-h - 6px;
        if root.picked-media: Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: Ink.raised;
            clip: true;
            Image { width: parent.width; height: parent.height; source: Chats.pick-pic; image-fit: cover; }
            if Chats.pick == "video": Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #0e0e10b3;
                Path { x: 10px; y: 7.5px; width: 8px; height: 11px; viewbox-width: 16; viewbox-height: 20; commands: "M2 1.5 L15 10 L2 18.5 Z"; fill: white; }
            }
        }
        Text {
            x: root.picked-media ? 78px : 10px;
            width: parent.width - self.x - 48px;
            height: root.picked-media ? 64px : parent.height;
            text: Chats.pick-text;
            font-size: 14px;
            color: Chats.pick == "error" ? #ec8a6f : Ink.text2;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        IconButton {
            x: parent.width - 46px;
            y: (min(parent.height, 64px) - self.height) / 2;
            icon: Icons.close;
            stroke: Ink.muted;
            label: "Remove";
            clicked => { Chats.unpick(); }
        }
    }
    probe := Text { visible: false; text: "Ag"; font-size: 16.5px; }
    HorizontalLayout {
        visible: Chats.ready;
        y: parent.height - root.area;
        height: root.area;
        padding-left: 4px;
        padding-right: 6px;
        Rectangle {
            width: 48px;
            IconButton { y: parent.height - 52px; icon: Icons.plus; stroke: Ink.text2; label: "Attach a photo or video"; clicked => { Chats.attach(); } }
        }
        FocusScope {
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            Timer { interval: 220ms; running: Chats.want-focus; triggered => { Chats.want-focus = false; input.focus(); } }
            key-pressed(e) => {
                if (e.text == Key.Back && Chats.back()) { return accept; }
                reject
            }
            capture-key-pressed(e) => {
                if (Home.desktop && e.text == Key.Return && !e.modifiers.shift && input.preedit-text == "") {
                    input.send-all();
                    return accept;
                }
                reject
            }
            window := Rectangle {
                y: root.pad;
                height: parent.height - 2 * root.pad;
                clip: true;
                property <length> scroll: 0px;
                input := TextInput {
                    y: max(parent.height - self.height, min(0px, parent.scroll));
                    width: parent.width;
                    height: max(root.line, self.preferred-height);
                    enabled: Chats.ready;
                    text <=> root.draft;
                    font-size: 16.5px;
                    color: Ink.text;
                    // Slint draws the keyboard's word in progress as a selection, and Android draws the caret in this colour.
                    selection-background-color: self.preedit-text != "" ? #e3a48c00 : #e3a48c33;
                    selection-foreground-color: Ink.text;
                    single-line: false;
                    wrap: word-wrap;
                    changed preedit-text => {
                        root.composing = self.preedit-text != "";
                        if (self.preedit-text == "" && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                            self.set-selection-offsets(self.cursor-position-byte-offset, self.cursor-position-byte-offset);
                        }
                    }
                    changed text => { if (self.text == "") { self.set-selection-offsets(0, 0); } }
                    function send-all() {
                        if (root.can-send && Chats.send-composed(root.draft, self.preedit-text, self.cursor-position-byte-offset)) {
                            root.draft = "";
                            Chats.clear-field();
                        }
                    }
                    changed has-focus => { Home.typing = self.has-focus; root.focused = self.has-focus; }
                    cursor-position-changed(at) => {
                        if (at.y + window.scroll < 0px) {
                            window.scroll = -at.y;
                        } else if (at.y + root.line + window.scroll > window.height) {
                            window.scroll = window.height - root.line - at.y;
                        }
                    }
                }
                Text {
                    visible: root.blank && !root.ghost-on;
                    x: 2px;
                    text: Chats.hint;
                    font-size: 16.5px;
                    color: #6f7178;
                    width: parent.width - self.x;
                    height: root.line;
                    y: parent.height - self.height;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle {
                visible: root.ghost-on;
                x: 4px + root.ghost-x;
                y: window.y + window.height - root.line;
                width: parent.width - 4px;
                height: root.line;
                opacity: root.ghost-seen;
                Rectangle {
                    visible: root.filling;
                    property <length> back-x: clamp((root.front - root.half-white) * root.per, 0px, ghost-text.width);
                    property <length> fore-x: clamp((root.front - root.half-warm) * root.per, 0px, ghost-text.width);
                    x: self.back-x;
                    y: (parent.height - self.height) / 2;
                    width: self.fore-x - self.back-x;
                    height: parent.height / 2;
                    border-radius: self.height / 2;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: root.fill-glow;
                    opacity: self.width / max(1px, (root.half-white - root.half-warm) * root.per);
                }
                for side in [-1, 1]: Text {
                    visible: root.ghost-seen < 0.99;
                    x: side * (1 - root.ghost-seen) * root.haze-most;
                    width: ghost-text.width;
                    height: parent.height;
                    text: root.ghost;
                    font-size: 16.5px;
                    color: root.ghost-ink;
                    opacity: (1 - root.ghost-seen) / 2;
                    vertical-alignment: center;
                    overflow: elide;
                }
                ghost-text := Text {
                    x: 0px;
                    width: min(self.preferred-width, parent.width - (root.chosen ? 0px : chip.width + 6px));
                    height: parent.height;
                    text: root.ghost;
                    font-size: 16.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    color: !root.filling ? (root.chosen ? #fff : root.ghost-ink) : @linear-gradient(90deg,
                        #fff root.stop(root.white-from) * 100%,
                        root.warm-white root.stop(root.half-white) * 100%,
                        root.fill-warm root.stop(root.warm-to) * 100%,
                        root.fill-warm root.stop(root.warm-from) * 100%,
                        root.grey-warm root.stop(root.half-warm) * 100%,
                        root.ghost-ink root.stop(0) * 100%);
                }
                chip := Rectangle {
                    visible: !root.chosen;
                    x: ghost-text.width + 6px;
                    y: (parent.height - self.height) / 2;
                    width: tap-word.preferred-width + 12px;
                    height: tap-word.preferred-height + 4px;
                    border-radius: 6px;
                    background: #2a2930;
                    tap-word := Text { text: "tap"; font-size: 10px; font-family: "JetBrains Mono NL"; color: #b9b7bf; }
                }
            }
            if root.offering: TouchArea {
                accessible-role: button;
                accessible-label: root.ghost;
                accessible-action-default => { root.accept-ghost(); }
                accessible-action-increment => { root.cycle(1); }
                accessible-action-decrement => { root.cycle(-1); }
                changed pressed => { if (self.pressed) { root.swiped = false; } }
                moved => {
                    if (self.pressed && !root.swiped && abs(self.mouse-x - self.pressed-x) > root.swipe-past) {
                        root.swiped = true;
                        root.cycle(self.mouse-x < self.pressed-x ? 1 : -1);
                    }
                }
                clicked => { if (!root.swiped) { root.accept-ghost(); } }
            }
        }
        Rectangle {
            width: 48px;
            if root.near: Text {
                y: parent.height - 52px - self.height - 2px;
                width: parent.width;
                text: root.left >= 0 ? root.left + "\nleft" : (-root.left) + "\nover";
                font-size: 11.5px;
                font-weight: root.left >= 0 ? 400 : 600;
                color: root.left >= 0 ? Ink.muted : #ec8a6f;
                horizontal-alignment: center;
            }
            Rectangle {
                x: 2px;
                y: parent.height - 50px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: root.can-stop ? Ink.text : root.can-send ? root.go-color : Ink.raised;
                animate background { duration: 220ms; easing: T.out; }
                transform-origin: { x: 22px, y: 22px };
                transform-scale: go.pressed ? 0.9 : 1;
                animate transform-scale { duration: 140ms; easing: T.out; }
                Icon {
                    d: "M12 19V5.5 M6 11l6 -6l6 6";
                    x: 10px;
                    y: 10px;
                    width: 24px;
                    height: 24px;
                    stroke: root.can-send ? #fff8f5 : #6f7178;
                    stroke-width: 2.2px;
                    opacity: root.can-stop ? 0 : 1;
                    animate opacity { duration: 180ms; }
                }
                Rectangle {
                    width: 13px;
                    height: 13px;
                    border-radius: 3px;
                    background: Ink.bg;
                    opacity: root.can-stop ? 1 : 0;
                    animate opacity { duration: 180ms; }
                }
            }
            go := TouchArea {
                y: parent.height - 52px;
                height: 48px;
                enabled: root.can-send || root.can-stop;
                accessible-role: button;
                accessible-label: root.can-stop ? "Stop" : "Send";
                clicked => {
                    if (root.can-stop) { Chats.stop(); } else if (root.chosen) { Chats.choose(root.ghost); } else { input.send-all(); }
                }
            }
        }
    }
}
