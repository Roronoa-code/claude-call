// A chat: the character stands beside the text box, by your thumb: it thinks while the PC works, talks as the
// answer comes in, looks at you while its question waits, hops when tapped. The agent's turns sit on soft cards;
// mine are warm bubbles. A new chat shows the character big in the middle until the first message.
import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, ChatRow, Ink, IconButton, BackButton } from "../chat.slint";
import { Figure, Floor } from "still.slint";
import { Shimmer } from "msg.slint";
import { Log } from "log.slint";
import { Composer } from "field.slint";

export component ChatThread inherits Rectangle {
    background: Ink.bg;
    property <length> bottom: self.height - max(Home.kb, Home.sab) - 10px;
    // the character's room beside the field (a new chat's stands big in the middle until the first message)
    property <length> pal: Chats.readonly || Chats.empty ? 0px : 76px;
    animate pal { duration: 320ms; easing: T.out; }
    log := Log {
        y: Home.sat + 60px;
        width: parent.width;
        height: parent.height - self.y;
        side: 14px;
        pad-bottom: Chats.readonly ? Home.sab + 28px : root.height - field.y + 18px;
        // my last message's receipt (Sending…, Sent, Delivered, Read), staying put while the PC thinks below it
        if Chats.status != "": HorizontalLayout {
            alignment: end;
            padding-top: 6px;
            Rectangle {
                width: note.preferred-width;
                height: 22px;
                note := Text {
                    text: Chats.status;
                    font-size: 13px;
                    color: Chats.action == "retry" ? #ec8a6f : Ink.muted;
                    font-weight: Chats.action == "retry" ? 600 : 400;
                    vertical-alignment: center;
                }
                TouchArea { enabled: Chats.action == "retry"; clicked => { Chats.retry(); } }
            }
        }
        if Chats.action == "stop": Rectangle {
            property <float> k: 0;
            init => { self.k = 1; }
            animate k { duration: 420ms; easing: T.out; }
            height: 46px;
            opacity: k;
            Shimmer { x: 6px; y: 22px + (1 - parent.k) * 6px; text: Chats.short + " is thinking"; font-size: 14.5px; base: #8a8c93; }
        }
    }
    // A new chat: its character big in the middle, inviting the first message.
    VerticalLayout {
        property <length> top: Home.sat + 60px;
        property <length> room: field.y - 8px - self.top;
        x: 24px;
        width: parent.width - 48px;
        y: self.top + max(0px, (self.room - self.preferred-height) / 2) - (Chats.empty ? 0px : 16px);
        height: self.preferred-height;
        alignment: start;
        spacing: 4px;
        opacity: Chats.empty ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 320ms; easing: T.out; }
        Rectangle {
            height: 170px;
            Floor { x: (parent.width - 220px) / 2; y: 130px; width: 220px; height: 52px; }
            Figure {
                x: 0;
                y: 0;
                width: parent.width;
                height: 158px;
                face: Chats.face;
                k: 0.7;
                live: Chats.live;
                source: Chats.big-live;
                lw: Chats.big-w;
                lh: Chats.big-h;
                th: Chats.big-th;
                TouchArea { enabled: Chats.empty; clicked => { Chats.poke(); } }
            }
        }
        Rectangle { height: 14px; }
        Text { text: "Say hi to " + Chats.short; font-size: 24px; font-weight: 700; color: Ink.text; horizontal-alignment: center; overflow: elide; }
        Text { text: "Your message goes to the PC."; font-size: 15px; color: Ink.muted; horizontal-alignment: center; }
    }
    // The header: back, the name (centred) and where things stand.
    Rectangle {
        y: 0;
        height: Home.sat + 60px;
        background: Ink.bg;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Ink.hair;
            opacity: log.scrolled && !Chats.empty ? 1 : 0;
            animate opacity { duration: 200ms; }
        }
        Rectangle {
            y: Home.sat;
            height: 60px;
            BackButton { }
            Text {
                property <bool> alone: Chats.title == "" && !Chats.waiting;
                x: 60px;
                y: alone ? 0px : 9px;
                width: parent.width - 120px;
                height: alone ? 60px : 22px;
                text: Chats.name;
                font-size: 17px;
                font-weight: 650;
                color: Ink.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 60px;
                y: 31px;
                width: parent.width - 120px;
                height: 18px;
                text: Chats.waiting ? "Thinking…" : Chats.title;
                font-size: 13px;
                color: Chats.waiting || Chats.ask == "waiting" ? Ink.warm : Ink.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    Rectangle {
        visible: !Chats.readonly;
        y: field.y - 30px;
        height: parent.height - self.y;
        background: @linear-gradient(180deg, #0e0e1000 0%, #0e0e10 46%);
    }
    // The character, standing by the field (it rides up with the keyboard). A tap: a hop.
    // One character at a time: in a new chat it stands big in the middle; after the first message it appears here
    // only once the big one has gone.
    if !Chats.readonly: Rectangle {
        property <bool> stand: !Chats.empty;
        opacity: stand ? 1 : 0;
        animate opacity { duration: stand ? 220ms : 0ms; delay: stand ? 320ms : 0ms; }
        visible: self.opacity > 0.01;
        x: 4px;
        y: field.y + field.height - self.height + 2px;
        width: 76px;
        height: 84px;
        Floor { x: 0; y: 58px; width: 76px; height: 26px; }
        Figure {
            x: 0;
            y: 0;
            width: parent.width;
            height: 74px;
            visible: !Chats.flying; // on its way from the list (open.slint)
            face: Chats.face;
            pose: Chats.waiting ? "think" : "idle";
            k: 0.26; // faces.rs SMALL_K
            live: Chats.live;
            source: Chats.face-live;
            lw: Chats.face-w;
            lh: Chats.face-h;
            th: Chats.face-th;
        }
        TouchArea { clicked => { Chats.poke(); } }
    }
    field := Composer {
        visible: !Chats.readonly;
        x: 8px + root.pal;
        width: parent.width - 20px - root.pal;
        y: root.bottom - self.height;
    }
    Rectangle {
        property <float> k: Chats.viewing ? 1 : 0;
        animate k { duration: Chats.viewing ? 340ms : 220ms; easing: Chats.viewing ? T.out : T.close; }
        visible: k > 0.01;
        background: black;
        opacity: k;
        TouchArea { clicked => { Chats.viewing = false; } }
        Image {
            y: Home.sat;
            width: parent.width;
            height: parent.height - Home.sat - Home.sab;
            source: Chats.full;
            image-fit: contain;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: 0.94 + 0.06 * parent.k;
        }
        Rectangle {
            x: 12px;
            y: Home.sat + 8px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: #1a1a1dcc;
            Icon { d: Icons.close; x: 10px; y: 10px; }
            TouchArea { clicked => { Chats.viewing = false; } }
        }
    }
}
