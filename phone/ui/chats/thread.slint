import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, ChatRow, Ink, IconButton, BackButton } from "../chat.slint";
import { Figure, Floor } from "still.slint";
import { Shimmer } from "msg.slint";
import { Log } from "log.slint";
import { Composer } from "field.slint";
import { PhotoView } from "photo.slint";

export component ChatThread inherits Rectangle {
    in property <length> kb;
    callback pulled(length);
    callback let-go(bool);
    background: Ink.bg;
    property <length> bottom: self.height - max(root.kb, Home.sab) - 10px;
    property <bool> bare: Chats.readonly || Chats.ended != "";
    property <bool> ended: Chats.ended != "";
    changed ended => { if (self.ended) { field.blur(); } }
    property <length> pal: bare || Chats.empty ? 0px : 76px;
    animate pal { duration: 320ms; easing: T.out; }
    property <bool> pulling;
    property <bool> keys-only;
    property <length> from-y;
    property <length> last-y;
    property <duration> last-t;
    property <float> speed;
    property <bool> past;
    property <length> shift;
    function drag(local-dy: length) {
        let dy = local-dy + root.shift;
        if (!root.pulling) {
            root.pulling = true;
            root.keys-only = root.kb > 0 || field.focused;
            root.from-y = dy; // the swipe starts only after a minimum drag
            root.last-y = dy;
            root.last-t = animation-tick();
            root.speed = 0;
            root.past = false;
            root.shift = 0;
            if (root.keys-only) { field.blur(); }
            return;
        }
        if (root.keys-only) { return; }
        let t = animation-tick();
        if (t - root.last-t >= 8ms) {
            root.speed = (dy - root.last-y) / 1px / ((t - root.last-t) / 1ms);
            root.last-y = dy;
            root.last-t = t;
        }
        let p = max(0px, dy - root.from-y);
        if (p > root.height * 0.3 && !root.past) { Chats.tick(); }
        root.past = p > root.height * 0.3;
        root.shift = p;
        root.pulled(p);
    }
    function drop(local-dy: length) {
        if (!root.pulling) { return; }
        let dy = local-dy + root.shift;
        root.pulling = false;
        if (root.keys-only) { return; }
        let p = max(0px, dy - root.from-y);
        let fresh = animation-tick() - root.last-t < 100ms;
        let v = fresh ? root.speed : 0;
        root.shift = 0;
        root.let-go(p > 0px && (v > 0.9 || (p > root.height * 0.3 && v > -0.5)));
    }
    function cancel-pull() {
        if (root.pulling) {
            root.pulling = false;
            root.shift = 0;
            if (!root.keys-only) { root.let-go(false); }
        }
    }
    pull := SwipeGestureHandler {
        handle-swipe-down: true;
        enabled: log.content-y >= -0.5px && !Chats.viewing;
        moved => { if (self.swiping) { root.drag(self.current-position.y - self.pressed-position.y); } }
        swiped => { root.drop(self.current-position.y - self.pressed-position.y); }
        cancelled => { root.cancel-pull(); }
        log := Log {
            y: Home.sat + 60px;
            width: parent.width;
            // Slint's scroll limits leave out what the keyboard covers.
            height: root.bare ? parent.height - self.y : field.y + field.height - self.y;
            side: 14px;
            pad-bottom: Chats.readonly ? Home.sab + 28px : root.ended ? parent.height - field.y + 10px : field.height + 18px;
            tapped => { field.blur(); }
            if Chats.status != "": HorizontalLayout {
                alignment: end;
                padding-top: 6px;
                Rectangle {
                    width: note.preferred-width;
                    height: 22px;
                    note := Text {
                        text: Chats.status;
                        font-size: 13px;
                        color: Chats.action == "retry" ? #ec8a6f : Ink.muted;
                        font-weight: Chats.action == "retry" ? 600 : 400;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        y: -13px;
                        height: 48px;
                        enabled: Chats.action == "retry";
                        accessible-role: button;
                        accessible-label: Chats.status;
                        clicked => { Chats.retry(""); }
                    }
                }
            }
            if Chats.waiting: Rectangle {
                property <float> k: 0;
                init => { self.k = 1; }
                animate k { duration: 420ms; easing: T.out; }
                height: 46px;
                opacity: k;
                Shimmer { x: 6px; y: 22px + (1 - parent.k) * 6px; text: Chats.thinking; font-size: 14.5px; base: #8a8c93; }
            }
        }
        VerticalLayout {
            property <length> top: Home.sat + 60px;
            property <length> room: field.y - 8px - self.top;
            x: 24px;
            width: parent.width - 48px;
        property <length> lift: Chats.empty ? 0px : 16px;
        animate lift { duration: 320ms; easing: T.out; }
        y: self.top + max(0px, (self.room - self.preferred-height) / 2) - self.lift;
            height: self.preferred-height;
            alignment: start;
            spacing: 4px;
            opacity: Chats.empty ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 320ms; easing: T.out; }
            Rectangle {
                height: 170px;
                Floor { x: (parent.width - 220px) / 2; y: 130px; width: 220px; height: 52px; }
                Figure {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 158px;
                    face: Chats.face;
                    k: 0.7;
                    live: Chats.live;
                    source: Chats.big-live;
                    lw: Chats.big-w;
                    lh: Chats.big-h;
                    th: Chats.big-th;
                    TouchArea { enabled: Chats.empty; clicked => { Chats.poke(); } }
                }
            }
            Rectangle { height: 14px; }
            Text { text: "Say hi to " + Chats.short; font-size: 24px; font-weight: 700; color: Ink.text; horizontal-alignment: center; overflow: elide; }
            Text { text: "Your message goes to the PC."; font-size: 15px; color: Ink.muted; horizontal-alignment: center; }
        }
    }
    SwipeGestureHandler {
        y: 0;
        height: Home.sat + 60px;
        handle-swipe-down: !Chats.viewing;
        moved => { if (self.swiping) { root.drag(self.current-position.y - self.pressed-position.y); } }
        swiped => { root.drop(self.current-position.y - self.pressed-position.y); }
        cancelled => { root.cancel-pull(); }
        Rectangle {
            y: 0;
            height: Home.sat + 60px;
            background: Ink.bg;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Ink.hair;
                opacity: log.scrolled && !Chats.empty ? 1 : 0;
                animate opacity { duration: 200ms; }
            }
            Rectangle {
                y: Home.sat;
                height: 60px;
                BackButton { }
                Text {
                    property <bool> alone: Chats.title == "" && Chats.think == "";
                    x: 60px;
                    y: alone ? 0px : 9px;
                    width: parent.width - 120px;
                    height: alone ? 60px : 22px;
                    text: Chats.name;
                    font-size: 17px;
                    font-weight: 650;
                    color: Ink.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: 60px;
                    y: 31px;
                    width: parent.width - 120px;
                    height: 18px;
                    text: Chats.think != "" ? Chats.think : Chats.title;
                    font-size: 13px;
                    color: Chats.waiting || Chats.ask == "waiting" ? Ink.warm : Ink.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    Rectangle {
        visible: !Chats.readonly;
        y: field.y - 30px;
        height: parent.height - self.y;
        property <float> solid: 55px / max(55px, self.height);
        background: @linear-gradient(180deg, #0e0e1000 0%, #0e0e10 solid * 100%);
    }
    if !root.bare: Rectangle {
        property <bool> stand: !Chats.empty;
        opacity: stand ? 1 : 0;
        animate opacity { duration: stand ? 220ms : 0ms; delay: stand ? 320ms : 0ms; }
        visible: self.opacity > 0.01;
        x: 4px;
        y: field.y + field.height - self.height + 2px;
        width: 76px;
        height: 84px;
        Floor { x: 0; y: 58px; width: 76px; height: 26px; }
        Figure {
            x: 0;
            y: 0;
            width: parent.width;
            height: 74px;
            visible: !Chats.flying;
            face: Chats.face;
            pose: Chats.waiting ? "think" : "idle";
            k: 0.26;
            live: Chats.live;
            source: Chats.face-live;
            lw: Chats.face-w;
            lh: Chats.face-h;
            th: Chats.face-th;
        }
        TouchArea { clicked => { Chats.poke(); } }
    }
    field := Composer {
        visible: !root.bare;
        x: 8px + root.pal;
        width: parent.width - 20px - root.pal;
        y: root.bottom - self.height;
    }
    if !Chats.readonly: Rectangle {
        property <bool> show: log.far && !Chats.viewing;
        x: parent.width - 12px - 48px;
        y: field.y - 8px - 48px;
        width: 48px;
        height: 48px;
        opacity: show ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; easing: T.out; }
        Rectangle {
            x: 6px;
            y: 6px;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: down.pressed ? #2e2e33 : Ink.raised;
            border-width: 1px;
            border-color: Ink.hair;
            animate background { duration: 160ms; easing: T.out; }
            Icon { d: "M12 5.5V18 M6 12.5l6 6l6 -6"; x: 8px; y: 8px; width: 20px; height: 20px; stroke: Ink.text2; stroke-width: 2px; }
        }
        if log.fresh: Rectangle { x: 33px; y: 7px; width: 9px; height: 9px; border-radius: 4.5px; background: Ink.warm; }
        down := TouchArea {
            enabled: parent.show;
            accessible-role: button;
            accessible-label: "Latest";
            clicked => { log.to-latest(); }
        }
    }
    if root.ended: Text {
        x: 28px;
        y: field.y;
        width: parent.width - 56px;
        height: 56px;
        text: Chats.ended;
        font-size: 14px;
        color: Ink.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    if !root.bare: Text {
        property <bool> on: Chats.trouble != "";
        x: field.x + 14px;
        y: field.y - 30px + (on ? 0px : 4px);
        width: field.width - 28px - 48px;
        height: 22px;
        text: Chats.trouble;
        font-size: 13px;
        font-weight: 600;
        color: #ec8a6f;
        vertical-alignment: center;
        overflow: elide;
        opacity: on ? 1 : 0;
        animate opacity, y { duration: 220ms; easing: T.out; }
    }
    Timer { interval: 4s; running: Chats.trouble != ""; triggered => { Chats.trouble = ""; } }
    PhotoView { }
}
