// The Chats list. At the top the agent that matters now stands on a soft floor, with a short line on where things
// stand (has a question, working on what you asked, replied, done), alive while it thinks; below, "Chats" and every
// chat grouped by what needs doing (Needs you, Working on it, Earlier), each a card titled with what you asked, its
// character standing in it. A card slides (or long-presses) open to Delete, with Undo after.
import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, ChatRow, Ink, BackButton } from "../chat.slint";
import { Figure, Floor } from "still.slint";
import { Shimmer } from "msg.slint";
import { SlideRow, UndoBar, Count } from "rows.slint";

export component ChatList inherits Rectangle {
    background: Ink.bg;
    property <ChatRow> h: Chats.hero;
    property <bool> alive: h.id == Chats.live-row && Chats.live && h.id != "";
    // The character on its way into (or back from) a chat isn't also standing here.
    function away(id: string) -> bool {
        return Chats.flying && Chats.from-id == id;
    }
    // A chat starting to close (or pulled): its character flies back to where its card is now (a message sent moves
    // the card), measured as it will stand once the list has grown back from 0.94 (home.slint). A card scrolled out
    // of view: only the sheet drops, with the character in it.
    function aim(p: Point, w: length, h: length, k: float) {
        let s = 1 - 0.06 * Chats.open-k;
        let x = root.width * 0.5 + (p.x - root.width * 0.5) / s;
        let y = root.height * 0.7 + (p.y - root.height * 0.7) / s;
        if (y < Home.sat + 48px || y + h > root.height) {
            Chats.fk = 0;
            return;
        }
        Chats.fx = x;
        Chats.fy = y;
        Chats.fw = w;
        Chats.fh = h;
        Chats.fk = k;
    }
    // Back, and New chat (a warm round button the picker grows out of), on one 48px row.
    Rectangle {
        y: Home.sat;
        height: 48px;
        BackButton { x: 4px; y: 0; }
        Rectangle {
            x: parent.width - 16px - self.width;
            y: 2px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: nb.pressed ? #9a4e36 : Ink.me;
            animate background { duration: 160ms; easing: T.out; }
            Icon { d: Icons.plus; x: 10px; y: 10px; stroke: #fff8f5; }
            nb := TouchArea { clicked => { Chats.picker = true; } }
        }
    }
    Flickable {
        y: Home.sat + 48px;
        width: parent.width;
        height: parent.height - self.y;
        content-height: list.preferred-height;
        flicked => { Chats.revealed = ""; }
        list := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: Home.sab + 24px;
            // Who matters now, standing on the floor, and where things stand in a word or two.
            if h.id != "": hero := Rectangle {
                height: 104px;
                property <bool> going: Chats.current == "" || Chats.held;
                changed going => {
                    if (self.going && Chats.from-id == h.id && Chats.fw == 104px) { root.aim(self.absolute-position, 104px, 104px, 0.36); }
                }
                TouchArea {
                    clicked => {
                        Chats.from-y = hero.absolute-position.y;
                        Chats.from-h = hero.height;
                        Chats.from-id = h.id;
                        Chats.fx = hero.absolute-position.x;
                        Chats.fy = hero.absolute-position.y;
                        Chats.fw = 104px;
                        Chats.fh = 104px;
                        Chats.fk = 0.36;
                        Chats.open-chat(h.id);
                    }
                }
                Floor { x: 0; y: 80px; width: 104px; height: 26px; }
                Figure {
                    x: 0;
                    y: 0;
                    width: 104px;
                    height: 104px;
                    visible: !root.away(h.id);
                    face: h.face;
                    pose: h.busy ? "think" : h.unread ? "happy" : "idle";
                    k: 0.36; // faces.rs HERO_K
                    live: root.alive;
                    source: Chats.big-live;
                    lw: Chats.big-w;
                    lh: Chats.big-h;
                    th: Chats.big-th;
                }
                VerticalLayout {
                    x: 118px;
                    width: parent.width - 118px;
                    alignment: center;
                    spacing: 4px;
                    Text { text: h.name; font-size: 13px; font-weight: 600; color: Ink.warm; overflow: elide; }
                    // at most two lines; a long question ends in "…"
                    Rectangle {
                        height: min(line.preferred-height, 52px);
                        clip: true;
                        line := Text {
                            y: 0;
                            width: parent.width;
                            height: self.preferred-height;
                            text: Chats.hero-line;
                            font-size: 19px;
                            font-weight: 700;
                            color: Ink.text;
                            wrap: word-wrap;
                        }
                    }
                    if h.busy: Shimmer { text: "Thinking"; font-size: 13px; base: #9a9aa3; }
                    if !h.busy: Text { text: h.time == "now" ? "Just now" : h.time + " ago"; font-size: 13px; color: #9a9aa3; }
                }
            }
            Text {
                height: 46px;
                text: "Chats";
                font-size: 28px;
                font-weight: 700;
                color: Ink.text;
                vertical-alignment: bottom;
            }
            // No chats yet: a proper empty page, not a blank one.
            if Chats.rows.length == 0: VerticalLayout {
                padding-top: 48px;
                spacing: 6px;
                Rectangle {
                    height: 150px;
                    Floor { x: (parent.width - 160px) / 2; y: 118px; width: 160px; height: 36px; }
                    Figure { x: 0; y: 0; width: parent.width; height: 150px; face: "clawd"; k: 0.5; }
                }
                Text { text: "No chats yet"; font-size: 18px; font-weight: 600; color: Ink.text; horizontal-alignment: center; }
                Text { text: "Start one with +"; font-size: 15px; color: Ink.muted; horizontal-alignment: center; }
            }
            for r in Chats.rows: VerticalLayout {
                // (opened from this card, or from the hero that has since moved on to another chat)
                property <bool> going: Chats.current == "" || Chats.held;
                changed going => {
                    if (self.going && Chats.from-id == r.id && (Chats.fw != 104px || Chats.hero.id != r.id)) {
                        root.aim(fig.absolute-position, 64px, 56px, 0.2);
                    }
                }
                // the group's name over its first card
                if r.head != "": Text {
                    height: 38px;
                    text: r.head;
                    font-size: 13px;
                    font-weight: 600;
                    color: r.head == "Needs you" ? Ink.warm : #9a9aa3;
                    vertical-alignment: center;
                }
                SlideRow {
                    id: r.id;
                    face-h: 84px;
                    gap: 10px;
                    face-bg: #151518;
                    radius: 18px;
                    margin: 16px;
                    tapped(y) => {
                        Chats.from-y = y;
                        Chats.from-h = 84px;
                        Chats.from-id = r.id;
                        Chats.fx = 24px;
                        Chats.fy = y + 14px;
                        Chats.fw = 64px;
                        Chats.fh = 56px;
                        Chats.fk = 0.2;
                        Chats.open-chat(r.id);
                    }
                    // the character standing in its card, on a little floor
                    Floor { x: 10px; y: 56px; width: 60px; height: 16px; }
                    fig := Figure { x: 8px; y: 14px; width: 64px; height: 56px; visible: !root.away(r.id); face: r.face; pose: r.busy ? "think" : "idle"; k: 0.2; }
                    // who and when
                    Text { x: 84px; y: 13px; width: parent.width - 84px - 70px; height: 16px; text: r.name; font-size: 12px; color: #9a9aa3; vertical-alignment: center; overflow: elide; }
                    Text {
                        x: parent.width - 70px;
                        y: 13px;
                        width: 56px;
                        height: 16px;
                        text: r.time;
                        font-size: 12px;
                        color: r.unread ? Ink.warm : #9a9aa3;
                        font-weight: r.unread ? 600 : 400;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    // what was asked: the card's title
                    Text {
                        x: 84px;
                        y: 31px;
                        width: parent.width - 84px - (r.unread ? 46px : 14px);
                        height: 21px;
                        text: r.asks ? r.preview : r.topic;
                        font-size: 15px;
                        font-weight: 600;
                        color: Ink.text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if r.unread: Count { x: parent.width - self.width - 14px; y: 30px; n: max(1, r.count); }
                    // and where it stands: the answer's start, or what's happening
                    if !r.busy && !r.asks: Text {
                        x: 84px;
                        y: 54px;
                        width: parent.width - 84px - 14px;
                        height: 18px;
                        text: r.preview == r.topic ? (r.topic == "New chat" ? "Nothing sent yet" : "No answer yet") : r.preview; // my question is the last word
                        font-size: 13px;
                        color: r.unread ? Ink.text2 : #9a9aa3;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if r.asks: Text { x: 84px; y: 54px; width: parent.width - 84px - 14px; height: 18px; text: r.choices.length == 0 ? "Waiting for your answer" : "Waiting for your answer · " + r.choices.length + (r.choices.length == 1 ? " choice" : " choices"); font-size: 13px; color: Ink.warm; overflow: elide; vertical-alignment: center; }
                    if r.busy: Shimmer { x: 84px; y: 54px; height: 18px; text: "Thinking it through"; font-size: 13px; base: #a08a80; vertical-alignment: center; }
                }
            }
        }
    }
    UndoBar { x: 16px; width: parent.width - 32px; base: parent.height - Home.sab - 16px; }
}
