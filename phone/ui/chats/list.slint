// The Chats list. At the top the agent that matters now stands on a soft floor and says where things stand (working
// on your message, has a question, just replied), alive while it thinks; below, the chats grouped by what needs
// doing (Needs you, Working on it, Earlier), each a card titled with what you asked, its character standing in it.
// A card slides (or long-presses) open to Delete, with Undo after.
import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, ChatRow, Ink, BackButton } from "../chat.slint";
import { Figure, Floor } from "still.slint";
import { Shimmer } from "msg.slint";
import { SlideRow, UndoBar, Count } from "rows.slint";

export component ChatList inherits Rectangle {
    background: Ink.bg;
    property <ChatRow> h: Chats.hero;
    property <bool> alive: h.id == Chats.live-row && Chats.live && h.id != "";
    // The character on its way into (or back from) a chat isn't also standing here.
    function away(id: string) -> bool {
        return Chats.flying && Chats.from-id == id;
    }
    Rectangle {
        y: Home.sat;
        height: 56px;
        BackButton { }
        // New chat: a warm round button (the picker grows out of it).
        Rectangle {
            x: parent.width - 60px;
            y: 4px;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: nb.pressed ? #9a4e36 : Ink.me;
            animate background { duration: 160ms; easing: T.out; }
            Icon { d: Icons.plus; x: 12px; y: 12px; stroke: #fff8f5; }
            nb := TouchArea { clicked => { Chats.picker = true; } }
        }
    }
    if Chats.rows.length == 0: VerticalLayout {
        y: Home.sat + 180px;
        width: parent.width;
        spacing: 6px;
        Text { text: "No chats yet"; font-size: 18px; font-weight: 600; color: Ink.text; horizontal-alignment: center; }
        Text { text: "Start one with +"; font-size: 15px; color: Ink.muted; horizontal-alignment: center; }
    }
    Flickable {
        y: Home.sat + 56px;
        width: parent.width;
        height: parent.height - self.y;
        content-height: list.preferred-height;
        flicked => { Chats.revealed = ""; }
        list := VerticalLayout {
            padding-bottom: Home.sab + 24px;
            // Who matters now, standing on the floor, and where things stand.
            if h.id != "": hero := Rectangle {
                height: 150px;
                TouchArea {
                    clicked => {
                        Chats.from-y = hero.absolute-position.y;
                        Chats.from-h = hero.height;
                        Chats.from-id = h.id;
                        Chats.fx = hero.absolute-position.x + 8px;
                        Chats.fy = hero.absolute-position.y;
                        Chats.fw = 140px;
                        Chats.fh = 136px;
                        Chats.fk = 0.46;
                        Chats.open-chat(h.id);
                    }
                }
                Floor { x: 8px; y: 106px; width: 140px; height: 40px; }
                Figure {
                    x: 8px;
                    y: 0;
                    width: 140px;
                    height: 136px;
                    visible: !root.away(h.id);
                    face: h.face;
                    pose: h.busy ? "think" : h.unread ? "happy" : "idle";
                    k: 0.46; // faces.rs HERO_K
                    live: root.alive;
                    source: Chats.big-live;
                    lw: Chats.big-w;
                    lh: Chats.big-h;
                    th: Chats.big-th;
                }
                VerticalLayout {
                    x: 156px;
                    width: parent.width - 156px - 20px;
                    alignment: center;
                    spacing: 5px;
                    Text { text: h.name; font-size: 14px; font-weight: 600; color: h.busy || h.asks || h.unread ? Ink.warm : Ink.muted; overflow: elide; }
                    Text { text: Chats.hero-line; font-size: 20px; font-weight: 650; color: Ink.text; wrap: word-wrap; max-height: 3 * 25px; overflow: elide; }
                    if h.busy: Shimmer { text: "Thinking"; font-size: 14px; base: #8a8c93; }
                    if !h.busy: Text { text: h.time == "now" ? "Just now" : h.time + " ago"; font-size: 14px; color: Ink.muted; }
                }
            }
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                for r in Chats.rows: VerticalLayout {
                    // the group's name over its first card (the one standing at the top isn't repeated below)
                    if r.head != "" && r.id != root.h.id: Text {
                        height: 38px;
                        x: 8px;
                        text: r.head;
                        font-size: 14px;
                        font-weight: 650;
                        color: r.head == "Needs you" ? Ink.warm : Ink.muted;
                        vertical-alignment: center;
                    }
                    SlideRow {
                        id: r.id;
                        face-h: r.id == root.h.id ? 0px : 100px;
                        gap: 8px;
                        visible: r.id != root.h.id;
                        face-bg: #151518;
                        radius: 22px;
                        margin: 12px;
                        tapped(y) => {
                            Chats.from-y = y;
                            Chats.from-h = 100px;
                            Chats.from-id = r.id;
                            Chats.fx = 18px;
                            Chats.fy = y - 2px;
                            Chats.fw = 66px;
                            Chats.fh = 78px;
                            Chats.fk = 0.24;
                            Chats.open-chat(r.id);
                        }
                        // the character standing in its card, on a little floor
                        Floor { x: 8px; y: 66px; width: 62px; height: 20px; }
                        Figure { x: 6px; y: -2px; width: 66px; height: 78px; visible: !root.away(r.id); face: r.face; pose: r.busy ? "think" : "idle"; k: 0.24; }
                        // who and when
                        Text { x: 80px; y: 12px; width: parent.width - 80px - 80px; height: 20px; text: r.name; font-size: 13.5px; font-weight: 600; color: Ink.text2; vertical-alignment: center; overflow: elide; }
                        Text {
                            x: parent.width - 76px;
                            y: 12px;
                            width: 62px;
                            height: 20px;
                            text: r.time;
                            font-size: 13px;
                            color: r.unread ? Ink.warm : Ink.muted;
                            font-weight: r.unread ? 600 : 400;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        // what was asked: the card's title
                        Text {
                            x: 80px;
                            y: 34px;
                            width: parent.width - 80px - (r.unread ? 50px : 16px);
                            height: 24px;
                            text: r.asks ? r.preview : r.topic;
                            font-size: 16.5px;
                            font-weight: 650;
                            color: Ink.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if r.unread: Count { x: parent.width - self.width - 14px; y: 35px; n: max(1, r.count); }
                        // and where it stands: the answer's start, or what's happening
                        if !r.busy && !r.asks: Text {
                            x: 80px;
                            y: 60px;
                            width: parent.width - 80px - 16px;
                            height: 24px;
                            text: r.preview == r.topic ? (r.topic == "New chat" ? "Nothing sent yet" : "No answer yet") : r.preview; // my question is the last word
                            font-size: 14.5px;
                            color: r.unread ? Ink.text2 : Ink.muted;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if r.asks: Text { x: 80px; y: 60px; height: 24px; text: r.choices.length == 0 ? "Waiting for your answer" : "Waiting for your answer · " + r.choices.length + (r.choices.length == 1 ? " choice" : " choices"); font-size: 14.5px; color: Ink.warm; vertical-alignment: center; }
                        if r.busy: Shimmer { x: 80px; y: 60px; height: 24px; text: "Thinking it through"; font-size: 14.5px; base: #a08a80; vertical-alignment: center; }
                    }
                }
            }
        }
    }
    UndoBar { x: 16px; width: parent.width - 32px; base: parent.height - Home.sab - 16px; }
}
