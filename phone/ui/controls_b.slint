// PREVIEW (branch preview/home-controls-3): home control directions 3 and 4 (controls.slint has the others).
import { T, Icon, Icons, Morph } from "parts.slint";
import { Home, Mode, SetupCard } from "home_parts.slint";
import { Toys } from "toys.slint";
import { Chats } from "chat.slint";
import { Ctl, Glyphs, SwapLines, CallPill, Glyph } from "controls.slint";

// 3 Steps: the status line is the control. Swipe it sideways (it follows the finger) or tap its faint arrows to
// step through the modes; six small dots say where you are, and the pair react: a hop as they wake to a mode, asleep
// in the quiet ones. Chats is a speech bubble by Clawd (home.slint places ChatBubble). Test ring, Widget and setup
// sit behind one "•••" in the top corner, whose card grows out of it.
export component Steps inherits Rectangle {
    in property <length> block-y;
    in property <length> pill-y;
    property <float> fade: Home.kb > 0 ? 0 : 1;
    animate fade { duration: 200ms; easing: T.out; }
    property <length> sp: 220px; // between neighbouring names on the line
    property <bool> drag;
    property <length> dx;
    // past either end the line gives a little, then springs back
    property <length> pull: (Home.index == 0 && self.dx > 0) || (Home.index == 5 && self.dx < 0) ? self.dx / 3 : self.dx;
    property <length> off: self.drag ? -Home.index * self.sp + self.pull : -Home.index * self.sp;
    animate off { duration: root.drag ? 0ms : 520ms; easing: T.spring; }
    function step(by: int) {
        let to = max(0, min(5, Home.index + by));
        if (to != Home.index) {
            Home.set-mode(Ctl.mode(to).id);
            if (to < 3) {
                Toys.tapped("claude");
            }
        }
    }

    SwipeGestureHandler {
        y: root.block-y - 12px;
        width: root.width;
        height: Ctl.block-h + 40px;
        opacity: root.fade;
        handle-swipe-left: !Ctl.open && !Ctl.sheet;
        handle-swipe-right: !Ctl.open && !Ctl.sheet;
        moved => {
            root.dx = self.current-position.x - self.pressed-position.x;
            root.drag = true;
        }
        swiped => {
            let by = root.dx < -40px ? 1 : root.dx > 40px ? -1 : 0;
            root.drag = false;
            root.dx = 0;
            root.step(by);
        }
        cancelled => { root.drag = false; root.dx = 0; }
        accessible-role: button;
        accessible-label: "Mode: " + Ctl.line + ". Swipe to change.";
        // the names, one per step along the line: only the one at the middle shows at rest
        for i in 6: Text {
            property <length> c: root.width / 2 + root.off + root.sp * i;
            x: self.c - 130px;
            y: 12px + (Ctl.block-h - 26px) / 2;
            width: 260px;
            height: 26px;
            text: Ctl.lines[i];
            font-size: 20px;
            font-weight: 600;
            letter-spacing: -0.2px;
            color: T.fg;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: max(0, 1 - abs(self.c - root.width / 2) / 140px);
        }
        for s[j] in [{ d: Glyphs.left, by: -1 }, { d: Glyphs.right, by: 1 }]: Rectangle {
            property <bool> can: s.by < 0 ? Home.index > 0 : Home.index < 5;
            x: j == 0 ? 14px : root.width - 14px - 48px;
            y: 12px + (Ctl.block-h - 48px) / 2;
            width: 48px;
            height: 48px;
            opacity: self.can ? 1 : 0;
            animate opacity { duration: 200ms; easing: T.out; }
            accessible-role: button;
            accessible-label: s.by < 0 ? "Previous mode" : "Next mode";
            Rectangle { border-radius: 24px; background: st.pressed ? #ffffff12 : transparent; }
            Icon { d: s.d; x: 14px; y: 14px; width: 20px; height: 20px; stroke-width: 2px; stroke: #ffffff4d; }
            st := TouchArea { enabled: parent.can; clicked => { root.step(s.by); } }
        }
        if !Home.ready: Text {
            y: 12px + Ctl.block-h - 2px;
            width: parent.width;
            height: 16px;
            text: "Almost ready: finish setting up in •••";
            font-size: 12.5px;
            color: #c9a46a;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    // where you are: the lit dot slides along and widens where it rests (white awake, lilac asleep), with a little
    // gap before the Asleep pair
    property <float> at: Home.index;
    animate at { duration: 520ms; easing: T.spring; }
    property <length> dots-x: (self.width - (6 * 5px + 5 * 7px + 11px + 6px)) / 2;
    for i in 6: Rectangle {
        property <float> lit: max(0, 1 - abs(i - root.at));
        x: root.dots-x + 12px * i + 11px * max(0, min(1, i - root.at)) + (i >= 4 ? 6px : 0px);
        y: root.block-y + Ctl.block-h + (Home.ready ? 6px : 22px);
        width: 5px + 11px * self.lit;
        height: 5px;
        border-radius: 2.5px;
        background: #ffffff2e;
        opacity: root.fade;
        Rectangle { border-radius: 2.5px; background: i >= 4 ? Ctl.night : #ffffffe8; opacity: parent.lit; }
    }
    CallPill { x: (root.width - self.width) / 2; y: root.pill-y; opacity: root.fade; }
    more := Glyph {
        x: root.width - 56px;
        y: Home.sat + 2px;
        icon: Glyphs.more;
        label: Home.ready ? "More: test ring, widget" : "More: finish setting up, test ring, widget";
        dot: !Home.ready;
        dot-color: Ctl.amber;
        stroke: T.fg2;
        opacity: root.fade * (1 - min(1, root.card-k * 4));
        clicked => { Ctl.open = true; }
    }
    property <float> card-k: Ctl.open ? 1 : 0;
    animate card-k { duration: Ctl.open ? 500ms : 300ms; easing: Ctl.open ? T.spring : T.close; }
    if Ctl.open: TouchArea { clicked => { Ctl.open = false; } }
    Morph {
        open: Ctl.open;
        panel: Ctl.card;
        fx: more.x;
        fy: more.y;
        fsize: 48px;
        tw: 264px;
        tx: root.width - 16px - self.tw;
        ty: Home.sat + 54px;
        th: 8px + (Home.ready ? 0px : 126px) + 2 * 52px + 8px;
        radius: 22px;
        face: Glyphs.more;
        VerticalLayout {
            padding: 8px;
            spacing: 0px;
            if !Home.ready: Rectangle {
                height: 126px;
                Rectangle {
                    y: 0;
                    height: 118px;
                    border-radius: 15px;
                    background: #e8a33d12;
                    border-width: 1px;
                    border-color: #e8a33d3a;
                    Text { x: 14px; y: 13px; width: parent.width - 28px; text: "Finish setting up"; font-size: 15px; font-weight: 600; color: T.fg; }
                    Text { x: 14px; y: 35px; width: parent.width - 28px; height: 34px; text: Home.missing; font-size: 12.5px; color: T.muted; wrap: word-wrap; }
                    Rectangle {
                        x: 14px;
                        y: 74px;
                        width: 80px;
                        height: 32px;
                        border-radius: 16px;
                        background: su.pressed ? #c4664a : T.accent;
                        accessible-role: button;
                        accessible-label: "Set up";
                        Text { text: "Set up"; font-size: 14px; font-weight: 600; color: white; }
                        su := TouchArea { clicked => { Home.set-up(); } }
                    }
                }
            }
            for a[j] in [{ icon: Icons.bell, label: "Test ring" }, { icon: Icons.grid, label: "Widget" }]: Rectangle {
                height: 52px;
                accessible-role: button;
                accessible-label: a.label;
                Rectangle { border-radius: 14px; background: mt.pressed ? #ffffff0d : j == 1 && (Home.widgets || Home.channel) ? #ffffff0a : transparent; }
                Icon { d: a.icon; x: 14px; y: 16px; width: 20px; height: 20px; stroke-width: 1.8px; stroke: T.fg2; }
                Text { x: 48px; text: a.label; font-size: 15px; font-weight: 500; color: T.fg; vertical-alignment: center; height: parent.height; }
                mt := TouchArea {
                    clicked => {
                        if (j == 0) {
                            Ctl.open = false;
                            Ctl.act(0);
                        } else {
                            Ctl.from(self.absolute-position.x + 24px, self.absolute-position.y + 26px);
                            Ctl.act(1);
                        }
                    }
                }
            }
        }
    }
}

// 3's Chats: a small speech bubble by Clawd. An outline at rest; filled orange with something unread (it grows in,
// then floats gently). The Chats screen grows out of it.
export component ChatBubble inherits Rectangle {
    width: 52px;
    height: 48px;
    accessible-role: button;
    accessible-label: Chats.unread ? "Chats, something new" : "Chats";
    property <float> c: Chats.unread ? 1 : 0;
    animate c { duration: Chats.unread ? 520ms : 200ms; easing: Chats.unread ? T.spring : T.out; }
    property <length> bob: Chats.unread ? 2.5px * Math.sin(animation-tick() / 2200ms * 360deg) : 0px;
    property <string> shape: "M7.5 2.5h17a5 5 0 0 1 5 5v8a5 5 0 0 1 -5 5h-11l-6.5 5v-5h0.5a5 5 0 0 1 -5 -5v-8a5 5 0 0 1 5 -5z";
    property <string> dots: "M10.5 11.5h0.01 M16 11.5h0.01 M21.5 11.5h0.01";
    Rectangle {
        x: 10px;
        y: 8px + root.bob;
        width: 32px;
        height: 28px;
        transform-origin: { x: 6px, y: 26px };
        transform-scale: 0.9 + 0.1 * (t.pressed ? 0.6 : 1) + 0.04 * root.c * (1 - root.c) * 4;
        // the outline, and the filled bubble growing over it from its tail
        Path { width: 32px; height: 28px; viewbox-width: 32; viewbox-height: 28; commands: root.shape; fill: transparent; stroke: #ffffff59; stroke-width: 1.6px; opacity: 1 - root.c; }
        Path { width: 32px; height: 28px; viewbox-width: 32; viewbox-height: 28; commands: root.dots; fill: transparent; stroke: #ffffff70; stroke-width: 2.6px; stroke-line-cap: round; opacity: 1 - root.c; }
        Rectangle {
            transform-origin: { x: 6px, y: 26px };
            transform-scale: root.c;
            opacity: min(1, root.c * 2);
            Path { width: 32px; height: 28px; viewbox-width: 32; viewbox-height: 28; commands: root.shape; fill: T.accent; stroke: T.accent; stroke-width: 1.6px; }
            Path { width: 32px; height: 28px; viewbox-width: 32; viewbox-height: 28; commands: root.dots; fill: transparent; stroke: #ffffff; stroke-width: 2.8px; stroke-line-cap: round; }
        }
    }
    t := TouchArea {
        clicked => {
            Ctl.from(root.absolute-position.x + 26px, root.absolute-position.y + 22px);
            Ctl.act(2);
        }
    }
}

// 4 Pages: the home is the middle of three pages, as in a camera app. Swipe right (or tap the mode's icon left of
// Call) for the modes page; swipe left (or tap Chats right of it) for the chats. Both follow the finger; home.slint
// slides the pages. This draws the home page's status and bottom row; ModesPage is the page on the left.
export component PagesHome inherits Rectangle {
    in property <length> block-y;
    in property <length> pill-y;
    property <float> fade: Home.kb > 0 ? 0 : 1;
    animate fade { duration: 200ms; easing: T.out; }
    Rectangle {
        y: root.block-y;
        height: Ctl.block-h;
        opacity: root.fade;
        accessible-role: button;
        accessible-label: "Mode: " + Ctl.line;
        SwapLines {
            y: (parent.height - 26px) / 2;
            width: parent.width;
            height: 26px;
            text: Ctl.line;
            font-size: 20px;
            weight: 600;
            spacing: -0.2px;
            color: T.fg;
        }
        TouchArea { clicked => { Ctl.open = true; } }
    }
    pill := CallPill { x: (root.width - self.width) / 2; y: root.pill-y; opacity: root.fade; }
    // the current mode's icon (it swaps as the mode does), and Chats
    Glyph {
        x: pill.x - 14px - 48px;
        y: root.pill-y + (Ctl.pill-h - 48px) / 2;
        icon: Glyphs.tune;
        label: "Modes";
        dot: !Home.ready;
        dot-color: Ctl.amber;
        opacity: root.fade;
        clicked => { Ctl.open = true; }
    }
    Glyph {
        x: pill.x + pill.width + 14px;
        y: root.pill-y + (Ctl.pill-h - 48px) / 2;
        icon: Icons.chat;
        label: Chats.unread ? "Chats, something new" : "Chats";
        dot: Chats.unread;
        opacity: root.fade;
        clicked => { Ctl.act(2); }
    }
}

// 4's left page: every mode with what it means (the check shrinks out of the old row and grows into the new one,
// then the page slides home), then Test ring and Widget, and the setup card on top while setup is unfinished.
export component ModesPage inherits Rectangle {
    background: #0d0d0c;
    property <length> row-h: 60px;
    property <length> top: Home.sat + 64px + (Home.ready ? 0px : 104px);
    TouchArea { } // a tap on the page stays on it
    Text { x: 24px; y: Home.sat + 18px; text: "How they reach you"; font-size: 22px; font-weight: 700; color: T.fg; }
    // back home (the page's own way out, as well as Back and a swipe left)
    Rectangle {
        x: root.width - 60px;
        y: Home.sat + 8px;
        width: 48px;
        height: 48px;
        accessible-role: button;
        accessible-label: "Home";
        Rectangle { border-radius: 24px; background: hb.pressed ? #ffffff12 : transparent; }
        Icon { d: Glyphs.right; x: 13px; y: 13px; width: 22px; height: 22px; stroke-width: 2px; stroke: T.fg2; }
        hb := TouchArea { clicked => { Ctl.open = false; } }
    }
    if !Home.ready: SetupCard { x: 16px; y: Home.sat + 68px; width: root.width - 32px; height: 88px; }
    for i in 6: Rectangle {
        property <bool> on: Home.index == i;
        property <Mode> m: Ctl.mode(i);
        x: 0;
        y: root.top + root.row-h * i + (i >= 4 ? 40px : 0px);
        width: root.width;
        height: root.row-h;
        accessible-role: button;
        accessible-label: Ctl.lines[i];
        Rectangle { x: 12px; width: parent.width - 24px; border-radius: 14px; background: pick.pressed ? #ffffff0d : transparent; }
        Icon {
            d: parent.m.icon;
            x: 24px;
            y: (parent.height - 22px) / 2;
            width: 22px;
            height: 22px;
            stroke-width: 1.8px;
            stroke: parent.on ? (i >= 4 ? Ctl.night : T.fg) : #77777c;
            animate stroke { duration: 200ms; }
        }
        Text { x: 64px; y: 10px; height: 22px; text: Ctl.lines[i]; font-size: 16.5px; font-weight: 600; color: parent.on ? T.fg : #c3c3c7; vertical-alignment: center; }
        Text { x: 64px; y: 32px; width: parent.width - 64px - 64px; height: 18px; text: Ctl.short[i]; font-size: 13px; color: T.muted; overflow: elide; vertical-alignment: center; }
        property <float> c: self.on ? 1 : 0;
        animate c { duration: self.on ? 300ms : 160ms; delay: self.on ? 120ms : 0ms; easing: self.on ? T.spring : T.out; }
        Icon {
            d: Icons.check;
            x: parent.width - 46px + 11px * (1 - parent.c);
            y: (parent.height - 22px) / 2 + 11px * (1 - parent.c);
            width: 22px * parent.c;
            height: 22px * parent.c;
            opacity: min(1, parent.c * 3);
            stroke-width: 2.2px;
            stroke: i >= 4 ? Ctl.night : T.accent;
        }
        pick := TouchArea {
            clicked => {
                if (Home.index != i) {
                    Home.set-mode(parent.m.id);
                }
                home.running = true;
            }
        }
    }
    Rectangle { x: 24px; y: root.top + 4 * root.row-h + 19px; width: root.width - 48px; height: 1px; background: Ctl.line-c; }
    // Test ring and Widget
    property <length> tools-y: root.top + 6 * root.row-h + 40px + 20px;
    // under an open Widget sheet the tools fade out, so no sliver of them shows above it
    property <float> tfade: Ctl.sheet ? 0 : 1;
    animate tfade { duration: 200ms; easing: T.out; }
    Rectangle { x: 24px; y: root.tools-y - 10px; width: root.width - 48px; height: 1px; background: Ctl.line-c; opacity: root.tfade; }
    for a[j] in [{ icon: Icons.bell, label: "Test ring", desc: "Rings this phone once, as a call would." }, { icon: Icons.grid, label: "Widget", desc: "Put the mode on your home screen." }]: Rectangle {
        y: root.tools-y + root.row-h * j;
        width: root.width;
        height: root.row-h;
        opacity: root.tfade;
        accessible-role: button;
        accessible-label: a.label;
        Rectangle { x: 12px; width: parent.width - 24px; border-radius: 14px; background: tl.pressed ? #ffffff0d : j == 1 && (Home.widgets || Home.channel) ? #ffffff0a : transparent; }
        Icon { d: a.icon; x: 24px; y: (parent.height - 22px) / 2; width: 22px; height: 22px; stroke-width: 1.8px; stroke: T.fg2; }
        Text { x: 64px; y: 10px; height: 22px; text: a.label; font-size: 16.5px; font-weight: 600; color: #c3c3c7; vertical-alignment: center; }
        Text { x: 64px; y: 32px; width: parent.width - 88px; height: 18px; text: a.desc; font-size: 13px; color: T.muted; overflow: elide; vertical-alignment: center; }
        tl := TouchArea {
            clicked => {
                Ctl.from(self.absolute-position.x + 35px, self.absolute-position.y + 30px);
                Ctl.act(j);
            }
        }
    }
    home := Timer {
        interval: 480ms;
        running: false;
        triggered => {
            self.running = false;
            Ctl.open = false;
        }
    }
}
