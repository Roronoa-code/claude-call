// The Chats list: every chat, newest first; a row slides (or long-presses) open to Delete, with Undo for a moment.
import { T, Icon, Icons } from "parts.slint";
import { Home } from "home_parts.slint";
import { Actor } from "actor.slint";
import { Chats, Ink, IconButton, BackButton, Arrive } from "chat.slint";

// The chats, newest first.
export component ChatList inherits Rectangle {
    Arrive {
        y: (1 - self.k) * 14px;
        Rectangle {
            y: Home.sat;
            height: 60px;
            BackButton { }
            IconButton {
                x: parent.width - 52px; // the picker grows out of here
                y: 6px;
                icon: Icons.plus;
                clicked => { Chats.picker = true; }
            }
        }
        Text {
            x: 20px;
            y: Home.sat + 64px;
            text: "Chats";
            font-size: 30px;
            font-weight: 700;
            color: Ink.text;
        }
        if Chats.rows.length == 0: VerticalLayout {
            y: Home.sat + 150px;
            width: parent.width;
            alignment: start;
            spacing: 6px;
            Text { text: "No chats yet"; font-size: 17px; font-weight: 600; color: Ink.text; horizontal-alignment: center; }
            Text { text: "Tap + to start one."; font-size: 14.5px; color: Ink.muted; horizontal-alignment: center; }
        }
        Flickable {
            y: Home.sat + 116px;
            width: parent.width;
            height: parent.height - self.y;
            content-height: list.preferred-height + Home.sab + 16px;
            flicked => { Chats.revealed = ""; }
            list := VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                for r in Chats.rows: row := Rectangle {
                    property <length> reveal: 96px; // how far a row slides open: Delete and its margin
                    property <bool> away: r.id == Chats.leaving;
                    property <float> enter: r.id == Chats.returning ? 0 : 1; // 0 -> 1 as Undo brings it back
                    property <float> hk: away ? 0 : 1; // the gap closes once the row is sliding out
                    property <bool> sliding; // a finger is pulling it sideways
                    property <bool> slid; // ...since this press, so letting go is not a tap
                    property <bool> held; // a long press opened it, so letting go is not a tap
                    property <bool> gone; // asked to delete
                    property <length> from;
                    property <length> drag;
                    property <length> dx: away ? -(self.width + 24px) : sliding ? drag : Chats.revealed == r.id ? -reveal : 0px;
                    animate dx { duration: sliding ? 0ms : away ? 300ms : 360ms; easing: away ? T.close : T.out; }
                    animate hk { duration: 300ms; delay: 170ms; easing: T.close; }
                    animate enter { duration: 440ms; easing: T.out; }
                    init => {
                        if (self.enter < 1) {
                            self.enter = 1; // from 0: the row opens and slides back in
                            Chats.returning = "";
                        }
                    }
                    height: 78px * hk * enter;
                    // Out and its gap closed: now the chat goes.
                    Timer {
                        interval: 480ms;
                        running: row.away && !row.gone;
                        triggered => { row.gone = true; Chats.delete-chat(r.id); }
                    }
                    // Long press: open it as a slide would.
                    Timer {
                        interval: 450ms;
                        running: touch.pressed && !row.slid && !row.held && !row.away;
                        triggered => { row.held = true; Chats.revealed = r.id; }
                    }
                    // Taps and the sideways pull, on the row itself (it stays put while what it shows slides).
                    touch := TouchArea {
                        enabled: !row.away;
                        changed pressed => {
                            if (self.pressed) {
                                row.slid = false;
                                row.held = false;
                                row.from = Chats.revealed == r.id ? -row.reveal : 0px;
                            } else if (row.sliding) {
                                // let go: open past halfway (or flung open), else shut
                                Chats.revealed = row.drag < -row.reveal / 2 ? r.id : Chats.revealed == r.id ? "" : Chats.revealed;
                                row.sliding = false;
                            }
                        }
                        moved => {
                            if (!row.slid && !row.held && Math.abs(self.mouse-x - self.pressed-x) > 10px
                                && Math.abs(self.mouse-x - self.pressed-x) > 1.3 * Math.abs(self.mouse-y - self.pressed-y)) {
                                row.slid = true;
                                row.drag = row.from;
                                row.sliding = true;
                                if (Chats.revealed != r.id) { Chats.revealed = ""; } // only one open at a time
                            }
                            if (row.sliding) {
                                // follows the finger; past fully open it gives, a little
                                row.drag = min(0px, row.from + self.mouse-x - self.pressed-x);
                                if (row.drag < -row.reveal) { row.drag = -row.reveal + (row.drag + row.reveal) * 0.3; }
                            }
                        }
                        clicked => {
                            if (row.slid || row.held) { return; }
                            if (Chats.revealed != "") { Chats.revealed = ""; return; } // a tap shuts an open row first
                            Chats.from-y = row.absolute-position.y;
                            Chats.from-h = 78px;
                            Chats.open-chat(r.id);
                        }
                    }
                    // What shows, clipped to the screen's edges (not the list's margin) as it slides and as the gap closes.
                    Rectangle {
                        x: -8px;
                        width: row.width + 16px;
                        clip: true;
                        // Delete, under the row on the right; it comes up as the row slides off it.
                        Rectangle {
                            property <float> p: clamp(-row.dx / row.reveal, 0, 1);
                            x: parent.width - self.width - 8px;
                            y: 6px;
                            width: row.reveal - 12px;
                            height: 66px;
                            border-radius: 18px;
                            background: del.pressed ? #b53a31 : #d0473d;
                            animate background { duration: 140ms; easing: T.out; }
                            opacity: row.away ? 0 : min(1, p * 1.6);
                            animate opacity { duration: row.away ? 180ms : 0ms; }
                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                            transform-scale: 0.82 + 0.18 * p;
                            Icon { d: "M4.5 7h15 M9.5 7V4.8h5V7 M6.5 7l1 12.2h9l1 -12.2 M10.2 10.8v4.8 M13.8 10.8v4.8"; x: (parent.width - 24px) / 2; y: 12px; stroke: #fff8f5; stroke-width: 1.8px; }
                            Text { y: 41px; width: parent.width; text: "Delete"; font-size: 12.5px; font-weight: 600; color: #fff8f5; horizontal-alignment: center; }
                            del := TouchArea {
                                enabled: Chats.revealed == r.id && !row.away;
                                clicked => { Chats.revealed = ""; Chats.leaving = r.id; }
                            }
                        }
                        Rectangle {
                            x: 8px + row.dx - (1 - row.enter) * (row.width + 24px);
                            width: row.width;
                            height: 78px;
                            y: 0;
                            border-radius: 18px;
                            background: Ink.bg;
                            Rectangle {
                                border-radius: 18px;
                                background: touch.pressed && !row.slid ? #ffffff0d : #ffffff00;
                                animate background { duration: 160ms; easing: T.out; }
                            }
                            // The agent's character, a still picture (only the open chat's is alive), standing on the row.
                            Actor { x: 6px; y: 1px; width: 60px; height: 62px; face: r.face; k: 0.21; }
                            Text {
                                x: 78px;
                                y: 15px;
                                width: parent.width - 78px - 70px;
                                text: r.name;
                                font-size: 16.5px;
                                font-weight: 600;
                                color: Ink.text;
                                overflow: elide;
                            }
                            Text {
                                x: parent.width - 72px;
                                y: 17px;
                                width: 58px;
                                text: r.time;
                                font-size: 12.5px;
                                font-weight: r.unread ? 600 : 400;
                                color: r.unread ? Ink.warm : Ink.muted;
                                horizontal-alignment: right;
                            }
                            Text {
                                x: 78px;
                                y: 42px;
                                width: parent.width - 78px - (r.unread ? 44px : 18px);
                                text: r.busy ? "Thinking…" : r.preview;
                                font-size: 14.5px;
                                color: r.busy || r.asks ? Ink.warm : r.unread ? Ink.text2 : Ink.muted;
                                overflow: elide;
                            }
                            if r.unread: Rectangle {
                                x: parent.width - 26px;
                                y: 48px;
                                width: 9px;
                                height: 9px;
                                border-radius: 4.5px;
                                background: T.accent;
                            }
                        }
                    }
                }
            }
        }
        // For a few seconds after a delete: "Chat deleted", and Undo.
        Rectangle {
            property <float> k: Chats.deleted != "" ? 1 : 0;
            animate k { duration: Chats.deleted != "" ? 380ms : 240ms; easing: Chats.deleted != "" ? T.out : T.close; }
            visible: self.k > 0.01;
            x: 16px;
            width: parent.width - 32px;
            height: 52px;
            y: parent.height - Home.sab - 16px - self.height + (1 - self.k) * 20px;
            opacity: self.k;
            border-radius: 18px;
            background: Ink.raised;
            border-width: 1px;
            border-color: Ink.hair;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-y: 4px;
            TouchArea { } // the list under it takes no taps
            Text { x: 18px; height: parent.height; text: "Chat deleted"; font-size: 15px; color: Ink.text; vertical-alignment: center; }
            Rectangle {
                x: parent.width - self.width - 6px;
                width: 76px;
                height: 40px;
                border-radius: 14px;
                background: undo.pressed ? #ffffff14 : #ffffff00;
                animate background { duration: 140ms; easing: T.out; }
                Text { text: "Undo"; font-size: 15px; font-weight: 600; color: Ink.warm; }
                undo := TouchArea { enabled: Chats.deleted != ""; clicked => { Chats.undo(); } }
            }
        }
    }
}
