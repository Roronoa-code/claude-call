// PREVIEW (preview/chats-4): the chats directions on the Chats screen (debug.callme.chats 1-3; home.slint shows today's
// screens for 0). The list stays put underneath; a chat grows out of the row that opened it into the whole screen,
// opaque all the way (no two screens see-through on each other), its contents rising in once it is nearly full;
// Back shrinks it into its row again.
import { T } from "../parts.slint";
import { Chats, Ink } from "../chat.slint";
import { ListA, ThreadA } from "a.slint";
import { ListB, ThreadB } from "b.slint";

component Grow inherits Rectangle {
    in property <bool> open;
    in property <length> from-y; // the row's top, on the screen
    in property <length> from-h: 80px;
    property <float> k: open ? 1 : 0;
    animate k { duration: open ? 440ms : 320ms; easing: open ? T.out : T.close; }
    out property <bool> shown: open || k > 0.002;
    out property <bool> full: k > 0.999;
    property <length> fy: clamp(from-y, 0px, self.height - from-h);
    visible: shown;
    // The list dims as the chat covers it.
    Rectangle { background: #000000; opacity: 0.5 * k; }
    Rectangle {
        x: 8px * (1 - k);
        y: root.fy * (1 - k);
        width: root.width - 16px * (1 - k);
        height: root.from-h + (root.height - root.from-h) * k;
        border-radius: 22px * (1 - k);
        background: Ink.bg;
        clip: true;
        Rectangle {
            x: -parent.x;
            y: -parent.y;
            width: root.width;
            height: root.height;
            opacity: clamp((root.k - 0.5) * 2.4, 0, 1);
            @children
        }
    }
}

export component Chats4 inherits Rectangle {
    if Chats.look == 1: ListA { visible: !grow.full; }
    if Chats.look == 2: ListB { visible: !grow.full; }
    grow := Grow {
        open: Chats.current != "";
        from-y: Chats.from-y;
        if grow.shown && Chats.look == 1: ThreadA { }
        if grow.shown && Chats.look == 2: ThreadB { }
    }
}
