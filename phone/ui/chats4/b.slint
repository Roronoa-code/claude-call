// PREVIEW (preview/chats-4) direction B, "Companion": the character is with you. At the top of the list the agent who
// matters right now stands on a soft floor and says where things stand (thinking about your message, has a question,
// just replied); the chats below are cards with their characters standing in them. Inside a chat the character
// stands beside the text box, by your thumb: it thinks while the PC works, talks as the answer comes in, hops when
// tapped. The agent's turns sit on cards; mine are warm bubbles.
import { T, Icon, Icons } from "../parts.slint";
import { Home } from "../home_parts.slint";
import { Chats, ChatRow, Ink, IconButton, BackButton } from "../chat.slint";
import { Figure, Bust } from "still.slint";
import { Shimmer, Look } from "msg.slint";
import { Log } from "log.slint";
import { Composer } from "field.slint";
import { SlideRow, UndoBar, Count } from "rows.slint";

global B {
    out property <Look> look: { me-bg: Ink.me, me-heading: false, prose: 16px, card: true, card-bg: #18181b, who: false };
    out property <color> row: #151518;
}

// A soft floor under a standing character: a dim warm pool, no beam.
component Floor inherits Rectangle {
    background: @radial-gradient(circle, #2a221f 0%, #1a1716 38%, #0e0e1000 70%);
}

export component ListB inherits Rectangle {
    background: Ink.bg;
    property <ChatRow> h: Chats.hero;
    property <bool> alive: h.id == Chats.live-row && Chats.live && h.id != "";
    Rectangle {
        y: Home.sat;
        height: 56px;
        BackButton { }
        // New chat: a warm round button (the picker grows out of it).
        Rectangle {
            x: parent.width - 60px;
            y: 6px;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: nb.pressed ? #9a4e36 : Ink.me;
            animate background { duration: 160ms; easing: T.out; }
            Icon { d: Icons.plus; x: 12px; y: 12px; stroke: #fff8f5; }
            nb := TouchArea { clicked => { Chats.picker = true; } }
        }
    }
    Flickable {
        y: Home.sat + 56px;
        width: parent.width;
        height: parent.height - self.y;
        content-height: list.preferred-height;
        flicked => { Chats.revealed = ""; }
        list := VerticalLayout {
            padding-bottom: Home.sab + 24px;
            // Who matters now, standing on the floor, and where things stand.
            if h.id != "": Rectangle {
                height: 196px;
                TouchArea { clicked => { Chats.from-y = parent.absolute-position.y; Chats.from-h = parent.height; Chats.open-chat(h.id); } }
                Floor { x: 4px; y: 128px; width: 170px; height: 56px; }
                Figure {
                    x: 10px;
                    y: 0;
                    width: 160px;
                    height: 166px;
                    face: h.face;
                    pose: h.busy ? "think" : h.unread ? "happy" : "idle";
                    k: 0.5; // faces.rs HERO_K
                    live: alive;
                    source: Chats.big-live;
                    lw: Chats.big-w;
                    lh: Chats.big-h;
                    th: Chats.big-th;
                }
                VerticalLayout {
                    x: 178px;
                    width: parent.width - 178px - 20px;
                    alignment: center;
                    spacing: 6px;
                    Text { text: h.name; font-size: 14px; font-weight: 600; color: h.busy || h.asks || h.unread ? Ink.warm : Ink.muted; overflow: elide; }
                    Text { text: Chats.hero-line; font-size: 21px; font-weight: 650; color: Ink.text; wrap: word-wrap; max-height: 3 * 26px; overflow: elide; }
                    if h.busy: Shimmer { text: "Thinking"; font-size: 14px; base: #8a8c93; }
                    if !h.busy: Text { text: h.time == "now" ? "Just now" : h.time + " ago"; font-size: 14px; color: Ink.muted; }
                }
            }
            Rectangle {
                height: 44px;
                Text { x: 20px; y: 8px; text: "Chats"; font-size: 22px; font-weight: 700; color: Ink.text; }
            }
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                // the others (the one standing at the top isn't repeated)
                for r in Chats.rows: SlideRow {
                    id: r.id;
                    face-h: r.id == root.h.id ? 0px : 76px;
                    gap: 6px;
                    visible: r.id != root.h.id;
                    face-bg: B.row;
                    radius: 22px;
                    margin: 12px;
                    tapped(y) => { Chats.from-y = y; Chats.from-h = 76px; Chats.open-chat(r.id); }
                    // the character standing in its card, feet on the card's floor line
                    Figure { x: 6px; y: 0; width: 62px; height: 66px; face: r.face; pose: r.busy ? "think" : "idle"; k: 0.21; }
                    Text {
                        x: 76px;
                        y: 14px;
                        width: parent.width - 76px - 72px;
                        height: 24px;
                        text: r.name;
                        font-size: 16.5px;
                        font-weight: r.unread ? 700 : 600;
                        color: Ink.text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - 72px;
                        y: 14px;
                        width: 58px;
                        height: 24px;
                        text: r.time;
                        font-size: 13px;
                        color: r.unread ? Ink.warm : Ink.muted;
                        font-weight: r.unread ? 600 : 400;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    if !r.busy: Text {
                        x: 76px;
                        y: 39px;
                        width: parent.width - 76px - (r.unread ? 52px : 16px);
                        height: 24px;
                        text: r.asks ? "Has a question for you" : r.preview;
                        font-size: 15px;
                        color: r.asks ? Ink.warm : r.unread ? Ink.text2 : Ink.muted;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    if r.busy: Shimmer { x: 76px; y: 39px; height: 24px; text: "Thinking"; base: #a08a80; vertical-alignment: center; }
                    if r.unread: Count { x: parent.width - self.width - 14px; y: 40px; n: max(1, r.count); }
                }
            }
        }
    }
    UndoBar { x: 16px; width: parent.width - 32px; base: parent.height - Home.sab - 16px; }
}

export component ThreadB inherits Rectangle {
    background: Ink.bg;
    property <length> bottom: self.height - max(Home.kb, Home.sab) - 10px;
    property <length> pal: Chats.readonly ? 0px : 76px; // the character's room beside the field
    log := Log {
        y: Home.sat + 60px;
        width: parent.width;
        height: parent.height - self.y;
        look: B.look;
        side: 14px;
        pad-bottom: Chats.readonly ? Home.sab + 28px : root.height - field.y + 18px;
        if Chats.action == "stop": Rectangle {
            property <float> k: 0;
            init => { self.k = 1; }
            animate k { duration: 420ms; easing: T.out; }
            height: 46px;
            opacity: k;
            Shimmer { x: 6px; y: 22px + (1 - parent.k) * 6px; text: Chats.short + " is thinking"; font-size: 14.5px; base: #8a8c93; }
        }
        if Chats.status != "" && Chats.action != "stop": HorizontalLayout {
            alignment: end;
            padding-top: 6px;
            Rectangle {
                width: note.preferred-width;
                height: 22px;
                note := Text {
                    text: Chats.status;
                    font-size: 13px;
                    color: Chats.action == "retry" ? #ec8a6f : Ink.muted;
                    font-weight: Chats.action == "retry" ? 600 : 400;
                    vertical-alignment: center;
                }
                TouchArea { enabled: Chats.action == "retry"; clicked => { Chats.retry(); } }
            }
        }
    }
    // A new chat: its character big in the middle, inviting the first message.
    VerticalLayout {
        property <length> top: Home.sat + 60px;
        property <length> room: field.y - 8px - self.top;
        x: 24px;
        width: parent.width - 48px;
        y: self.top + max(0px, (self.room - self.preferred-height) / 2) - (Chats.empty ? 0px : 16px);
        height: self.preferred-height;
        alignment: start;
        spacing: 4px;
        opacity: Chats.empty ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity, y { duration: 320ms; easing: T.out; }
        Rectangle {
            height: 170px;
            Floor { x: (parent.width - 220px) / 2; y: 130px; width: 220px; height: 52px; }
            Figure {
                x: 0;
                y: 0;
                width: parent.width;
                height: 158px;
                face: Chats.face;
                k: 0.7;
                live: Chats.live;
                source: Chats.big-live;
                lw: Chats.big-w;
                lh: Chats.big-h;
                th: Chats.big-th;
                TouchArea { enabled: Chats.empty; clicked => { Chats.poke(); } }
            }
        }
        Rectangle { height: 14px; }
        Text { text: "Say hi to " + Chats.short; font-size: 24px; font-weight: 700; color: Ink.text; horizontal-alignment: center; overflow: elide; }
        Text { text: "Your message goes to the PC."; font-size: 15px; color: Ink.muted; horizontal-alignment: center; }
    }
    // The header: back, the name (centred) and where things stand.
    Rectangle {
        y: 0;
        height: Home.sat + 60px;
        background: Ink.bg;
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Ink.hair;
            opacity: log.scrolled && !Chats.empty ? 1 : 0;
            animate opacity { duration: 200ms; }
        }
        Rectangle {
            y: Home.sat;
            height: 60px;
            BackButton { }
            Text {
                property <bool> alone: Chats.title == "" && !Chats.waiting;
                x: 60px;
                y: alone ? 0px : 9px;
                width: parent.width - 120px;
                height: alone ? 60px : 22px;
                text: Chats.name;
                font-size: 17px;
                font-weight: 650;
                color: Ink.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 60px;
                y: 31px;
                width: parent.width - 120px;
                height: 18px;
                text: Chats.waiting ? "Thinking…" : Chats.title;
                font-size: 13px;
                color: Chats.waiting || Chats.ask == "waiting" ? Ink.warm : Ink.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    Rectangle {
        visible: !Chats.readonly;
        y: field.y - 30px;
        height: parent.height - self.y;
        background: @linear-gradient(180deg, #0e0e1000 0%, #0e0e10 46%);
    }
    // The character, standing by the field (it rides up with the keyboard). A tap: a hop.
    if !Chats.readonly && !Chats.empty: Rectangle {
        x: 4px;
        y: field.y + field.height - self.height + 2px;
        width: 76px;
        height: 84px;
        Floor { x: 0; y: 58px; width: 76px; height: 26px; }
        Figure {
            x: 0;
            y: 0;
            width: parent.width;
            height: 74px;
            face: Chats.face;
            pose: Chats.waiting ? "think" : "idle";
            k: 0.26;
            live: Chats.live;
            source: Chats.face-live;
            lw: Chats.face-w;
            lh: Chats.face-h;
            th: Chats.face-th;
        }
        TouchArea { clicked => { Chats.poke(); } }
    }
    field := Composer {
        visible: !Chats.readonly;
        x: 8px + root.pal;
        width: parent.width - 20px - root.pal;
        y: root.bottom - self.height;
    }
    Rectangle {
        property <float> k: Chats.viewing ? 1 : 0;
        animate k { duration: Chats.viewing ? 340ms : 220ms; easing: Chats.viewing ? T.out : T.close; }
        visible: k > 0.01;
        background: black;
        opacity: k;
        TouchArea { clicked => { Chats.viewing = false; } }
        Image {
            y: Home.sat;
            width: parent.width;
            height: parent.height - Home.sat - Home.sab;
            source: Chats.full;
            image-fit: contain;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: 0.94 + 0.06 * parent.k;
        }
        Rectangle {
            x: 12px;
            y: Home.sat + 8px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: #1a1a1dcc;
            Icon { d: Icons.close; x: 10px; y: 10px; }
            TouchArea { clicked => { Chats.viewing = false; } }
        }
    }
}
