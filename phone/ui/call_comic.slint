// PREVIEW (branch preview/call-screen) direction 3, Comic: the call drawn as a comic panel. The caller stands on its
// record at the lower left and speaks in a big inked balloon whose tail points at it; the balloon grows and shrinks
// with each line. Your turn opens your own balloon at the right (its dots rise with your voice); while the caller
// works its balloon becomes a thought balloon trailing bubbles from its head, and on hold it thinks the hold. Ring
// marks spring from its head as it rings. The controls are inked buttons.
import { T, Icon, Icons, SwapText, Spoken } from "parts.slint";
import { Call } from "call_data.slint";
import { CapView, Sheets, RecordBack, Caller } from "call_kit.slint";

// An inked button: outlined; on = filled with the ink.
component Ink inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    width: 64px;
    height: 70px;
    Rectangle {
        x: 4px;
        y: 0;
        width: 56px;
        height: 48px;
        border-radius: 16px;
        background: root.on ? #efe7da : touch.pressed ? #efe7da1c : #efe7da08;
        border-width: 1.5px;
        border-color: root.on ? #efe7da : #efe7da5c;
        opacity: root.enabled ? 1 : 0.4;
        transform-origin: { x: 28px, y: 24px };
        transform-scale: touch.pressed && root.enabled ? 0.93 : 1;
        animate background, border-color { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        Icon { d: root.icon; x: 18px; y: 14px; width: 20px; height: 20px; stroke: root.on ? #17181c : #efe7da; animate stroke { duration: 200ms; } }
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
    Text {
        y: 52px;
        width: root.width;
        height: 16px;
        text: root.label;
        font-size: 11.5px;
        font-weight: 600;
        color: root.on ? #efe7da : #a9a39a;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 200ms; }
    }
}

export component ComicLook inherits Rectangle {
    background: #0a090c;
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> thinking: phase == "thinking";
    property <bool> thought: phase == "thinking" || phase == "hold"; // a thought balloon instead of speech
    property <bool> your-turn: phase == "listening" || phase == "hearing" || phase == "thinking";
    property <float> t: Call.t;
    property <color> ink: #efe7da;
    property <color> paper: #17181c;
    property <color> mine: #1f2c42;
    property <float> k: 0.85;
    property <length> fx: 172px;
    property <length> fy: Call.sat + 540px;
    property <length> head-x: root.fx + 4px; // the top of its head, for the tail, the bubbles and the ring marks
    property <length> head-y: root.fy - 124px;
    property <length> big-y: root.height - Call.sab - 14px - 58px;
    property <length> row-y: root.big-y - 86px;
    property <length> cw: (root.width - 24px) / 5;

    RecordBack { fx: root.fx; fy: root.fy; k: root.k; drawn-k: root.k; source: @image-url("stage/record-comic.png"); }
    Caller { fx: root.fx; fy: root.fy; }

    // Ring marks: three strokes spring out from either side of its head on each ring, and with its voice.
    for side in [-1, 1]: Rectangle {
        width: root.width;
        height: root.height;
        for j in 3: Path {
            property <float> p: root.incoming ? Math.mod(root.t / 1.5, 1) : 0;
            property <float> show: root.incoming ? Math.max(0, 1 - Math.abs(self.p - 0.25) * 3.2) : root.phase == "talking" ? Math.min(1, Call.level * 1.8) : 0;
            property <angle> a: (side < 0 ? 180deg : 0deg) + side * (j - 1) * 28deg - side * 8deg;
            property <length> r: 92px + 12px * self.show;
            x: root.head-x + self.r * Math.cos(self.a) - 12px;
            y: root.fy - 66px - self.r * Math.sin(self.a) * 0.75 - 12px;
            width: 24px;
            height: 24px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 6 12 L 18 12";
            stroke: root.ink;
            stroke-width: 2.4px;
            stroke-line-cap: round;
            transform-origin: { x: 12px, y: 12px };
            transform-rotation: -self.a;
            transform-scale: 0.6 + 0.4 * self.show;
            opacity: self.show;
        }
    }

    // ---- Header ----
    Text { x: 20px; y: Call.sat + 8px; height: 22px; text: Call.agent; font-size: 17px; font-weight: 700; color: T.fg; vertical-alignment: center; }
    SwapText { x: 20px; y: Call.sat + 31px; width: 220px; height: 18px; text: Call.time-text; key: Call.time-key; font-size: 13px; color: T.muted; }
    later := Rectangle {
        x: root.width - 18px - self.width;
        y: Call.sat + 10px;
        width: laterText.preferred-width + 26px;
        height: 36px;
        border-radius: 18px;
        border-width: 1.5px;
        border-color: #efe7da5c;
        background: laterTouch.pressed ? #efe7da1c : transparent;
        opacity: root.ended ? 0 : 1;
        animate opacity, background { duration: 200ms; easing: T.out; }
        laterText := Text { text: "Call back in 5 min"; font-size: 13px; font-weight: 600; color: root.ink; horizontal-alignment: center; vertical-alignment: center; }
        laterTouch := TouchArea { enabled: !root.ended; clicked => { Call.call-back(); } }
    }

    // ---- The caller's balloon: grows and shrinks with its line; a thought balloon while it works ----
    property <length> bx: 18px;
    property <length> b-bottom: root.head-y - (root.thought ? 104px : 46px); // a thought floats higher, on its bubbles
    animate b-bottom { duration: 420ms; easing: T.out; }
    property <length> bw: root.width - 36px;
    property <length> inner: root.bw - 40px;
    measure := VerticalLayout {
        x: 0;
        width: root.inner;
        visible: false;
        spacing: 8px;
        Text { text: "Label"; font-size: 12px; }
        Text {
            text: root.thinking ? "" : Call.cap.text;
            wrap: word-wrap;
            font-size: Call.typing || Call.cap.size == 2 ? 19px : Call.cap.size == 1 ? 23px : 28px;
            font-weight: 500;
            letter-spacing: -0.012 * (Call.typing || Call.cap.size == 2 ? 19px : Call.cap.size == 1 ? 23px : 28px);
        }
    }
    property <length> bh: root.thinking ? 64px : Math.min(root.b-bottom - Call.sat - 66px, measure.preferred-height + 34px);
    animate bh { duration: 360ms; easing: T.out; }
    balloon := Rectangle {
        x: root.bx;
        y: root.b-bottom - root.bh;
        width: root.bw;
        height: root.bh;
        border-radius: root.thought ? 32px : 24px;
        background: root.paper;
        border-width: 2px;
        border-color: root.ink;
        animate border-radius { duration: 360ms; easing: T.out; }
        clip: true;
        CapView {
            x: 20px;
            y: 15px;
            width: root.inner;
            height: parent.height - 15px;
            hide: root.thinking;
            hide-dy: 0;
            s0: 28px;
            s1: 23px;
            s2: 19px;
            small: Call.typing;
            label-size: 12px;
            gap: 8px;
            talk-label: #f0a27e;
            lit-color: #fff7ec;
            dim-color: #efe7da45;
        }
        // thinking: beads that fill one by one, like a line being thought
        HorizontalLayout {
            x: 20px;
            y: 0;
            height: 64px;
            spacing: 10px;
            alignment: start;
            opacity: root.thinking ? 1 : 0;
            animate opacity { duration: 260ms; delay: root.thinking ? 120ms : 0ms; easing: T.out; }
            Text { text: Call.agent + " is thinking"; font-size: 16px; font-weight: 600; color: root.ink; vertical-alignment: center; }
            for i in 3: Rectangle {
                property <float> on: Math.mod(root.t * 1.6 - i * 0.28, 1.4) < 0.7 ? 1 : 0;
                width: 9px;
                Rectangle {
                    y: 28px - 3px * parent.on;
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    border-width: 1.5px;
                    border-color: root.ink;
                    background: parent.on > 0 ? root.ink : transparent;
                    animate y { duration: 220ms; easing: T.out; }
                    animate background { duration: 160ms; }
                }
            }
        }
    }
    // The speech tail: from the balloon's bottom to its head. A filled wedge hides the balloon's edge where they join.
    property <length> tail-x: root.head-x - 34px;
    property <length> tail-top: root.b-bottom - 2px;
    property <float> tail-h: (root.head-y - 8px - root.tail-top) / 1px;
    for part in 2: Path {
        x: root.tail-x;
        y: root.tail-top;
        width: 40px;
        height: root.tail-h * 1px;
        viewbox-width: 40;
        viewbox-height: root.tail-h;
        commands: "M 2 0 L 30 " + root.tail-h + " L 32 0" + (part == 0 ? " Z" : "");
        fill: part == 0 ? root.paper : transparent;
        stroke: part == 0 ? transparent : root.ink;
        stroke-width: 2px;
        stroke-line-join: round;
        opacity: root.thought ? 0 : 1;
        animate opacity { duration: 200ms; }
    }
    // The thought bubbles: three rising from its head to the balloon
    for i in 3: Rectangle {
        property <length> d: 10px + i * 6px;
        property <float> f: (i + 1) / 4;
        x: root.head-x + 14px - self.d / 2 + 44px * self.f * self.f;
        y: root.head-y - 8px - (root.head-y - 8px - root.tail-top) * self.f - self.d / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: root.paper;
        border-width: 2px;
        border-color: root.ink;
        opacity: root.thought ? 1 : 0;
        transform-origin: { x: self.d / 2, y: self.d / 2 };
        transform-scale: root.thought ? 1 : 0.2;
        animate opacity { duration: 200ms; delay: root.thought ? i * 90ms : 0ms; }
        animate transform-scale { duration: 420ms; delay: root.thought ? i * 90ms : 0ms; easing: T.spring; }
    }

    // ---- Your balloon: open while it's your turn; your words, or dots that rise with your voice ----
    property <length> mw: Math.min(212px, mine-measure.preferred-width + 32px);
    mine-measure := Text { text: Call.me-text == "" ? "......" : Call.me-text; font-size: 18px; font-weight: 500; visible: false; width: 0; }
    mine-text-measure := VerticalLayout {
        width: root.mw - 32px;
        visible: false;
        Text { text: Call.me-text; wrap: word-wrap; font-size: 18px; font-weight: 500; }
    }
    property <length> mh: Call.me-text == "" ? 52px : mine-text-measure.preferred-height + 28px;
    you := Rectangle {
        x: root.width - 18px - root.mw;
        y: root.row-y - 58px - root.mh;
        width: root.mw;
        height: root.mh;
        animate width, height, y { duration: 360ms; easing: T.out; }
        opacity: root.your-turn ? 1 : 0;
        transform-origin: { x: self.width, y: self.height };
        transform-scale: root.your-turn ? 1 : 0.6;
        animate opacity { duration: root.your-turn ? 260ms : 160ms; easing: T.out; }
        animate transform-scale { duration: root.your-turn ? 480ms : 220ms; easing: root.your-turn ? T.spring : T.close; }
        Rectangle {
            border-radius: 22px;
            background: root.mine;
            border-width: 2px;
            border-color: #a9c4ff;
            clip: true;
            if Call.me-text != "": Text {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                text: Call.me-text;
                wrap: word-wrap;
                font-size: 18px;
                font-weight: 500;
                color: #f4f7ff;
            }
            if Call.me-text == "": HorizontalLayout {
                alignment: center;
                spacing: 8px;
                for i in 3: Rectangle {
                    width: 9px;
                    Rectangle {
                        y: 22px - Call.me-level * 9px * (0.6 + 0.4 * Math.sin((root.t * 8.3 + i * 1.7) * 1rad));
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: #a9c4ff;
                        opacity: Call.me-live ? 1 : 0.35 + 0.65 * (0.5 + 0.5 * Math.cos((root.t * 5.7 - i * 0.86) * 1rad));
                    }
                }
            }
        }
        // its tail points down and right, at you
        for part in 2: Path {
            x: you.width - 46px;
            y: you.height - 2px;
            width: 30px;
            height: 22px;
            viewbox-width: 30;
            viewbox-height: 22;
            commands: part == 0 ? "M 0 0 L 26 21 L 18 0 Z" : "M 0 0 L 26 21 L 18 0";
            fill: part == 0 ? root.mine : transparent;
            stroke: part == 0 ? transparent : #a9c4ff;
            stroke-width: 2px;
            stroke-line-join: round;
        }
    }

    // ---- The mic's line ----
    SwapText {
        x: 16px;
        y: root.row-y - 30px;
        width: root.width - 32px;
        height: 20px;
        text: Call.status;
        font-size: 13.5px;
        color: #c9c3b8;
        align: center;
        visible: !Call.typing;
    }

    // ---- The inked buttons ----
    for i in 5: Ink {
        x: 12px + root.cw * (i + 0.5) - self.width / 2;
        y: root.row-y + (root.incoming ? 30px : 0);
        icon: i == 0 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.speaker-off : i == 2 ? Icons.speaker : i == 3 ? Icons.captions : Icons.keyboard;
        label: i == 0 ? (Call.muted ? "Unmute" : "Mute") : i == 1 ? "Quiet" : i == 2 ? "Speaker" : i == 3 ? "Captions" : "Type";
        on: i == 0 ? Call.muted : i == 1 ? Call.quiet : i == 2 ? Call.speaker : i == 3 ? Call.caps-open : Call.typing;
        enabled: !root.incoming && !root.ended && !Call.typing;
        opacity: root.incoming || root.ended || Call.typing ? 0 : 1;
        animate y { duration: root.incoming ? 300ms : 560ms; delay: root.incoming ? 0ms : i * 35ms; easing: root.incoming ? T.close : T.spring; }
        animate opacity { duration: 220ms; delay: root.incoming ? 0ms : i * 35ms; easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-mute(); }
            else if (i == 1) { Call.toggle-quiet(); }
            else if (i == 2) { Call.toggle-speaker(); }
            else if (i == 3) { Call.caps-open = !Call.caps-open; }
            else { Call.typing = !Call.typing; }
        }
    }

    // ---- Hang up (Decline) and Done talking (Answer) ----
    Rectangle {
        x: 16px;
        y: root.big-y;
        width: 126px;
        height: 58px;
        border-radius: 18px;
        background: endTouch.pressed ? #c23a3f : #e5484d;
        border-width: 2px;
        border-color: #f7c9c3;
        opacity: root.ended ? 0 : 1;
        transform-origin: { x: 63px, y: 29px };
        transform-scale: endTouch.pressed ? 0.95 : 1;
        animate background { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        animate opacity { duration: 240ms; easing: T.out; }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Icon { d: Icons.phone; y: 18px; width: 22px; height: 22px; stroke: white; transform-origin: { x: 11px, y: 11px }; transform-rotation: 135deg; }
            endMeasure := Text { text: root.incoming ? "Decline" : "Hang up"; font-size: 15px; font-weight: 700; visible: false; width: 0; }
            SwapText { width: endMeasure.preferred-width + 2px; height: 58px; text: root.incoming ? "Decline" : "Hang up"; font-size: 15px; weight: 700; color: white; }
        }
        endTouch := TouchArea { enabled: !root.ended; clicked => { Call.hang-up(); } }
    }
    pill := Rectangle {
        property <bool> live: root.incoming || Call.can-finish;
        x: 154px;
        y: root.big-y;
        width: root.width - 16px - self.x;
        height: 58px;
        opacity: root.ended ? 0 : 1;
        animate opacity { duration: 240ms; easing: T.out; }
        // while it rings: the button shakes on each ring, like a ringing bell in a comic
        property <float> shake: root.incoming ? Math.max(0, 1 - Math.mod(root.t / 1.5, 1) * 3) : 0;
        Rectangle {
            border-radius: 18px;
            background: root.incoming ? (pillTouch.pressed ? #27924a : #2fa84f) : pill.live ? (pillTouch.pressed ? #c4664a : T.accent) : #efe7da08;
            border-width: 2px;
            border-color: root.incoming ? #bdf0cc : pill.live ? #ffd9c7 : #efe7da5c;
            transform-origin: { x: self.width / 2, y: 29px };
            transform-rotation: 3deg * pill.shake * Math.sin(root.t * 40rad);
            transform-scale: pillTouch.pressed && pill.live ? 0.96 : 1;
            animate background, border-color { duration: 260ms; easing: T.out; }
            animate transform-scale { duration: 160ms; easing: T.out; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    width: 20px;
                    for g in [{ d: Icons.phone, show: root.incoming }, { d: Icons.check, show: !root.incoming }]: Icon {
                        d: g.d;
                        y: 19px;
                        width: 20px;
                        height: 20px;
                        stroke: pill.live ? white : #a9a39a;
                        opacity: g.show ? 1 : 0;
                        transform-origin: { x: 10px, y: 10px };
                        transform-scale: g.show ? 1 : 0.6;
                        transform-rotation: g.show ? 0deg : -40deg;
                        animate opacity { duration: 180ms; }
                        animate transform-scale, transform-rotation { duration: 500ms; easing: T.spring; }
                    }
                }
                measure2 := Text { text: root.incoming ? "Answer" : "Done talking"; font-size: 15px; font-weight: 700; visible: false; width: 0; }
                SwapText { width: measure2.preferred-width + 2px; height: 58px; text: root.incoming ? "Answer" : "Done talking"; font-size: 15px; weight: 700; color: pill.live ? white : #a9a39a; }
            }
            pillTouch := TouchArea {
                enabled: pill.live;
                clicked => { if (root.incoming) { Call.answer(); } else { Call.done-talking(); } }
            }
        }
    }

    Sheets {
        width: root.width;
        height: root.height;
        caps-x: 12px + root.cw * 3.5 - 28px;
        caps-y: root.row-y;
        type-x: 12px + root.cw * 4.5 - 28px;
        type-y: root.row-y;
        fsize: 48px;
        keep: root.height - root.row-y - Call.sab + 12px;
        lift: 96px;
    }
}
