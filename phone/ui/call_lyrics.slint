// PREVIEW (branch preview/call-screen) direction 4, Lyrics: the call reads like a song's lyrics in a music player.
// The caller stands small at the top on its record, like the record now playing, with its name and the call's clock
// under it as the title. The whole conversation scrolls under it as lyrics: the caller's lines light word by word as
// they're said, yours sit at the right in blue, older lines fade upward. Your turn, thinking and hold are lines of
// their own (your dots, beats that light in turn, a lilac hold line). The controls are a player's: a big round
// Answer / Done talking in the middle with Mute, Quiet, Speaker and Type round it, and Call back in 5 min, Transcript
// and Hang up under them.
import { T, Icon, Icons, SwapText, Spoken } from "parts.slint";
import { Call } from "call_data.slint";
import { Sheets, RecordBack, Caller } from "call_kit.slint";

// A transport key: a round key with its name under it.
component Key inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked;
    width: 64px;
    height: 74px;
    Rectangle {
        x: 6px;
        y: 0;
        width: 52px;
        height: 52px;
        border-radius: 26px;
        background: root.on ? #f2f2f3 : touch.pressed ? #2c2e33 : #1d1e22;
        opacity: root.enabled ? 1 : 0.4;
        transform-origin: { x: 26px, y: 26px };
        transform-scale: touch.pressed && root.enabled ? 0.92 : 1;
        animate background { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 160ms; easing: T.out; }
        Icon { d: root.icon; x: 16px; y: 16px; width: 20px; height: 20px; stroke: root.on ? #111214 : T.fg; animate stroke { duration: 200ms; } }
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
    Text { y: 57px; width: root.width; height: 16px; text: root.label; font-size: 12px; color: T.fg2; horizontal-alignment: center; vertical-alignment: center; }
}

// A pill under the transport: icon and name.
component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> on;
    in property <color> bg: #1d1e22;
    in property <color> fg: T.fg2;
    in property <angle> turn;
    callback clicked;
    height: 46px;
    border-radius: 23px;
    background: root.on ? #f2f2f3 : touch.pressed ? root.bg.brighter(0.25) : root.bg;
    transform-origin: { x: self.width / 2, y: 23px };
    transform-scale: touch.pressed ? 0.95 : 1;
    animate background { duration: 200ms; easing: T.out; }
    animate transform-scale { duration: 160ms; easing: T.out; }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        Icon { d: root.icon; y: 14px; width: 18px; height: 18px; stroke: root.on ? #111214 : root.fg; transform-origin: { x: 9px, y: 9px }; transform-rotation: root.turn; }
        Text { text: root.label; font-size: 13px; font-weight: 600; color: root.on ? #111214 : root.fg; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component LyricsLook inherits Rectangle {
    background: #0a090c;
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> your-turn: phase == "listening" || phase == "hearing";
    property <float> t: Call.t;
    property <color> cool: #a9c4ff;
    property <color> lilac: #c9b6ff;
    property <float> k: 0.6;
    property <length> fx: root.width / 2;
    property <length> fy: Call.sat + 186px;
    property <length> keys-y: root.height - Call.sab - 70px - 92px;
    property <length> chips-y: root.height - Call.sab - 14px - 46px;
    property <length> top: Call.sat + 300px; // the lyrics
    // above the controls, or above the reply field while typing
    property <length> bottom: Call.typing ? root.height - Call.kb - max(12px, Call.sab + 96px - Call.kb) - Call.field-h - 12px : root.keys-y - 40px;
    property <int> n: Call.msgs.length;
    // a line of its own at the end: the call's caption while it rings, connects, holds or ends, or before any line
    property <bool> cap-line: root.incoming || root.phase == "connecting" || root.phase == "hold" || root.ended || root.n == 0;
    property <bool> hold: root.phase == "hold"; // its line is already in the lyrics: only "On hold · 0:12" and slow beats

    RecordBack { fx: root.fx; fy: root.fy; k: root.k; drawn-k: root.k; source: @image-url("stage/record-lyrics.png"); }
    Caller { fx: root.fx; fy: root.fy; }

    // ---- The title: who, and how long ----
    Text { y: root.fy + 52px; width: root.width; height: 22px; text: Call.agent; font-size: 17px; font-weight: 700; color: T.fg; horizontal-alignment: center; vertical-alignment: center; }
    SwapText { y: root.fy + 75px; width: root.width; height: 18px; text: Call.time-text; key: Call.time-key; font-size: 13px; color: T.muted; align: center; }

    // ---- The lyrics ----
    lyrics := Flickable {
        x: 0;
        y: root.top;
        width: root.width;
        height: root.bottom - root.top;
        content-height: whole.preferred-height;
        content-y: Math.min(0px, self.height - whole.preferred-height);
        animate content-y { duration: 420ms; easing: T.out; }
        // a short song sits a little above the middle; a long one scrolls, its latest line at the bottom
        whole := VerticalLayout {
            width: root.width;
            padding-top: Math.max(24px, (lyrics.height - rows.preferred-height) * 0.42);
            animate padding-top { duration: 420ms; easing: T.out; } // a new line glides the song up, never jumps it
            rows := VerticalLayout {
                width: root.width;
                padding-left: 26px;
                padding-right: 26px;
                padding-bottom: 6px;
                spacing: 16px;
                for m[i] in Call.msgs: HorizontalLayout {
                    property <bool> last: i >= root.n - 1;
                    alignment: m.me ? end : start;
                    // older lines dim, and fade out as they scroll up past the top
                    opacity: (i >= root.n - 2 && !root.cap-line ? 1 : 0.34) * Math.max(0, Math.min(1, (self.y + whole.padding-top + lyrics.content-y) / 56px));
                    animate opacity { duration: 420ms; easing: T.out; }
                    if !m.me: Spoken {
                        text: m.text;
                        lit: m.lit;
                        font-size: 23px;
                        weight: 500;
                        tracking: -0.012;
                    }
                    if m.me: Text {
                        max-width: (root.width - 52px) * 0.82;
                        text: m.text;
                        wrap: word-wrap;
                        font-size: 19px;
                        font-weight: 500;
                        color: root.cool;
                        horizontal-alignment: right;
                    }
                }
                // your words as you say them
                if root.phase == "hearing" && Call.me-text != "": HorizontalLayout {
                    alignment: end;
                    Text { max-width: (root.width - 52px) * 0.82; text: Call.me-text; wrap: word-wrap; font-size: 19px; font-weight: 500; color: root.cool; horizontal-alignment: right; }
                }
                // your turn: your dots, rising with your voice
                if root.your-turn && Call.me-text == "": HorizontalLayout {
                    alignment: end;
                    height: 26px;
                    spacing: 7px;
                    for i in 3: Rectangle {
                        width: 9px;
                        Rectangle {
                            y: 9px - Call.me-level * 8px * (0.6 + 0.4 * Math.sin((root.t * 8.3 + i * 1.7) * 1rad));
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: root.cool;
                            opacity: Call.me-live ? 1 : 0.35 + 0.65 * (0.5 + 0.5 * Math.cos((root.t * 5.7 - i * 0.86) * 1rad));
                        }
                    }
                }
                // thinking: beats that light in turn, like words of a line not yet said
                if Call.show-pending && root.phase == "thinking": HorizontalLayout {
                    alignment: start;
                    height: 28px;
                    spacing: 10px;
                    for i in 4: Rectangle {
                        property <float> lit: Math.max(0, 1 - Math.abs(Math.mod(root.t * 1.3, 1.6) - i * 0.3 - 0.15) * 3.2);
                        width: 22px;
                        Rectangle {
                            y: 11px;
                            width: 22px;
                            height: 6px;
                            border-radius: 3px;
                            background: #f2f2f3;
                            opacity: 0.18 + 0.82 * parent.lit;
                        }
                    }
                }
                // ringing, connecting, on hold, the end: the caption as the last line
                if root.cap-line: VerticalLayout {
                    spacing: 8px;
                    Text {
                        height: 18px;
                        text: Call.cap.label;
                        font-size: 13px;
                        font-weight: 650;
                        letter-spacing: 0.26px;
                        color: Call.cap.tone == "hold" ? root.lilac : Call.cap.tone == "dim" || Call.cap.tone == "rest" ? T.muted : #e7a084;
                        vertical-alignment: center;
                    }
                    if !root.hold: Spoken { text: Call.cap.text; lit: Call.cap.lit; font-size: 23px; weight: 500; tracking: -0.012; }
                    if root.hold: HorizontalLayout {
                        alignment: start;
                        height: 20px;
                        spacing: 10px;
                        for i in 4: Rectangle {
                            property <float> lit: Math.max(0, 1 - Math.abs(Math.mod(root.t * 0.5, 1.6) - i * 0.3 - 0.15) * 3.2);
                            width: 22px;
                            Rectangle { y: 7px; width: 22px; height: 6px; border-radius: 3px; background: root.lilac; opacity: 0.2 + 0.8 * parent.lit; }
                        }
                    }
                }
            }
        }
    }

    // ---- The mic's line ----
    SwapText {
        x: 16px;
        y: root.keys-y - 26px;
        width: root.width - 32px;
        height: 18px;
        text: Call.status;
        font-size: 13px;
        color: T.muted;
        align: center;
        visible: !Call.typing;
    }

    // ---- The transport ----
    property <length> mid: root.width / 2;
    for i in 4: Key {
        x: root.mid + (i < 2 ? -1 : 1) * (i == 0 || i == 3 ? 150px : 82px) - self.width / 2;
        y: root.keys-y + 12px + (root.incoming ? 24px : 0);
        icon: i == 0 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.speaker-off : i == 2 ? Icons.speaker : Icons.keyboard;
        label: i == 0 ? (Call.muted ? "Unmute" : "Mute") : i == 1 ? "Quiet" : i == 2 ? "Speaker" : "Type";
        on: i == 0 ? Call.muted : i == 1 ? Call.quiet : i == 2 ? Call.speaker : Call.typing;
        enabled: !root.incoming && !root.ended && !Call.typing;
        opacity: root.incoming || root.ended || Call.typing ? 0 : 1;
        animate y { duration: root.incoming ? 300ms : 560ms; delay: root.incoming ? 0ms : Math.abs(i - 1.5) * 50ms; easing: root.incoming ? T.close : T.spring; }
        animate opacity { duration: 220ms; easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-mute(); }
            else if (i == 1) { Call.toggle-quiet(); }
            else if (i == 2) { Call.toggle-speaker(); }
            else { Call.typing = !Call.typing; }
        }
    }
    big := Rectangle {
        property <bool> live: root.incoming || Call.can-finish;
        x: root.mid - 38px;
        y: root.keys-y;
        width: 76px;
        height: 92px;
        opacity: root.ended || Call.typing ? 0 : 1;
        animate opacity { duration: 220ms; easing: T.out; }
        if root.incoming: Rectangle {
            property <float> p: Math.mod(root.t, 1.5) / 1.5;
            x: -18px * self.p;
            y: -18px * self.p;
            width: 76px + 36px * self.p;
            height: self.width;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: #3ccf6a.with-alpha(0.6 * (1 - self.p));
        }
        Rectangle {
            y: 0;
            width: 76px;
            height: 76px;
            border-radius: 38px;
            background: root.incoming ? (bigTouch.pressed ? #27924a : #2fa84f) : big.live ? (bigTouch.pressed ? #c4664a : T.accent) : #26282d;
            transform-origin: { x: 38px, y: 38px };
            transform-scale: bigTouch.pressed && big.live ? 0.94 : 1;
            animate background { duration: 260ms; easing: T.out; }
            animate transform-scale { duration: 160ms; easing: T.out; }
            for g in [{ d: Icons.phone, show: root.incoming }, { d: Icons.check, show: !root.incoming }]: Icon {
                d: g.d;
                x: 24px;
                y: 24px;
                width: 28px;
                height: 28px;
                stroke: big.live ? white : #7d8088;
                opacity: g.show ? 1 : 0;
                transform-origin: { x: 14px, y: 14px };
                transform-scale: g.show ? 1 : 0.6;
                transform-rotation: g.show ? 0deg : -40deg;
                animate opacity { duration: 180ms; }
                animate transform-scale, transform-rotation { duration: 500ms; easing: T.spring; }
            }
            bigTouch := TouchArea {
                enabled: big.live;
                clicked => { if (root.incoming) { Call.answer(); } else { Call.done-talking(); } }
            }
        }
        SwapText {
            x: -40px;
            y: 76px;
            width: 156px;
            height: 16px;
            text: root.incoming ? "Answer" : "Done talking";
            font-size: 12px;
            color: T.fg2;
            align: center;
        }
    }

    // ---- Call back in 5 min, Transcript, Hang up ----
    Chip {
        x: 16px;
        y: root.chips-y;
        width: 112px;
        icon: Icons.later;
        label: "In 5 min";
        opacity: root.incoming || root.ended ? 0 : 1;
        animate opacity { duration: 220ms; easing: T.out; }
        clicked => { if (!root.incoming && !root.ended) { if (!Call.asking-back) { Call.call-back(); } } }
    }
    Chip {
        x: 136px;
        y: root.chips-y;
        width: 124px;
        icon: Icons.captions;
        label: "Transcript";
        on: Call.caps-open;
        opacity: root.incoming || root.ended ? 0 : 1;
        animate opacity { duration: 220ms; easing: T.out; }
        clicked => { if (!root.incoming && !root.ended) { Call.caps-open = !Call.caps-open; } }
    }
    Chip {
        x: root.incoming ? root.width / 2 - 70px : 268px;
        y: root.chips-y;
        width: root.incoming ? 140px : root.width - 16px - 268px;
        icon: Icons.phone;
        turn: 135deg;
        label: root.incoming ? "Decline" : "Hang up";
        bg: #e5484d;
        fg: white;
        opacity: root.ended ? 0 : 1;
        animate x, width { duration: 520ms; easing: T.spring; }
        animate opacity { duration: 220ms; easing: T.out; }
        clicked => { if (!root.ended) { Call.hang-up(); } }
    }

    Sheets {
        width: root.width;
        height: root.height;
        caps-x: 136px + 62px - 23px;
        caps-y: root.chips-y;
        type-x: root.mid + 150px - 26px;
        type-y: root.keys-y + 12px;
        fsize: 52px;
        caps-size: 46px;
        keep: root.height - root.keys-y - Call.sab + 12px;
        lift: 96px;
    }
}
