import { T, Icon, Icons, SwapText } from "parts.slint";
import { Call } from "call_data.slint";
import { Sheets } from "call_kit.slint";
import { Spot, SpotBack, SpotCap, Dots, Glyph, Pill, SpotCaller } from "call_spot.slint";

export component CameraLook inherits Rectangle {
    property <string> phase: Call.phase;
    property <bool> incoming: phase == "incoming";
    property <bool> ended: phase == "ended";
    property <bool> yours: (phase == "hearing" || phase == "thinking") && Call.me-text != "";
    property <length> W: root.width;
    property <length> H: root.height;
    property <length> field-top: H - Call.kb - Math.max(12px, Call.sab + 96px - Call.kb) - Call.field-h;
    property <bool> keys: Call.typing && Call.kb > 0;
    property <float> k: Call.face-k;
    property <float> close: Math.max(0, Math.min(1, (root.k - 0.62) / (1.15 - 0.62)));
    property <length> fy0: H * (0.53 + 0.07 * root.close);
    property <length> by: H - Call.sab - 96px;
    property <length> words-top0: H * 0.7;
    property <length> dy: keys ? Math.max(0px, root.fy0 + 24px - (field-top - 120px)) : 0px;
    property <length> fy: round((root.fy0 - root.dy) / 1phx) * 1phx;
    property <length> fx: W / 2;

    SpotBack { width: W; height: H; fx: root.fx; fy: root.fy; k: root.k; drawn-k: 0.62; bw: 440px; bh: 1120px; above: 640px; source: @image-url("stage/spot-camera.png"); }
    SpotCaller { fx: root.fx; fy: root.fy; }

    Text { x: 24px; y: Call.sat + 12px; height: 20px; text: Call.agent; font-size: 15px; font-weight: 600; color: T.fg; vertical-alignment: center; }
    SwapText { x: 24px; y: Call.sat + 33px; width: 240px; height: 18px; text: Call.time-text; key: Call.time-key; font-size: 12.5px; color: T.muted; }

    property <length> words-top: keys ? field-top - 116px : root.words-top0;
    property <length> words-bottom: keys ? field-top - 12px : root.by - 18px;
    property <string> label: Call.notice != "" ? Call.notice.to-uppercase()
        : incoming ? "INCOMING CALL" : phase == "connecting" ? "CONNECTING" : phase == "talking" ? Call.agent.to-uppercase()
        : phase == "listening" ? "YOUR TURN" : phase == "hearing" ? "YOU" : phase == "thinking" ? (Call.agent + " is thinking").to-uppercase()
        : phase == "hold" ? Call.cap.label.to-uppercase() : Call.cap.label;
    Rectangle {
        x: 24px;
        y: root.words-top;
        width: W - 48px;
        height: root.words-bottom - root.words-top;
        opacity: root.more ? 0 : 1;
        animate y, height { duration: 300ms; easing: T.out; }
        animate opacity { duration: 260ms; easing: T.out; }
        lmeasure := Text { text: root.label; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; visible: false; }
        SwapText {
            y: 0;
            width: parent.width;
            height: 16px;
            text: root.label;
            key: phase == "hold" ? "hold" : root.label;
            font-size: 11px;
            weight: 600;
            tracking: 1.6px;
            color: Call.notice != "" ? #e8a08a : phase == "hold" ? Spot.hold : phase == "listening" || phase == "hearing" ? Spot.label-cool : Spot.label;
        }
        Dots {
            x: lmeasure.preferred-width + 5px;
            y: 10px;
            opacity: phase == "thinking" && Call.notice == "" ? 1 : 0;
            animate opacity { duration: 300ms; }
        }
        SpotCap {
            y: 26px;
            width: parent.width;
            height: parent.height - 26px;
            hide: root.yours;
            small: root.keys;
            s0: 25px;
            s1: 21px;
            s2: 18px;
            align: left;
            rest-opacity: 0.55;
        }
        Text {
            y: 26px;
            width: parent.width;
            height: parent.height - 26px;
            text: Call.me-text;
            wrap: word-wrap;
            font-size: root.keys ? 19px : 24px;
            font-italic: true;
            color: Spot.cool;
            vertical-alignment: top;
            opacity: root.yours ? (phase == "thinking" ? 0.62 : 1) : 0;
            animate opacity { duration: 320ms; delay: root.yours ? 120ms : 0ms; easing: T.out; }
        }
    }

    property <bool> more <=> Call.more;
    property <length> step: Math.min(84px, (W - 32px) / 4.6);
    property <length> mid: root.by + 32px;
    for i in 4: Glyph {
        property <int> at: i == 0 ? -2 : i == 1 ? -1 : i == 2 ? 1 : 2;
        x: W / 2 + self.at * root.step - self.width / 2;
        y: root.mid - 13px;
        glow: true;
        icon: i == 0 ? (Call.muted ? Icons.mic-off : Icons.mic) : i == 1 ? Icons.speaker-off : i == 2 ? Icons.captions
            : (root.more ? Icons.close : "M5 12h0.01 M12 12h0.01 M19 12h0.01");
        label: i == 0 ? (Call.muted ? "Muted" : "Mute") : i == 1 ? (Call.quiet ? "Quiet on" : "Quiet") : i == 2 ? "Transcript" : (root.more ? "Close" : "More");
        on: i == 0 ? Call.muted : i == 1 ? Call.quiet : i == 2 ? Call.caps-open : false;
        enabled: !root.incoming && !root.ended && self.opacity > 0.9;
        opacity: root.incoming || root.ended || root.keys ? 0 : 1;
        animate opacity { duration: 240ms; delay: root.incoming ? 0ms : 140ms + 50ms * Math.abs(self.at); easing: T.out; }
        clicked => {
            if (i == 0) { Call.toggle-mute(); }
            else if (i == 1) { Call.toggle-quiet(); }
            else if (i == 2) { Call.caps-open = !Call.caps-open; root.more = false; }
            else { root.more = !root.more; }
        }
    }
    for j in 3: Glyph {
        property <bool> shown: root.more && !root.ended && !root.keys;
        x: W / 2 + (j - 1) * root.step - self.width / 2;
        y: root.mid - 13px - 70px + (self.shown ? 0 : 12px);
        glow: true;
        icon: j == 0 ? Icons.speaker : j == 1 ? Icons.keyboard : Icons.later;
        label: j == 0 ? "Speaker" : j == 1 ? "Type" : "In 5 min";
        on: j == 0 ? Call.speaker : j == 1 ? Call.typing : false;
        enabled: self.shown;
        opacity: self.shown ? 1 : 0;
        animate y { duration: self.shown ? 520ms : 220ms; delay: self.shown ? (2 - j) * 45ms : 0ms; easing: self.shown ? T.spring : T.close; }
        animate opacity { duration: self.shown ? 280ms : 160ms; delay: self.shown ? (2 - j) * 45ms : 0ms; easing: T.out; }
        clicked => {
            if (j == 0) { Call.toggle-speaker(); }
            else if (j == 1) { Call.typing = !Call.typing; root.more = false; }
            else { if (!Call.asking-back) { Call.call-back(); } }
        }
    }

    Pill {
        x: (root.incoming ? W / 2 - root.step : W / 2) - 32px;
        y: root.by;
        width: 64px;
        height: 64px;
        icon: Icons.phone;
        turn: true;
        fill: Spot.red;
        enabled: !root.ended && !root.keys;
        opacity: root.ended || root.keys ? 0 : 1;
        animate x { duration: 520ms; easing: T.spring; }
        animate opacity { duration: 260ms; easing: T.out; }
        clicked => { Call.hang-up(); }
    }
    Pill {
        x: W / 2 + root.step - 32px;
        y: root.by;
        width: 64px;
        height: 64px;
        icon: Icons.phone;
        fill: Spot.green;
        enabled: root.incoming;
        opacity: root.incoming ? 1 : 0;
        transform-origin: { x: 32px, y: 32px };
        transform-scale: root.incoming ? 1 : 0.6;
        animate opacity { duration: 200ms; easing: T.out; }
        animate transform-scale { duration: 300ms; easing: T.close; }
        clicked => { Call.answer(); }
    }
    for side in 2: Text {
        x: W / 2 + (side == 0 ? -1 : 1) * root.step - 50px;
        y: root.by + 70px;
        width: 100px;
        height: 16px;
        text: side == 0 ? "Decline" : "Answer";
        font-size: 11px;
        color: #ebe5dc99;
        horizontal-alignment: center;
        opacity: root.incoming ? 1 : 0;
        animate opacity { duration: 200ms; }
    }

    Sheets {
        width: W;
        height: H;
        caps-x: W / 2 + root.step - 22px;
        caps-y: root.mid - 22px;
        type-x: W / 2 - 22px;
        type-y: root.mid - 70px - 22px;
        fsize: 44px;
        keep: H - (root.mid - 30px) - Call.sab;
        lift: 96px;
    }
    changed phase => { if (root.ended) { root.more = false; } }
}
