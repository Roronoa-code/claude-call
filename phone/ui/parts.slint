// Text that changes crossfades in place: the old line rises out as the new one rises in.
// Each of the two slots is below (waiting), shown, or above (gone); "above -> below" is instant.
export component SwapText {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <color> color: T.fg2;
    in property <TextHorizontalAlignment> align: left;
    in property <int> weight: 400;
    in property <TextWrap> wrap: no-wrap;
    in property <TextVerticalAlignment> valign: center;
    // Set: only a new key swaps; other text changes (a ticking clock) just update the shown line.
    in property <string> key;
    property <string> a;
    property <string> b;
    property <int> pa: 1; // 0 below, 1 shown, 2 above
    property <int> pb: 0;
    property <string> shown-key;
    init => { a = text; shown-key = key; }
    function swap() {
        shown-key = key;
        if (pa == 1) { b = text; pb = 0; pb = 1; pa = 2; } else { a = text; pa = 0; pa = 1; pb = 2; }
    }
    changed text => {
        if (key == "") { swap(); } else if (key == shown-key) { if (pa == 1) { a = text; } else { b = text; } }
    }
    changed key => { swap(); }
    for slot in [0, 1]: Text {
        property <int> p: slot == 0 ? root.pa : root.pb;
        width: parent.width;
        height: parent.height;
        text: slot == 0 ? root.a : root.b;
        font-size: root.font-size;
        font-weight: root.weight;
        color: root.color;
        horizontal-alignment: root.align;
        vertical-alignment: root.valign;
        wrap: root.wrap;
        opacity: p == 1 ? 1 : 0;
        y: p == 0 ? 6px : p == 1 ? 0 : -6px;
        animate opacity, y {
            duration: p == 0 ? 0ms : p == 1 ? 280ms : 140ms;
            delay: p == 1 ? 112ms : 0ms;
            easing: p == 1 ? T.out : T.close;
        }
    }
}

// A line of Claude's: every word laid out from the start (so it never reflows), the spoken part lit.
// Greedy word wrap of a prefix breaks exactly where the whole line does, so the lit copy lines up.
export component Spoken inherits VerticalLayout {
    in property <string> text;
    in property <string> lit;
    in property <length> font-size: 16.5px;
    in property <int> weight: 400;
    in property <color> lit-color: T.fg;
    in property <color> dim-color: T.unlit;
    in property <bool> hide-unsaid: false;
    in property <float> tracking: 0; // letter spacing, in em
    // The whole line sits in the layout (so wrapping sets its height); the lit copy is drawn on top of it.
    full := Text {
        text: root.text;
        wrap: word-wrap;
        font-size: root.font-size;
        font-weight: root.weight;
        letter-spacing: root.tracking * root.font-size;
        color: root.hide-unsaid ? transparent : root.dim-color;
        vertical-alignment: top;
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.lit;
            wrap: word-wrap;
            font-size: root.font-size;
            font-weight: root.weight;
            letter-spacing: root.tracking * root.font-size;
            color: root.lit-color;
            vertical-alignment: top;
            animate color { duration: 220ms; easing: T.out; }
        }
    }
}

// The voice glow: soft coloured light rising from the bottom edge with the level of whoever is talking.
// A handful of radial gradients; it only moves while someone talks.
export component Glow {
    in property <float> level;
    in property <float> t;
    in property <bool> on: true;
    property <float> lv: on ? level : 0;
    for blob in [
        { c: #ff4fa3, x: 0.18, w: 0.62, s: 0.9, ph: 0.0 },
        { c: #8a5cff, x: 0.38, w: 0.7, s: 1.15, ph: 1.7 },
        { c: #2ad1c9, x: 0.62, w: 0.66, s: 1.0, ph: 3.1 },
        { c: #ffb347, x: 0.82, w: 0.58, s: 0.85, ph: 4.4 },
        { c: #4f8bff, x: 0.5, w: 0.9, s: 1.3, ph: 2.3 },
    ]: Rectangle {
        property <length> w: root.width * blob.w * (1 + 0.45 * root.lv);
        property <float> rise: 0.32 + 3 * root.lv * blob.s;
        width: w;
        height: w;
        x: root.width * (blob.x + 0.06 * Math.sin((root.t * 0.35 + blob.ph) * 1rad)) - w / 2;
        y: root.height - w / 2;
        transform-origin: { x: w / 2, y: w / 2 };
        transform-scale-y: rise * 0.62;
        opacity: (0.42 + 0.58 * Math.min(1, root.lv * 2.2)) * 0.9;
        background: @radial-gradient(circle, blob.c.with-alpha(0.85) 0%, blob.c.with-alpha(0.35) 35%, blob.c.with-alpha(0) 70%);
        animate opacity { duration: 240ms; }
    }
}

// The thinking orb: a little dotted globe that turns while Claude works (or waits on hold).
export component Orb {
    in property <float> t;
    in property <color> c: #e7a084;
    width: 20px;
    height: 20px;
    for i in 25: Rectangle {
        property <int> dy: Math.floor(i / 5) - 2;
        property <int> dx: Math.mod(i, 5) - 2;
        property <float> r: Math.sqrt(dy * dy + dx * dx) / 2.6;
        property <float> spin: 0.5 + 0.5 * Math.sin((root.t * 2.4 + dx * 0.9 - dy * 0.4) * 1rad);
        visible: r <= 1;
        width: 2.2px;
        height: 2.2px;
        border-radius: 1.1px;
        x: 10px + dx * 3.6px - 1.1px;
        y: 10px + dy * 3.6px - 1.1px;
        background: root.c;
        opacity: (1 - r * 0.55) * (0.35 + 0.65 * spin);
    }
}

// A round control: icon over a label; pressed = light fill.
export component Round {
    in property <string> icon;
    in property <string> label;
    in property <bool> pressed;
    in property <bool> enabled: true;
    in property <bool> faded;
    in property <bool> dot; // something new (a small accent dot at the top right)
    in property <color> label-color: #e8e9ec;
    in property <length> size: 64px;
    callback clicked;
    VerticalLayout {
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            circle := Rectangle {
                width: root.size;
                height: root.size;
                border-radius: root.size / 2;
                background: root.pressed ? T.btn-on : T.btn;
                opacity: root.faded ? 0 : root.enabled ? 1 : 0.4;
                transform-origin: { x: root.size / 2, y: root.size / 2 };
                transform-scale: touch.pressed && root.enabled ? 0.93 : 1;
                animate background { duration: 200ms; easing: T.out; }
                animate transform-scale { duration: 160ms; easing: T.out; }
                animate opacity { duration: 120ms; }
                Icon {
                    d: root.icon;
                    stroke: root.pressed ? #111 : T.fg;
                    animate stroke { duration: 200ms; }
                }
                if root.dot: Rectangle { x: root.size - 22px; y: 8px; width: 12px; height: 12px; border-radius: 6px; background: T.accent; }
                touch := TouchArea {
                    enabled: root.enabled && !root.faded;
                    clicked => { root.clicked(); }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                opacity: root.faded ? 0 : 1;
                animate opacity { duration: 160ms; }
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text { text: root.label; font-size: 13px; color: root.label-color; vertical-alignment: center; }
                }
            }
        }
    }
}

// A surface that grows out of the button that opened it and goes back into it: it starts as exactly the button,
// springs open, and closes back without a bounce. The button's face fades as the contents fade in.
export component Morph {
    in property <bool> open;
    in property <length> fx; // the button, in the morph's parent's coordinates
    in property <length> fy;
    in property <length> fsize: 64px;
    in property <length> tx;
    in property <length> ty;
    in property <length> tw;
    in property <length> th;
    in property <length> radius: 24px;
    in property <string> face;
    in property <color> panel: T.btn;
    // One value from shut (0, exactly the button) to open (1), so shape, place and corners always move together
    // and closing always lands back in the button, from wherever it was.
    property <float> k: open ? 1 : 0;
    animate k { duration: open ? 500ms : 300ms; easing: open ? T.spring : T.close; }
    // The spring's overshoot settles in place: a full-width sheet pushed past its spot ran off the screen's edges.
    property <float> g: Math.min(1, k);
    visible: open || k > 0.002; // visible at once when opening, so its text field can take focus
    x: fx + (tx - fx) * g;
    y: fy + (ty - fy) * g;
    width: fsize + (tw - fsize) * g;
    height: fsize + (th - fsize) * g;
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: root.fsize / 2 + (root.radius - root.fsize / 2) * root.g;
        background: root.panel;
        clip: true;
        // The button's face fades as the contents fade in.
        Icon {
            d: root.face;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: Math.max(0, 1 - root.k * 4);
        }
        // The contents stay where they will be once open, and only show once the surface is nearly full size (and
        // go first when closing), so no cut-off words show while it grows or shrinks.
        Rectangle {
            x: root.tx - root.x;
            y: root.ty - root.y;
            width: root.tw;
            height: root.th;
            opacity: Math.max(0, Math.min(1, (root.g - 0.85) * 6.7));
            TouchArea { } // a tap on the surface stays on it (never reaches what is behind)
            @children
        }
    }
}

