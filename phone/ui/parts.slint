export component SwapText {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <color> color: T.fg2;
    in property <TextHorizontalAlignment> align: left;
    in property <int> weight: 400;
    in property <TextWrap> wrap: no-wrap;
    in property <TextVerticalAlignment> valign: center;
    in property <length> tracking;
    in property <string> key;
    property <string> a;
    property <string> b;
    property <int> pa: 1;
    property <int> pb: 0;
    property <string> shown-key;
    init => { a = text; shown-key = key; }
    function swap() {
        shown-key = key;
        if (pa == 1) { b = text; pb = 0; pb = 1; pa = 2; } else { a = text; pa = 0; pa = 1; pb = 2; }
    }
    changed text => {
        if (key == "") { swap(); } else if (key == shown-key) { if (pa == 1) { a = text; } else { b = text; } }
    }
    changed key => { swap(); }
    for slot in [0, 1]: Text {
        property <int> p: slot == 0 ? root.pa : root.pb;
        width: parent.width;
        height: parent.height;
        text: slot == 0 ? root.a : root.b;
        font-size: root.font-size;
        font-weight: root.weight;
        letter-spacing: root.tracking;
        color: root.color;
        horizontal-alignment: root.align;
        vertical-alignment: root.valign;
        wrap: root.wrap;
        opacity: p == 1 ? 1 : 0;
        y: p == 0 ? 6px : p == 1 ? 0 : -6px;
        animate opacity, y {
            duration: p == 0 ? 0ms : p == 1 ? 280ms : 140ms;
            delay: p == 1 ? 112ms : 0ms;
            easing: p == 1 ? T.out : T.close;
        }
    }
}

export component Spoken inherits VerticalLayout {
    in property <string> text;
    in property <string> lit;
    in property <length> font-size: 16.5px;
    in property <int> weight: 400;
    in property <color> lit-color: T.fg;
    in property <color> dim-color: T.unlit;
    in property <bool> hide-unsaid: false;
    in property <float> tracking: 0;
    full := Text {
        text: root.text;
        wrap: word-wrap;
        font-size: root.font-size;
        font-weight: root.weight;
        letter-spacing: root.tracking * root.font-size;
        color: root.hide-unsaid ? transparent : root.dim-color;
        vertical-alignment: top;
        Text {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.lit;
            wrap: word-wrap;
            font-size: root.font-size;
            font-weight: root.weight;
            letter-spacing: root.tracking * root.font-size;
            color: root.lit-color;
            vertical-alignment: top;
            animate color { duration: 220ms; easing: T.out; }
        }
    }
}

export component Morph {
    in property <bool> open;
    in property <length> fx;
    in property <length> fy;
    in property <length> fsize: 64px;
    in property <length> fw: fsize;
    in property <length> fh: fsize;
    in property <length> fradius: Math.min(fw, fh) / 2;
    in property <length> tx;
    in property <length> ty;
    in property <length> tw;
    in property <length> th;
    in property <length> radius: 24px;
    in property <string> face;
    in property <color> panel: T.btn;
    in property <color> from: panel;
    in property <bool> zoom: true;
    property <float> k: open ? 1 : 0;
    animate k { duration: open ? 500ms : 300ms; easing: open ? T.spring : T.close; }
    out property <float> g: Math.min(1, k);
    out property <bool> shown: open || k > 0.002;
    visible: shown;
    x: fx + (tx - fx) * g;
    y: fy + (ty - fy) * g;
    width: fw + (tw - fw) * g;
    height: fh + (th - fh) * g;
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: root.fradius + (root.radius - root.fradius) * root.g;
        background: root.panel.mix(root.from, root.g);
        opacity: root.zoom ? 1 : Math.min(1, root.g * 5);
        clip: true;
        Icon {
            d: root.face;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            opacity: Math.max(0, 1 - root.k * 4);
        }
        Rectangle {
            x: root.tx - root.x;
            y: root.ty - root.y;
            width: root.tw;
            height: root.th;
            transform-origin: { x: root.fx + root.fw / 2 - root.tx, y: root.fy + root.fh / 2 - root.ty };
            transform-scale: root.zoom ? Math.min(root.width / root.tw, root.height / root.th) : 1;
            opacity: Math.max(0, Math.min(1, root.zoom ? (root.g - 0.12) * 3 : (root.g - 0.2) * 5));
            TouchArea { }
            @children
        }
    }
}

