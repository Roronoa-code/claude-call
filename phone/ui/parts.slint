// Building blocks of the call screen: colours, icons, crossfading text, Claude's spoken lines, the voice glow,
// the thinking orb, round controls, and surfaces that grow out of their button.

// The big caption. `lit` is the part already spoken (the start of `text`); key changes swap it with a crossfade.
export struct Cap { key: int, label: string, text: string, lit: string, size: int, tone: string, orb: bool }
// A transcript row.
export struct Msg { me: bool, text: string, lit: string }

export global T {
    out property <color> bg: #111214;
    out property <color> fg: #f2f2f3;
    out property <color> fg2: #c9cbd1;
    out property <color> muted: #9a9ca3;
    out property <color> accent: #d97757;
    out property <color> ok: #2fa84f;
    out property <color> me: #2f4f7a;
    out property <color> btn: #26282d;
    out property <color> btn-on: #ececee;
    out property <color> unlit: #f2f2f347;
    // Liquid: a spring-like ease for opening, a sine for closing, ease-out for the rest.
    out property <easing> spring: cubic-bezier(0.2, 1.1, 0.3, 1);
    out property <easing> out: cubic-bezier(0.16, 1, 0.3, 1);
    out property <easing> close: cubic-bezier(0.33, 0, 0.3, 1);
}

export component Icon inherits Path {
    in property <string> d;
    width: 24px;
    height: 24px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    fill: transparent;
    stroke: T.fg;
    stroke-width: 2px;
    stroke-line-cap: round;
}

