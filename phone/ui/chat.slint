import { T, Icon, Icons } from "parts.slint";
import { Home } from "home_parts.slint";
import { Actor } from "actor.slint";
import "fonts/JetBrainsMonoNL-Regular.ttf";

export struct ChatRow { id: string, name: string, face: string, preview: string, time: string, unread: bool, busy: bool, asks: bool,
    choices: [string], topic: string, count: int, head: string,
    draft: string, think: string,
    mine-last: bool }
export struct ChatMsg {
    me: bool,
    text: string,
    kind: string,
    pic: image,
    ratio: float,
    path: string,
    body: styled-text,
    mark: string,
    level: int,
    gap: float,
    n: int,
    anchor: bool,
    last: bool,
    line: string,
    links: bool,
    link: string,
}

export global Ink {
    out property <color> bg: #0e0e10;
    out property <color> surface: #1a1a1d;
    out property <color> raised: #232327;
    out property <color> hair: #ffffff14;
    out property <color> text: #ececee;
    out property <color> text2: #b9bac0;
    out property <color> muted: #8a8c93;
    out property <color> me: #b05a3f;
    out property <color> warm: #e3a48c;
}

export global Chats {
    in property <[ChatRow]> rows;
    in property <[ChatMsg]> msgs;
    in property <image> full;
    in-out property <bool> viewing;
    in property <string> name;
    in property <string> short;
    in property <string> title;
    in property <string> hint: "Message";
    in property <string> ask;
    in property <[string]> ghosts;
    in property <bool> readonly;
    callback choose(choice: string);
    in property <string> face: "clawd";
    in property <bool> empty;
    in property <bool> waiting;
    in property <int> replies;
    in property <bool> live: true;
    in property <image> face-live;
    in property <int> face-w;
    in property <int> face-h;
    in property <int> face-th;
    in property <image> big-live;
    in property <int> big-w;
    in property <int> big-h;
    in property <int> big-th;
    callback poke();
    in property <string> think;
    in property <string> thinking;
    in property <string> ended;
    in-out property <string> trouble;
    in property <string> status;
    in property <string> action;
    in property <bool> ready: true;
    in property <bool> unread;
    in property <string> pick;
    in property <image> pick-pic;
    in property <string> pick-text;
    in-out property <bool> open;
    in-out property <string> current;
    in-out property <length> from-y: Home.sat + 116px;
    in-out property <length> from-h: 78px;
    in-out property <string> from-id;
    in-out property <length> fx;
    in-out property <length> fy;
    in-out property <length> fw;
    in-out property <length> fh;
    in-out property <float> fk;
    in-out property <float> open-k;
    in-out property <bool> flying;
    in-out property <bool> held;
    callback tick();
    callback open-link(url: string);
    in-out property <bool> picker;
    in-out property <bool> want-focus;
    callback open-chat(id: string);
    callback new-chat(agent: string, model: string);
    callback send-composed(text: string, preedit: string, cursor-byte: int) -> bool;
    in property <string> draft;
    callback keep-draft(chat: string, text: string);
    pure callback room(text: string) -> int;
    callback copy(line: string, mine: bool, piece: int);
    callback again(line: string);
    callback refetch(url: string);
    callback clear-field();
    callback stop();
    callback retry(id: string);
    callback attach();
    callback unpick();
    callback open-media(path: string, kind: string);
    callback sharpen();
    in-out property <string> revealed;
    in-out property <string> leaving;
    in-out property <string> returning;
    in property <string> deleted;
    callback delete-chat(id: string);
    callback undo();
    in property <string> live-row;
    in property <ChatRow> hero;
    in property <string> hero-line;
    public function back() -> bool {
        if (viewing) { viewing = false; return true; }
        if (picker) { picker = false; return true; }
        if (revealed != "") { revealed = ""; return true; }
        if (current != "") { current = ""; Home.typing = false; return true; }
        if (open) { open = false; return true; }
        return false;
    }
}

export component IconButton {
    in property <string> icon;
    in property <brush> stroke: Ink.text;
    in property <string> label;
    callback clicked;
    width: 48px;
    height: 48px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: touch.pressed ? #ffffff14 : #ffffff00;
        animate background { duration: 160ms; easing: T.out; }
    }
    Icon { d: root.icon; x: 12px; y: 12px; stroke: root.stroke; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component BackButton inherits IconButton {
    x: 4px;
    y: 6px;
    icon: Icons.back;
    label: "Back";
    clicked => { Chats.back(); }
}

export component NewChat {
    VerticalLayout {
        padding: 10px;
        padding-top: 14px;
        spacing: 6px;
        Text { x: 8px; text: "New chat"; font-size: 14px; font-weight: 600; color: Ink.muted; }
        HorizontalLayout {
            spacing: 4px;
            for a in [
                { face: "haiku", name: "Haiku", agent: "claude", model: "haiku-5.5" },
                { face: "sonnet", name: "Sonnet", agent: "claude", model: "sonnet-5.5" },
                { face: "opus", name: "Opus", agent: "claude", model: "opus-5.5" },
                { face: "null", name: "Codex", agent: "codex", model: "" },
            ]: Rectangle {
                height: 118px;
                border-radius: 18px;
                background: tile.pressed ? #ffffff12 : #ffffff00;
                animate background { duration: 160ms; easing: T.out; }
                Actor { y: -8px; height: 96px; face: a.face; k: a.face == "null" ? 0.3 : 0.33; }
                Text {
                    y: 90px;
                    width: parent.width;
                    text: a.name;
                    font-size: 15px;
                    font-weight: 600;
                    color: Ink.text;
                    horizontal-alignment: center;
                }
                tile := TouchArea {
                    clicked => {
                        Chats.picker = false;
                        Chats.from-y = root.absolute-position.y;
                        Chats.from-h = 166px;
                        Chats.from-id = "";
                        Chats.new-chat(a.agent, a.model);
                        Chats.want-focus = true;
                    }
                }
            }
        }
    }
}
