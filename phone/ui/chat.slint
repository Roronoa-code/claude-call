// In-app chats with the agents on the PC: the Chats screen (a list, and one chat's thread) and the new-chat picker.
// Everything here appears instantly for now; its motion is still to be picked.
import { T, Icon, Icons } from "parts.slint";
import { Home } from "home_parts.slint";

export struct ChatRow { id: string, name: string, preview: string, time: string, unread: bool }
// One bubble. kind: "" text, "note" a grey line about a file (downloading, couldn't load), "image" or "video" a
// thumbnail (pic, with ratio = height / width) that opens the file at path when tapped.
export struct ChatMsg { me: bool, text: string, kind: string, pic: image, ratio: float, path: string }

export global Chats {
    in property <[ChatRow]> rows; // newest first
    in property <[ChatMsg]> msgs; // the open chat's bubbles
    in property <image> full; // the photo open full screen
    in-out property <bool> viewing; // ...while this is true
    in property <string> name; // the open chat's agent
    in property <string> title; // ...and what it is about
    in property <string> status; // the small grey line under my last message
    in property <string> action; // what tapping it does: "retry" or "stop"
    in property <bool> ready: true; // false until the PC has set chat up
    in property <bool> unread; // any chat has something new
    in-out property <bool> open; // the Chats screen
    in-out property <string> current; // the open chat's id ("" = the list)
    in-out property <bool> picker; // the new-chat picker
    in-out property <bool> want-focus; // put the cursor in the field once it is on screen
    callback open-chat(string);
    callback new-chat(string, string); // agent, model
    callback send(string);
    callback retry();
    callback open-media(string, string); // path, kind: a photo opens full screen here, a video in the video player
    // Back steps out one level: photo, picker, thread, Chats screen. False when there is nothing left to close.
    public function back() -> bool {
        if (viewing) { viewing = false; return true; }
        if (picker) { picker = false; return true; }
        if (current != "") { current = ""; Home.editing(false); return true; }
        if (open) { open = false; return true; }
        return false;
    }
}

// The round arrow at the left of both headers.
component BackButton inherits Rectangle {
    x: 6px;
    y: 6px;
    width: 48px;
    height: 48px;
    Icon { d: Icons.back; x: 12px; y: 12px; }
    TouchArea { clicked => { Chats.back(); } }
}

// The chats, newest first.
export component ChatList inherits Rectangle {
    Rectangle {
        y: Home.sat;
        height: 60px;
        BackButton { }
        Text { x: 66px; text: "Chats"; font-size: 17px; font-weight: 700; color: T.fg; vertical-alignment: center; height: parent.height; }
        Rectangle {
            x: parent.width - 54px; // the picker grows out of here
            y: 6px;
            width: 48px;
            height: 48px;
            Icon { d: Icons.plus; x: 12px; y: 12px; }
            TouchArea { clicked => { Chats.picker = true; } }
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: #2a2c31; }
    }
    if Chats.rows.length == 0: Text {
        y: Home.sat + 60px + 48px;
        width: parent.width;
        text: "No chats yet.\nTap + to start one.";
        font-size: 15px;
        color: T.muted;
        horizontal-alignment: center;
    }
    Flickable {
        y: Home.sat + 61px;
        width: parent.width;
        height: parent.height - self.y;
        content-height: list.preferred-height + Home.sab;
        list := VerticalLayout {
            for r in Chats.rows: Rectangle {
                height: 72px;
                background: touch.pressed ? #26282d : transparent;
                Text { x: 20px; y: 14px; width: parent.width - 108px; text: r.name; font-size: 16px; font-weight: 600; color: T.fg; overflow: elide; }
                Text { x: 20px; y: 40px; width: parent.width - 108px; text: r.preview; font-size: 14px; color: r.unread ? T.fg2 : T.muted; overflow: elide; }
                Text { x: parent.width - 80px; y: 16px; width: 60px; text: r.time; font-size: 12px; color: T.muted; horizontal-alignment: right; }
                if r.unread: Rectangle { x: parent.width - 30px; y: 44px; width: 10px; height: 10px; border-radius: 5px; background: T.accent; }
                Rectangle { x: 20px; y: parent.height - 1px; width: parent.width - 40px; height: 1px; background: #2a2c31; }
                touch := TouchArea { clicked => { Chats.open-chat(r.id); } }
            }
        }
    }
}

// One chat: its bubbles (the same shape and colours as the call transcript), the status line, and the field.
export component ChatThread inherits Rectangle {
    property <string> draft;
    property <length> field-y: self.height - max(Home.kb, Home.sab) - 12px - 64px; // 12px above the keyboard
    function send() {
        if (draft != "") { Chats.send(draft); draft = ""; }
    }
    Rectangle {
        y: Home.sat;
        height: 60px;
        BackButton { }
        Text { x: 66px; y: Chats.title == "" ? 0px : 9px; width: parent.width - 80px; text: Chats.name; font-size: 17px; font-weight: 700; color: T.fg; vertical-alignment: Chats.title == "" ? center : top; height: Chats.title == "" ? parent.height : 24px; overflow: elide; }
        if Chats.title != "": Text { x: 66px; y: 33px; width: parent.width - 80px; text: Chats.title; font-size: 12px; color: T.muted; overflow: elide; }
        Rectangle { y: parent.height - 1px; height: 1px; background: #2a2c31; }
    }
    // Sticks to the bottom: the newest bubble stays in view as bubbles arrive or the keyboard comes up.
    log := Flickable {
        y: Home.sat + 61px;
        width: parent.width;
        height: root.field-y - 8px - self.y;
        content-height: rows.preferred-height;
        property <length> bottom: Math.min(0px, self.height - rows.preferred-height);
        init => { self.content-y = self.bottom; }
        changed bottom => { self.content-y = self.bottom; }
        rows := VerticalLayout {
            width: parent.width;
            padding: 16px;
            spacing: 12px;
            for m in Chats.msgs: HorizontalLayout {
                alignment: m.me ? end : start;
                // A photo or video: the bubble's shape filled by the picture, as wide as a long text bubble.
                // Shown whole: as wide as allowed, narrower for a tall one so it stays under 360px high.
                if m.kind == "image" || m.kind == "video": Rectangle {
                    width: max(140px, min((root.width - 32px) * 0.72, 360px / max(m.ratio, 0.01)));
                    height: max(100px, min(360px, self.width * m.ratio));
                    background: #202227;
                    border-top-left-radius: 20px;
                    border-top-right-radius: 20px;
                    border-bottom-left-radius: m.me ? 20px : 6px;
                    border-bottom-right-radius: m.me ? 6px : 20px;
                    clip: true;
                    Image { width: parent.width; height: parent.height; source: m.pic; image-fit: cover; }
                    if m.kind == "video": Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: #000000a6;
                        Path {
                            x: 21px;
                            y: 17px;
                            width: 20px;
                            height: 22px;
                            viewbox-width: 20;
                            viewbox-height: 22;
                            commands: "M2 2 L18 11 L2 20 Z";
                            fill: white;
                        }
                    }
                    TouchArea { clicked => { Chats.open-media(m.path, m.kind); } }
                }
                if m.kind != "image" && m.kind != "video": Rectangle {
                    max-width: (root.width - 32px) * 0.8;
                    background: m.me ? T.me : #202227;
                    border-top-left-radius: 20px;
                    border-top-right-radius: 20px;
                    border-bottom-left-radius: m.me ? 20px : 6px;
                    border-bottom-right-radius: m.me ? 6px : 20px;
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        Text { text: m.text; wrap: word-wrap; font-size: 16.5px; color: m.me ? white : m.kind == "note" ? T.muted : T.fg; }
                    }
                }
            }
            if Chats.status != "": HorizontalLayout {
                alignment: end;
                spacing: 12px;
                Rectangle {
                    width: note.preferred-width;
                    height: 20px;
                    note := Text { text: Chats.status; font-size: 13px; color: T.muted; vertical-alignment: center; }
                    TouchArea { enabled: Chats.action == "retry"; clicked => { Chats.retry(); } }
                }
                if Chats.action == "stop": Rectangle {
                    width: stop-label.preferred-width;
                    height: 20px;
                    stop-label := Text { text: "Stop"; font-size: 13px; font-weight: 600; color: T.accent; vertical-alignment: center; }
                    TouchArea { clicked => { Chats.send("stop"); } }
                }
            }
        }
    }
    Rectangle {
        x: 16px;
        y: root.field-y;
        width: parent.width - 32px;
        height: 64px;
        border-radius: 32px;
        background: T.btn;
        if !Chats.ready: Text {
            width: parent.width;
            height: parent.height;
            text: "Chat isn't set up on the PC yet";
            font-size: 15px;
            color: T.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if Chats.ready: HorizontalLayout {
            padding-left: 20px;
            padding-right: 8px;
            spacing: 4px;
            // Back (the system key) reaches the screen even while the cursor is in the field.
            FocusScope {
                // Takes the room left by the send button and never grows with long text (it pushed the button off).
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                // Focus once the field is on screen (Android won't raise the keyboard for a field still clipped away).
                Timer { interval: 220ms; running: Chats.want-focus; triggered => { Chats.want-focus = false; input.focus(); } }
                key-pressed(e) => {
                    if (e.text == Key.Back && Chats.back()) { return accept; }
                    reject
                }
                input := TextInput {
                    width: parent.width;
                    height: parent.height;
                    text <=> root.draft;
                    font-size: 17px;
                    color: T.fg;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => { root.send(); }
                    changed has-focus => { Home.editing(self.has-focus); }
                    Text {
                        x: 0;
                        width: parent.width;
                        visible: root.draft == "";
                        text: "Message";
                        font-size: 17px;
                        color: #8c8f97;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
            }
            Rectangle {
                width: 48px;
                height: 48px;
                y: 8px;
                border-radius: 24px;
                background: root.draft != "" ? T.accent : transparent;
                Icon { d: Icons.send; x: 12px; y: 12px; stroke: root.draft != "" ? white : T.muted; }
                TouchArea { enabled: root.draft != ""; clicked => { root.send(); } }
            }
        }
    }
    // A photo full screen; a tap or Back closes it.
    if Chats.viewing: Rectangle {
        background: black;
        TouchArea { clicked => { Chats.viewing = false; } }
        Image {
            y: Home.sat;
            width: parent.width;
            height: parent.height - Home.sat - Home.sab;
            source: Chats.full;
            image-fit: contain;
        }
        BackButton { y: Home.sat + 6px; }
    }
}

// A row of the new-chat picker.
export component PickRow {
    in property <string> title;
    callback clicked;
    height: 56px;
    Rectangle {
        border-radius: 18px;
        background: touch.pressed ? #3a3c42 : #31333a;
    }
    Text { x: 18px; text: root.title; font-size: 16px; font-weight: 600; color: T.fg; vertical-alignment: center; height: parent.height; }
    touch := TouchArea { clicked => { root.clicked(); } }
}
