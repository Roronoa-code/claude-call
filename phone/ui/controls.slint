// PREVIEW (branch preview/home-controls-2, not for main): round two of the home controls (the contact-mode selector,
// the status line and the four actions), picked at run time with `adb shell setprop debug.callme.controls <n>` and a
// restart of the app (0, or unset: the pills and round buttons as they shipped). Same functions and states in all four.
// Each draws its block (status, modes, setup card) from block-y, under the pair, and its actions at the bottom;
// home.slint keeps the room for them (Ctl) and grows the Widget and Chats sheets out of their buttons.
// No props, no metaphors: type, spacing, one quiet material, hairlines, and the approved "shrink out, grow in".
import { T, Icon, Icons } from "parts.slint";
import { Home, Mode, SetupCard } from "home_parts.slint";
import { Toys } from "toys.slint";
import { Chats } from "chat.slint";

export global Ctl {
    out property <int> v: Toys.controls;
    out property <length> setup: Home.ready ? 0px : 112px; // the setup card and the gap over it
    // The block's height under the pair, and the actions' room above the bottom inset.
    out property <length> block-h: (v == 1 ? 194px : v == 2 ? 0px : v == 3 ? 0px : 144px) + setup;
    out property <length> act-h: v == 1 ? 84px : v == 2 ? 256px : v == 3 ? 210px : 124px;
    out property <string> call-label: Home.requested ? "Calling you…" : Home.caller == "codex" ? "Call Codex" : "Call Claude";
    out property <string> title: Home.ready ? Home.current.title : "Almost ready";
    out property <string> desc: Home.ready ? Home.current.desc : "A few phone settings first, then they can call.";
    out property <color> night: #aa9dff;
    // Warm graphite, the one material: a recessed track, a raised face, a hairline.
    out property <color> well: #121212;
    out property <color> face: #2b2a29;
    out property <color> line: #ffffff14;
    out property <color> dim: #8e8e93; // a label not chosen
    // A sheet grown out of an action covers the modes: they fade out under it, so no sliver of them shows round it.
    out property <bool> sheet: Home.widgets || Home.channel;
    // 3 Sheet: the mode list is open (Back and a tap outside close it).
    in-out property <bool> open;
    // The four actions, as the shipped round buttons do them.
    public function act(i: int) {
        if (i == 0) {
            Home.test-ring();
        } else if (i == 1) {
            Home.widgets = !Home.widgets && !Home.channel;
            Home.channel = false;
            Home.editing(false);
        } else if (i == 2) {
            Home.widgets = false;
            Home.channel = false;
            Home.editing(false);
            Chats.open = true;
        } else if (!Home.requested) {
            Home.call(Home.caller);
        }
    }
    public pure function mode(i: int) -> Mode {
        return i < 4 ? Home.modes[i] : Home.sleep-modes[i - 4];
    }
}

// Text that crossfades when it changes (as SwapText), wrapped onto balanced lines: a line too long for `max` is set
// at about half its length, so a second line never holds one lone word.
export component SwapLines {
    in property <string> text;
    in property <length> font-size: 14.5px;
    in property <int> weight: 400;
    in property <color> color: T.muted;
    in property <length> max: self.width;
    in property <bool> centre: true;
    in property <length> spacing: 0px; // letter spacing
    property <string> a;
    property <string> b;
    property <int> pa: 1; // 0 below, 1 shown, 2 above
    property <int> pb: 0;
    init => { a = text; }
    changed text => {
        if (pa == 1) { b = text; pb = 0; pb = 1; pa = 2; } else { a = text; pa = 0; pa = 1; pb = 2; }
    }
    for slot in [0, 1]: Rectangle {
        property <int> p: slot == 0 ? root.pa : root.pb;
        property <length> one: m.preferred-width;
        property <length> w: self.one <= root.max ? root.max : min(root.max, self.one / 2 + 28px);
        m := Text { visible: false; text: slot == 0 ? root.a : root.b; font-size: root.font-size; font-weight: root.weight; letter-spacing: root.spacing; }
        x: root.centre ? (root.width - self.w) / 2 : 0px;
        y: p == 0 ? 6px : p == 1 ? 0 : -6px;
        width: self.w;
        height: root.height;
        opacity: p == 1 ? 1 : 0;
        animate opacity, y {
            duration: p == 0 ? 0ms : p == 1 ? 280ms : 140ms;
            delay: p == 1 ? 112ms : 0ms;
            easing: p == 1 ? T.out : T.close;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: m.text;
            font-size: root.font-size;
            font-weight: root.weight;
            letter-spacing: root.spacing;
            color: root.color;
            wrap: word-wrap;
            vertical-alignment: top;
            horizontal-alignment: root.centre ? center : left;
        }
    }
}

// The status: what the mode means, title over a line or two.
export component Status inherits Rectangle {
    in property <bool> centre: true;
    in property <length> title-size: 24px;
    in property <length> desc-size: 14.5px;
    in property <length> desc-max: 330px;
    height: self.title-size * 1.3 + 6px + 40px;
    SwapLines {
        y: 0;
        width: parent.width;
        height: root.title-size * 1.3;
        max: parent.width;
        text: Ctl.title;
        font-size: root.title-size;
        weight: 600;
        spacing: -0.2px;
        color: T.fg;
        centre: root.centre;
    }
    SwapLines {
        y: root.title-size * 1.3 + 6px;
        width: parent.width;
        height: 40px;
        max: root.desc-max;
        font-size: root.desc-size;
        text: Ctl.desc;
        centre: root.centre;
    }
}

// A segmented track of modes first .. first + count - 1. The chosen one sits on a raised graphite face that slides
// to it; when the choice moves to the other track the face shrinks out here and grows in there just after (the
// approved "shrink out, grow in"). `bare`: no recessed well (on a panel). `icons`: icons only, the title names it.
export component Track inherits Rectangle {
    in property <int> first;
    in property <int> count;
    in property <bool> bare;
    in property <bool> icons;
    property <int> sel: Home.index >= self.first && Home.index < self.first + self.count ? Home.index - self.first : -1;
    property <int> shown: 0;
    init => { if (sel >= 0) { shown = sel; } }
    changed sel => { if (sel >= 0) { shown = sel; } }
    property <length> pad: self.bare ? 0px : 3px;
    property <length> seg: (self.width - 2 * self.pad) / self.count;
    height: 44px;
    border-radius: 12px;
    background: self.bare ? transparent : Ctl.well;
    border-width: self.bare ? 0px : 1px;
    border-color: #ffffff0c;
    // hairlines between the segments, gone beside the face (as a native segmented control)
    if !root.bare: Rectangle {
        for i in root.count - 1: Rectangle {
            x: root.pad + root.seg * (i + 1) - 0.5px;
            y: (root.height - 16px) / 2;
            width: 1px;
            height: 16px;
            background: #ffffff17;
            // gone while the face is over or beside it
            opacity: max(1 - root.k, min(1, max(0, (abs(root.fx + root.seg / 2 - self.x) - root.seg / 2 - 2px) / 10px)));
        }
    }
    // where the face is (gliding) and how much of it shows (1 = shown; shrinking out is quick, growing in waits
    // for the other track's to have shrunk)
    property <length> fx: self.pad + self.seg * self.shown;
    animate fx { duration: 500ms; easing: T.spring; }
    property <float> k: self.sel >= 0 ? 1 : 0;
    animate k { duration: root.sel >= 0 ? 260ms : 160ms; delay: root.sel >= 0 ? 120ms : 0ms; easing: root.sel >= 0 ? T.spring : T.out; }
    Rectangle {
        x: root.fx;
        y: root.pad;
        width: root.seg;
        height: root.height - 2 * root.pad;
        Rectangle {
            x: parent.width * (1 - root.k) / 2;
            y: parent.height * (1 - root.k) / 2;
            width: parent.width * root.k;
            height: parent.height * root.k;
            border-radius: root.bare ? 12px : 9px;
            background: Ctl.face;
            opacity: min(1, root.k * 3);
            drop-shadow-blur: 5px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #000000a0;
            // its top edge catching the stage light
            Rectangle { x: 9px; y: 0; width: max(0px, parent.width - 18px); height: 1px; background: #ffffff1c; }
        }
    }
    for i in root.count: cell := Rectangle {
        property <Mode> m: Ctl.mode(root.first + i);
        // a label brightens as the face arrives under it and dims as it leaves (no jump ahead of the face)
        property <float> lit: max(0, 1 - abs(root.fx - self.x) / root.seg) * max(0, (root.k - 0.4) / 0.6);
        x: root.pad + root.seg * i;
        y: root.pad;
        width: root.seg;
        height: root.height - 2 * root.pad;
        accessible-role: button;
        accessible-label: self.m.label;
        for c in [0, 1]: Rectangle {
            opacity: c == 0 ? 1 - cell.lit : cell.lit;
            if !root.icons: Text {
                text: cell.m.label;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: c == 1 ? T.fg : touch.pressed ? T.fg2 : Ctl.dim;
            }
            if root.icons: Icon {
                d: cell.m.icon;
                x: (parent.width - 20px) / 2;
                y: (parent.height - 20px) / 2;
                width: 20px;
                height: 20px;
                stroke-width: 1.8px;
                stroke: c == 1 ? T.fg : touch.pressed ? T.fg2 : #77777c;
            }
        }
        touch := TouchArea { clicked => { Home.set-mode(parent.m.id); } }
    }
}

// The unread dot on Chats.
component Dot inherits Rectangle {
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: T.accent;
}

// 1 Hairline: no surfaces, only a precise segmented system on the floor. The status centred; the four awake modes in
// one recessed track and the Sleep pair in a half-width track under its middle (on the same segment grid); the
// actions a toolbar of four equal cells under one hairline, Call the only orange. An action that is on (a sheet out
// of it, a call on its way) lights its stretch of the hairline.
export component Hairline inherits Rectangle {
    in property <length> block-y;
    property <float> fade: Home.kb > 0 ? 0 : 1;
    animate fade { duration: 200ms; easing: T.out; }
    property <float> mfade: Ctl.sheet ? 0 : self.fade;
    animate mfade { duration: 200ms; easing: T.out; }
    property <length> tw: self.width - 40px;
    Status { x: 20px; y: root.block-y; width: root.width - 40px; opacity: root.fade; }
    Track { x: 20px; y: root.block-y + 96px; width: root.tw; first: 0; count: 4; opacity: root.mfade; }
    Track { x: 20px + root.tw / 4; y: root.block-y + 150px; width: root.tw / 2; first: 4; count: 2; opacity: root.mfade; }
    if !Home.ready: SetupCard { x: 20px; y: root.block-y + 194px + 20px; width: root.width - 40px; opacity: root.mfade; }

    property <length> zt: root.height - Home.sab - Ctl.act-h;
    property <length> cw: (self.width - 40px) / 4;
    Rectangle { x: 20px; y: root.zt; width: root.width - 40px; height: 1px; background: Ctl.line; }
    for k[i] in [
        { icon: Icons.bell, label: "Test ring", on: false },
        { icon: Icons.grid, label: "Widget", on: Home.widgets || Home.channel },
        { icon: Icons.chat, label: "Chats", on: false },
        { icon: Icons.phone, label: Ctl.call-label, on: Home.requested },
    ]: Rectangle {
        x: 20px + root.cw * i;
        y: root.zt;
        width: root.cw;
        height: 72px;
        accessible-role: button;
        accessible-label: k.label;
        // its stretch of the hairline, lit while it is on
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: k.on ? parent.width - 28px : 0px;
            height: 1px;
            background: i == 3 ? T.accent : T.fg2;
            animate width { duration: 420ms; easing: T.spring; }
        }
        Rectangle {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            height: parent.height - 8px;
            border-radius: 14px;
            background: cell.pressed ? #ffffff0a : transparent;
            animate background { duration: 140ms; }
        }
        Icon {
            d: k.icon;
            x: (parent.width - 22px) / 2;
            y: 16px;
            width: 22px;
            height: 22px;
            stroke-width: 1.8px;
            stroke: i == 3 ? T.accent : cell.pressed ? T.fg2 : T.fg;
        }
        if i == 2 && Chats.unread: Dot { x: parent.width / 2 + 9px; y: 13px; }
        Text {
            y: 44px;
            width: parent.width;
            height: 16px;
            text: k.label;
            font-size: 12.5px;
            font-weight: 500;
            color: i == 3 && Home.requested ? T.accent : k.on ? T.fg : T.fg2;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
        cell := TouchArea { clicked => { Ctl.act(i); } }
    }
}

// 2 Panel: everything in one object, a smoked-graphite slab resting on the floor under the light, read top to bottom
// like a grouped list: the status beside a small state dot, a hairline, the six modes as icons (the title names the
// chosen one), a hairline, then three quiet actions and Call as the one filled pill.
export component Panel inherits Rectangle {
    in property <length> block-y;
    property <float> fade: Home.kb > 0 ? 0 : 1;
    animate fade { duration: 200ms; easing: T.out; }
    property <float> mfade: Ctl.sheet ? 0 : self.fade;
    animate mfade { duration: 200ms; easing: T.out; }
    if !Home.ready: SetupCard { x: 20px; y: root.block-y + 4px; width: root.width - 40px; opacity: root.fade; }
    property <color> state: Home.index >= 4 ? Ctl.night : Home.index == 3 ? Ctl.dim : T.accent;
    animate state { duration: 300ms; easing: T.out; }
    // a description on two lines makes the slab 20 px taller, upwards; everything under the status keeps its place
    probe := Text { visible: false; text: Ctl.desc; font-size: 14px; }
    property <bool> two: probe.preferred-width > root.width - 32px - 58px;
    property <length> ph: self.two ? 244px : 224px;
    animate ph { duration: 420ms; easing: T.spring; }
    slab := Rectangle {
        x: 16px;
        y: root.height - Home.sab - 12px - root.ph;
        width: root.width - 32px;
        height: root.ph;
        opacity: root.fade;
        border-radius: 28px;
        background: #191918;
        border-width: 1px;
        border-color: #ffffff10;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #000000d0;
        property <length> iw: self.width - 40px;
        // the slab's top edge in the stage light
        Rectangle { x: 28px; y: 0; width: parent.width - 56px; height: 1px; background: #ffffff16; }
        // the status
        Rectangle {
            x: 20px;
            y: 27px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.state;
        }
        SwapLines {
            x: 38px;
            y: 18px;
            width: parent.iw - 18px;
            height: 26px;
            text: Ctl.title;
            font-size: 19px;
            weight: 600;
            spacing: -0.1px;
            color: T.fg;
            centre: false;
        }
        SwapLines {
            x: 38px;
            y: 47px;
            width: parent.iw - 18px;
            height: 40px;
            text: Ctl.desc;
            font-size: 14px;
            centre: false;
        }
        Rectangle { x: 20px; y: parent.height - 143px; width: parent.iw; height: 1px; background: Ctl.line; }
        // the modes: four awake, a hairline, the Sleep pair
        property <length> mc: (self.iw - 17px) / 6;
        Track { x: 20px; y: parent.height - 132px; width: parent.mc * 4; first: 0; count: 4; bare: true; icons: true; opacity: root.mfade; }
        Rectangle { x: 20px + parent.mc * 4 + 8px; y: parent.height - 120px; width: 1px; height: 20px; background: Ctl.line; opacity: root.mfade; }
        Track { x: 20px + parent.mc * 4 + 17px; y: parent.height - 132px; width: parent.mc * 2; first: 4; count: 2; bare: true; icons: true; opacity: root.mfade; }
        Rectangle { x: 20px; y: parent.height - 77px; width: parent.iw; height: 1px; background: Ctl.line; }
        // the actions
        for k[i] in [
            { icon: Icons.bell, label: "Test ring", on: false },
            { icon: Icons.grid, label: "Widget", on: Home.widgets || Home.channel },
            { icon: Icons.chat, label: "Chats", on: false },
        ]: Rectangle {
            x: 14px + 48px * i;
            y: parent.height - 62px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: b.pressed ? #ffffff14 : k.on ? #ffffff10 : transparent;
            animate background { duration: 160ms; }
            accessible-role: button;
            accessible-label: k.label;
            Icon {
                d: k.icon;
                x: 11px;
                y: 11px;
                width: 22px;
                height: 22px;
                stroke-width: 1.8px;
                stroke: k.on ? T.fg : T.fg2;
            }
            if i == 2 && Chats.unread: Dot { x: 30px; y: 8px; }
            b := TouchArea { clicked => { Ctl.act(i); } }
        }
        Rectangle {
            x: 14px + 48px * 3 + 10px;
            y: parent.height - 62px;
            width: parent.width - self.x - 14px;
            height: 44px;
            border-radius: 22px;
            background: Home.requested ? transparent : call.pressed ? #c4664a : T.accent;
            border-width: 1px;
            border-color: Home.requested ? T.accent.with-alpha(0.7) : transparent;
            animate background, border-color { duration: 240ms; easing: T.out; }
            accessible-role: button;
            accessible-label: Ctl.call-label;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Icon {
                    d: Icons.phone;
                    width: 18px;
                    height: 18px;
                    y: (parent.height - 18px) / 2;
                    stroke-width: 1.9px;
                    stroke: Home.requested ? T.accent : #ffffff;
                }
                Text {
                    text: Ctl.call-label;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Home.requested ? T.accent : #ffffff;
                }
            }
            call := TouchArea { clicked => { Ctl.act(3); } }
        }
    }
}
