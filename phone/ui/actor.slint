export component Actor {
    in property <string> face: "clawd";
    in property <float> k: 1;
    property <float> s: root.k * (root.face == "null" ? 1.2 : 1);
    in property <bool> live;
    in property <image> source;
    in property <int> lw;
    in property <int> lh;
    in property <int> th;
    property <float> fw: root.face == "null" ? 150 : 300;
    property <float> fh: (root.face == "null" ? 230 : 250) + 40;
    property <float> cx: root.face == "null" ? 73 : 148;
    property <float> feet: (root.face == "null" ? 194.6 : 221.25) + 40;
    property <length> left: round((root.width / 2 - root.cx * root.s * 1px) / 1phx) * 1phx;
    property <length> top: round((root.height - root.feet * root.s * 1px) / 1phx) * 1phx;
    if root.live: Image {
        source: root.source;
        source-clip-x: 0;
        source-clip-y: root.th - root.lh;
        source-clip-width: root.lw;
        source-clip-height: root.lh;
        x: root.left;
        y: root.top;
        width: root.lw * 1phx;
        height: root.lh * 1phx;
        image-fit: fill;
    }
    if !root.live: Image {
        source: root.face == "null" ? @image-url("faces/null.png") : root.face == "haiku" ? @image-url("faces/haiku.png") : root.face == "sonnet" ? @image-url("faces/sonnet.png") : root.face == "opus" ? @image-url("faces/opus.png") : @image-url("faces/clawd.png");
        x: root.left;
        y: root.top;
        width: root.fw * root.s * 1px;
        height: root.fh * root.s * 1px;
        image-fit: fill;
    }
    @children
}
